<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Program.cs runs only when the operating system starts the command: it is the one file not
      measured, and holds only the call into SelfPlayCommand, which is.
    -->
    <ZaturnavaUnmeasuredFile>**/Zaturnava.BotRunner/Program.cs</ZaturnavaUnmeasuredFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zaturnava.BotRunner\Zaturnava.BotRunner.csproj" />
  </ItemGroup>

</Project>
