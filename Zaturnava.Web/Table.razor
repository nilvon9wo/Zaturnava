@* A game: over it all, the seats by team, each team with its total; under them the board (turned so
   the player's own corner is bottom left), and beside it whose turn it is, the dice and what each lets
   move, on the player's turn what they may do - prisoners they may offer back among it, and, for a Pawn
   picked up or just come to the far edge, what it may be promoted to - and what has happened. Dice the player lost, unable to use them, are told until they
   dismiss it or their turn comes round again: the turn has passed on by then. While a bot decides, it advances the game every
   TableSettings.BotPace, so that bots take their turns one at a time; while a person elsewhere
   decides, it asks for the game again every TableSettings.PollInterval. While a decision is timed, it
   counts down, and advances the game once time is up, for the server to decide for that seat. Once the
   game is over, the player may play it again, the same seats played the same way, or start a quick game.
   If the server no longer has the game (restarted, say), it says so, stops asking, and offers the lobby. *@
@implements IDisposable
@inject IGameServing Games
@inject TableSettings Settings
@inject Browser Browser
@inject TimeProvider Clock
@using System.Globalization

<section class="table">
    <header class="table-bar">
        <button class="leave" @onclick="this.OnLeave">Lobby</button>
        @if (this._view is { } heading)
        {
            <h1>@heading.RulesetName</h1>
            <span class="turns">
                <button class="turn-left" title="Turn the board anticlockwise" @onclick="this.TurnLeft">&#x27F2;</button>
                <button class="turn-home" title="Your own view of the board" @onclick="() => this.TurnHome(heading)">
                    My view
                </button>
                <button class="turn-right" title="Turn the board clockwise" @onclick="this.TurnRight">&#x27F3;</button>
            </span>
        }
    </header>

    @if (this._problem is { } problem && this._view is null)
    {
        <p class="problem" role="alert">@problem</p>
    }

    @if (this._isGone)
    {
        <div class="gone">
            <p class="problem" role="alert">
                This game is gone: the server no longer has it, perhaps because it was restarted.
            </p>
            <button class="action primary back" @onclick="this.OnLeave">Back to the lobby</button>
        </div>
    }
    else if (this._view is { } view)
    {
        <div class="seats">
            @foreach (IGrouping<int, SeatDto> team in this.TeamsOf(view))
            {
                <section class="team @(this.IsMine(team) ? "mine" : null)">
                    <header class="team-head">
                        <span class="team-name">@string.Join(" & ", team.Select(seat => seat.Name))</span>
                        <span class="team-score" title="Team score">@team.Sum(seat => seat.Score)</span>
                    </header>
                    <ol class="team-seats">
                        @foreach (SeatDto seat in team)
                        {
                            <li class="seat seat-@seat.Id @(seat.Id == view.DecidingSeat ? "deciding" : null)">
                                <span class="swatch"></span>
                                <span class="name">@seat.Name</span>
                                <span class="player">@this.Player(seat)</span>
                                <span class="prisoners" title="Prisoners">
                                    @foreach (PrisonerDto prisoner in seat.Prisoners)
                                    {
                                        <PieceIcon Kind="@prisoner.Kind" Name="@prisoner.Name" Owner="prisoner.Owner" Pieces="this.Pieces" />
                                    }
                                </span>
                                <span class="score">@seat.Score</span>
                            </li>
                        }
                    </ol>
                </section>
            }
        </div>

        <div class="play">
            <Board View="view"
                   Actions="this.Actions"
                   Selection="this._selection"
                   Turn="this._boardTurn"
                   LastMove="this._lastMove"
                   Pieces="this.Pieces"
                   OnCellClicked="this.Click" />

            <div class="@(this._turn is null ? "turn" : "turn yours")">
                @if (this._problem is { } trouble)
                {
                    <p class="problem" role="alert">@trouble</p>
                }
                <p class="status">@this.Status(view)</p>
                @if (view.Outcome is not null)
                {
                    <div class="actions">
                        <button class="action primary again" @onclick="() => this.PlayAgain(view)">Play again</button>
                        <button class="action quick" @onclick="this.QuickGame">Quick game</button>
                    </div>
                }
                @if (this._notice is { } notice)
                {
                    <p class="notice" role="status">
                        @this.Named(notice)
                        <button class="dismiss" @onclick="this.Dismiss">OK</button>
                    </p>
                }
                @if (this.Countdown() is { } countdown)
                {
                    <p class="countdown">@countdown</p>
                }
                @if (view.Offer is { } offer)
                {
                    <p class="offer">@this.Named(OfferText(view, offer))</p>
                }
                @if (view.Dice.Count > 0)
                {
                    <ul class="dice">
                        @foreach (DieDto die in view.Dice)
                        {
                            <li><span class="face">@DieFaces.FaceOf(die.Value)</span> @die.Value: @this.Named(die.Meaning)</li>
                        }
                    </ul>
                }
                @if (this._turn is { } turn)
                {
                    ImmutableList<ActionDto> promotions = ByKinship(view, turn.Claim.Seat, this.AtSelection(turn));
                    @if (!promotions.IsEmpty)
                    {
                        <div class="promotion">
                            <p class="hint">@this.Named(PromotionHeading(view, this._selection.Selected!.Value))</p>
                            <div class="promotion-choices">
                                @foreach (ActionDto action in promotions)
                                {
                                    (SeatDto holder, PrisonerDto into) = IntoOf(view, action);
                                    <button class="choice"
                                            title="@this.Named(ActionLabels.LabelOf(action))"
                                            @onclick="() => this.Submit(turn.Claim, action)">
                                        <PieceIcon Kind="@into.Kind" Name="@into.Name" Owner="into.Owner" Pieces="this.Pieces" />
                                        <span class="name">@this.Named(Owned(view, into))</span>
                                        <span class="holder">@HeldBy(holder, turn.Claim.Seat)</span>
                                    </button>
                                }
                            </div>
                            @if (view.PromotionDue is null)
                            {
                                <button class="action later" @onclick="this.PutDown">Promote later</button>
                            }
                            else
                            {
                                @foreach (ActionDto action in turn.Actions.OffBoard)
                                {
                                    <button class="action later" @onclick="() => this.Submit(turn.Claim, action)">
                                        @this.Named(ActionLabels.LabelOf(action))
                                    </button>
                                }
                            }
                        </div>
                    }
                    else
                    {
                        <p class="hint">@Hint(turn.Actions)</p>
                        <div class="actions">
                            @foreach (ActionDto action in turn.Actions.OffBoard)
                            {
                                <button class="action primary @(IsUrged(view, action) ? "urged" : null)"
                                        @onclick="() => this.Submit(turn.Claim, action)">
                                    @this.Named(ActionLabels.LabelOf(action))
                                </button>
                            }
                        </div>
                    }
                    @if (view.MayOffer)
                    {
                        <div class="ransom">
                            <p class="hint">Offer prisoners back:</p>
                            @foreach (SeatDto receiver in Receivers(view, turn.Claim.Seat))
                            {
                                <div class="ransom-to">
                                    <span class="name">To @receiver.Name:</span>
                                    @foreach (PrisonerDto prisoner in HeldOf(view, turn.Claim.Seat, receiver.Id))
                                    {
                                        <button class="prisoner @(this._given.Contains(prisoner.Id) ? "chosen" : null)"
                                                title="@prisoner.Name"
                                                @onclick="() => this.Give(receiver.Id, [prisoner.Id])">
                                            <PieceIcon Kind="@prisoner.Kind" Name="@prisoner.Name" Owner="prisoner.Owner" Pieces="this.Pieces" />
                                        </button>
                                    }
                                    <button class="all"
                                            @onclick="() => this.GiveAll(view, turn.Claim.Seat, receiver.Id)">
                                        All
                                    </button>
                                </div>
                            }
                            @{ ImmutableList<PrisonerDto> askable = this.Askable(view, turn.Claim.Seat); }
                            @if (!askable.IsEmpty)
                            {
                                <p class="hint">Ask for in return (or nothing, for a gift):</p>
                                <div class="ransom-ask">
                                    @foreach (PrisonerDto prisoner in askable)
                                    {
                                        <button class="prisoner @(this._asked.Contains(prisoner.Id) ? "chosen" : null)"
                                                title="@prisoner.Name"
                                                @onclick="() => this.Ask(prisoner.Id)">
                                            <PieceIcon Kind="@prisoner.Kind" Name="@prisoner.Name" Owner="prisoner.Owner" Pieces="this.Pieces" />
                                        </button>
                                    }
                                </div>
                            }
                            <button class="action offer"
                                    disabled="@this._given.IsEmpty"
                                    @onclick="() => this.Offer(turn.Claim)">
                                @(this._asked.IsEmpty ? "Give them back" : "Offer the exchange")
                            </button>
                        </div>
                    }
                }
            </div>

            <ol class="log">
                @foreach (EventDto happened in view.Log.Reverse())
                {
                    <li class="event @happened.Kind seat-@happened.Seat">@this.Named(happened.Text)</li>
                }
            </ol>
        </div>
    }
</section>

@code {
    private const string BotController = "bot";
    private const string RollKind = "roll";
    private static readonly BoardActions NoActions = new([]);

    private readonly Timer _poll;
    private GameViewDto? _view;
    private Turn? _turn;
    private BoardSelection _selection = BoardSelection.None;
    private BoardTurn _boardTurn = BoardTurn.None;
    private ImmutableHashSet<int> _lastMove = [];
    private DateTimeOffset? _deadline;
    private int? _receiver;
    private ImmutableHashSet<int> _given = [];
    private ImmutableHashSet<int> _asked = [];
    private int _heard = -1;
    private string? _problem;
    private string? _notice;
    private bool _isBotDeciding;
    private bool _isGone;

    public Table() => this._poll = new Timer(this.Tick);

    [Parameter, EditorRequired]
    public Seating Seating { get; set; } = null!;

    [Parameter]
    public bool IsSoundOn { get; set; } = true;

    /// <summary>How the pieces are drawn and named, the server's names being the traditional ones.</summary>
    [Parameter]
    public PieceSet Pieces { get; set; }

    [Parameter]
    public EventCallback OnLeave { get; set; }

    /// <summary>The player sat at (or watching) another game, started from this one once it is over.</summary>
    [Parameter]
    public EventCallback<Seating> OnSeated { get; set; }

    private BoardActions Actions => this._turn?.Actions ?? NoActions;

    protected override async Task OnInitializedAsync()
    {
        await this.Refresh();
        this._boardTurn = this._view is null ? BoardTurn.None : BoardTurn.HomeOf(this.Seating.Claim?.Seat, this._view);
    }

    public void Dispose() => this._poll.Dispose();

    private static string Hint(BoardActions actions) =>
        actions.Origins.IsEmpty
            ? "Choose what to do:"
            : actions.OffBoard.IsEmpty
                ? "Pick a ringed piece, then a marked square."
                : "Move a ringed piece (pick it, then a marked square), or:";

    /// <summary>
    /// How the game ended; else who is answering an offer, or whose turn is over but who may still offer;
    /// else whose move it is, and for whom if not for themselves.
    /// </summary>
    private string Status(GameViewDto view) =>
        (view.Outcome, view.DecidingSeat, this._turn, view.Offer, view.IsTurnOver) switch
        {
            ({ } outcome, _, _, _, _) => outcome.Text,
            (_, { } seat, null, _, _) when view.Returning is { } piece =>
                $"{view.Seats[seat].Name} is choosing where their {piece.Name} goes home ({this.Player(view.Seats[seat])}).",
            (_, { }, _, _, _) when view.Returning is { } piece =>
                $"Your {piece.Name} is going home: choose a marked square for it.",
            (_, { } seat, null, { } offer, _) =>
                $"{view.Seats[seat].Name} is answering {view.Seats[offer.From].Name}'s offer ({this.Player(view.Seats[seat])}).",
            (_, { }, _, { } offer, _) => $"Answer {view.Seats[offer.From].Name}'s offer.",
            (_, { } seat, null, _, true) => $"{view.Seats[seat].Name}'s turn is over: they may still offer prisoners back.",
            (_, { }, _, _, true) => "Your turn is over: offer prisoners back, or be done.",
            (_, { } seat, null, _, _) => $"{view.Seats[seat].Name} to move{ForWhom(view)} ({this.Player(view.Seats[seat])}).",
            (_, { }, _, _, _) when view.ThroneHeldBy is { } holder => this.Held(view, holder),
            (_, { }, _, _, _) => $"Your move{ForWhom(view)}.",
            _ => "The game is over.",
        };

    /// <summary>
    /// "Yellow's Raja holds your throne: you must roll, then move first; Yellow moves second." - or, once
    /// rolled, "...: you move first; Yellow moves second."
    /// </summary>
    private string Held(GameViewDto view, int holder)
    {
        int throne = view.Cells.First(cell => cell.Throne == view.DecidingSeat).Id;
        string leader = view.Pieces.First(piece => piece.Cell == throne).Name;
        string holders = view.Seats[holder].Name;
        string roll = view.LegalActions.Any(action => action.Kind == RollKind) ? "you must roll, then move first" : "you move first";
        return this.Named($"{holders}'s {leader} holds your throne: {roll}; {holders} moves second.");
    }

    /// <summary>Rolling, when the player may do nothing else for an enemy leader on their throne.</summary>
    private static bool IsUrged(GameViewDto view, ActionDto action) =>
        view.ThroneHeldBy is not null && action.Kind == RollKind;

    private static string ForWhom(GameViewDto view) =>
        view.ActingFor is { } seat ? $", for {view.Seats[seat].Name}" : string.Empty;

    /// <summary>"Black offers Yellow Yellow's Pawn back, for Green's Horse.", or "..., as a gift."</summary>
    private static string OfferText(GameViewDto view, OfferDto offer)
    {
        string asking = offer.Asked.IsEmpty ? "as a gift" : $"for {Listed(view, offer.Asked)}";
        string given = Listed(view, offer.Given);
        return $"{view.Seats[offer.From].Name} offers {view.Seats[offer.To].Name} {given} back, {asking}.";
    }

    private static string Listed(GameViewDto view, ImmutableList<PrisonerDto> prisoners) =>
        string.Join(", ", prisoners.Select(prisoner => Owned(view, prisoner)));

    /// <summary>"Green's Elephant".</summary>
    private static string Owned(GameViewDto view, PrisonerDto prisoner) =>
        $"{view.Seats[prisoner.Owner].Name}'s {prisoner.Name}";

    /// <summary>What may be done at the piece picked up, as a promotion is; nothing if none is picked up.</summary>
    private ImmutableList<ActionDto> AtSelection(Turn turn) =>
        this._selection.Selected is { } cell ? turn.Actions.At(cell) : [];

    /// <summary>
    /// The promotions, into the player's own pieces first, then their allies', then the rest; each as the
    /// ruleset orders them otherwise, the most valuable first.
    /// </summary>
    private static ImmutableList<ActionDto> ByKinship(GameViewDto view, int seat, ImmutableList<ActionDto> promotions) =>
        [.. promotions.OrderBy(promotion => KinshipOf(view, seat, IntoOf(view, promotion).Prisoner.Owner))];

    /// <summary>0 for the player's own seat, 1 for an ally's, 2 for anyone else's.</summary>
    private static int KinshipOf(GameViewDto view, int seat, int owner) =>
        (owner == seat, view.Seats[owner].Team == view.Seats[seat].Team) switch
        {
            (true, _) => 0,
            (_, true) => 1,
            _ => 2,
        };

    /// <summary>"Promote Black's Pawn on c8 to:".</summary>
    private static string PromotionHeading(GameViewDto view, int cell)
    {
        PieceDto pawn = view.Pieces.First(piece => piece.Cell == cell);
        string name = view.Cells.First(at => at.Id == cell).Name;
        return $"Promote {view.Seats[pawn.Owner].Name}'s {pawn.Name} on {name} to:";
    }

    /// <summary>The captured piece a promotion brings back, and the seat holding it.</summary>
    private static (SeatDto Holder, PrisonerDto Prisoner) IntoOf(GameViewDto view, ActionDto promotion) =>
        view.Seats
            .SelectMany(seat => seat.Prisoners.Select(prisoner => (seat, prisoner)))
            .First(held =>
                held.prisoner.Id.ToString(CultureInfo.InvariantCulture) == promotion.Arguments[ActionArguments.Into]
            );

    /// <summary>"held by Red", or "held by you" if the player's own <paramref name="seat"/> holds it.</summary>
    private static string HeldBy(SeatDto holder, int seat) =>
        $"held by {(holder.Id == seat ? "you" : holder.Name)}";

    private void PutDown() => this._selection = BoardSelection.None;

    /// <summary>The same game again: its ruleset, its bots in the same seats, the player at the same seat.</summary>
    private Task PlayAgain(GameViewDto view) =>
        this.SitAgain(() => GameStarter.Start(
            this.Games,
            view.RulesetId,
            [.. view.Seats.Select(seat => seat.BotId)],
            this.Seating.Claim is { } claim ? claim.Seat : -1
        ));

    private Task QuickGame() =>
        this.SitAgain(async () => await GameStarter.Quick(this.Games, await this.Games.Catalog(CancellationToken.None)));

    private async Task SitAgain(Func<Task<Seating>> seating) =>
        this._problem = await Requests.Attempt(async () => await this.OnSeated.InvokeAsync(await seating()));

    private string Named(string text) => PieceStyle.Named(text, this.Pieces);

    private void Dismiss() => this._notice = null;

    /// <summary>
    /// What to tell the player: that they have just lost dice they could not use; nothing on first sight
    /// of the game, or once their turn comes round again; else what they were told already.
    /// </summary>
    private string? NoticeOf(GameViewDto view, bool isFirst, bool wasTheirTurn)
    {
        EventDto? lost = view.Log.LastOrDefault(happened =>
            happened.Number > this._heard
            && happened.Kind == EventDto.Forfeited
            && happened.Seat == this.Seating.Claim?.Seat
        );
        return (isFirst, lost, this._turn is not null && !wasTheirTurn) switch
        {
            (true, _, _) => null,
            (_, { } forfeited, _) => forfeited.Text,
            (_, _, true) => null,
            _ => this._notice,
        };
    }

    /// <summary>The seats the player holds prisoners of, to offer them back to.</summary>
    private static IEnumerable<SeatDto> Receivers(GameViewDto view, int seat) =>
        view.Seats[seat].Prisoners.Select(prisoner => prisoner.Owner).Where(owner => owner != seat).Distinct()
            .Order().Select(owner => view.Seats[owner]);

    private static IEnumerable<PrisonerDto> HeldOf(GameViewDto view, int seat, int owner) =>
        view.Seats[seat].Prisoners.Where(prisoner => prisoner.Owner == owner);

    /// <summary>
    /// The prisoners the chosen receiver holds of the player's team: what the player may ask for; none
    /// until a receiver is chosen.
    /// </summary>
    private ImmutableList<PrisonerDto> Askable(GameViewDto view, int seat) =>
        this._receiver is { } receiver
            ? [.. view.Seats[receiver].Prisoners.Where(prisoner => view.Seats[prisoner.Owner].Team == view.Seats[seat].Team)]
            : [];

    /// <summary>Chooses prisoners to give back, or no longer; choosing another seat's starts afresh.</summary>
    private void Give(int receiver, ImmutableHashSet<int> prisoners)
    {
        bool isSameReceiver = this._receiver == receiver;
        this._asked = isSameReceiver ? this._asked : [];
        this._given = isSameReceiver ? this._given.SymmetricExcept(prisoners) : prisoners;
        this._receiver = receiver;
    }

    private void GiveAll(GameViewDto view, int seat, int receiver)
    {
        ImmutableHashSet<int> all = [.. HeldOf(view, seat, receiver).Select(prisoner => prisoner.Id)];
        this.Give(receiver, this._receiver == receiver ? all.Except(this._given) : all);
    }

    private void Ask(int prisoner) => this._asked = this._asked.SymmetricExcept([prisoner]);

    private Task Offer(SeatClaim claim) =>
        this.Submit(claim, OfferDto.ActionOf(claim.Seat, this._receiver!.Value, this._given.Order(), this._asked.Order()));

    /// <summary>"12 s left", while the deciding seat's decision is timed.</summary>
    private string? Countdown() =>
        this._deadline is { } deadline
            ? $"{Math.Max(0, (int)Math.Ceiling((deadline - this.Clock.GetUtcNow()).TotalSeconds))} s left"
            : null;

    /// <summary>The seats by team, the player's own team first, each team's seats in the order they sit.</summary>
    private IEnumerable<IGrouping<int, SeatDto>> TeamsOf(GameViewDto view) =>
        view.Seats.GroupBy(seat => seat.Team).OrderByDescending(this.IsMine).ThenBy(team => team.Key);

    private bool IsMine(IGrouping<int, SeatDto> team) => team.Any(seat => seat.Id == this.Seating.Claim?.Seat);

    private string Player(SeatDto seat) => seat.Id == this.Seating.Claim?.Seat ? "you" : seat.Bot ?? seat.Controller;

    private void TurnLeft() => this._boardTurn = this._boardTurn.Anticlockwise();

    private void TurnRight() => this._boardTurn = this._boardTurn.Clockwise();

    private void TurnHome(GameViewDto view) => this._boardTurn = BoardTurn.HomeOf(this.Seating.Claim?.Seat, view);

    private void Tick(object? state) => _ = this.InvokeAsync(this.Next);

    /// <summary>
    /// Lets a deciding bot take its next step, or the server decide once time is up; else looks for what
    /// others have done; else, on the player's own timed turn, counts down.
    /// </summary>
    private async Task Next()
    {
        GameViewDto view = this._view!;
        bool isDue = this._isBotDeciding || this._deadline <= this.Clock.GetUtcNow();
        await ((isDue, this._turn) switch
        {
            (true, _) => this.Request(
                () => this.Games.Advance(this.Seating.GameId, view.Version, CancellationToken.None)
            ),
            (_, null) => this.Refresh(),
            _ => this.CountDown(view),
        });
        this.StateHasChanged();
    }

    private Task CountDown(GameViewDto view)
    {
        _ = this._poll.Change(this.Wait(view), Timeout.InfiniteTimeSpan);
        return Task.CompletedTask;
    }

    private Task Refresh() => this.Request(() => this.Games.Get(this.Seating.GameId, CancellationToken.None));

    private Task Click(int cell)
    {
        (BoardSelection next, ActionDto? chosen) = this._selection.Click(cell, this.Actions);
        this._selection = next;
        return this._turn is { } turn && chosen is { } action ? this.Submit(turn.Claim, action) : Task.CompletedTask;
    }

    private Task Submit(SeatClaim claim, ActionDto action) =>
        this.Request(() => this.Games.Submit(this.Seating.GameId, claim.Token, action, CancellationToken.None));

    /// <summary>
    /// Makes the request, and shows the game it answers with; if it fails, says why, and looks again
    /// when it would have anyway, so that a game waiting on others does not stop when one request does.
    /// </summary>
    private async Task Request(Func<Task<GameViewDto>> request)
    {
        this._problem = await Requests.Attempt(async () => await this.ShowUnlessGone(request));
        _ = this._problem is not null && this._view is { } view
            && this._poll.Change(this.Wait(view), Timeout.InfiniteTimeSpan);
    }

    private async Task ShowUnlessGone(Func<Task<GameViewDto>> request)
    {
        try
        {
            await this.Show(await request());
        }
        catch (GameRequestRefusedException refused) when (refused.Refusal == Refusal.NotFound)
        {
            this._isGone = true;
            _ = this._poll.Change(Timeout.InfiniteTimeSpan, Timeout.InfiniteTimeSpan);
        }
    }

    private async Task Show(GameViewDto view)
    {
        bool wasTheirTurn = this._turn is not null;
        bool isFirst = this._view is null;
        bool isNew = view.Version != this._view?.Version;
        this._view = view;
        this._deadline = view.SecondsLeft is { } seconds ? this.Clock.GetUtcNow().AddSeconds(seconds) : null;
        this._receiver = isNew ? null : this._receiver;
        this._given = isNew ? [] : this._given;
        this._asked = isNew ? [] : this._asked;
        this._turn = view.DecidingSeat is { } deciding && this.Seating.Claim is { } claim && claim.Seat == deciding
            ? new Turn(claim, new BoardActions(view.LegalActions))
            : null;
        this._isBotDeciding = view.DecidingSeat is { } seat && view.Seats[seat].Controller == BotController;
        this._selection = this._turn is not null && view.PromotionDue is { } due
            ? new BoardSelection(due)
            : BoardSelection.None;
        this._lastMove = view.Log.LastOrDefault(happened => happened.Kind == EventDto.Moved) is { } moved
            ? [moved.From!.Value, moved.To!.Value]
            : [];
        string? sound = this.SoundOf(view, isFirst, wasTheirTurn);
        this._notice = this.NoticeOf(view, isFirst, wasTheirTurn);
        this._heard = view.Log.Count > 0 ? view.Log[^1].Number : this._heard;
        await (sound is not null && this.IsSoundOn ? this.Browser.Play(sound) : ValueTask.CompletedTask);
        _ = this._poll.Change(this.Wait(view), Timeout.InfiniteTimeSpan);
    }

    /// <summary>The sound for what happened since the last view: a turn come round, a capture, a move, a roll.</summary>
    private string? SoundOf(GameViewDto view, bool isFirst, bool wasTheirTurn)
    {
        ImmutableHashSet<string> kinds = [.. view.Log.Where(happened => happened.Number > this._heard).Select(happened => happened.Kind)];
        return isFirst
            ? null
            : this._turn is not null && !wasTheirTurn
                ? "turn"
                : new[] { EventDto.Captured, EventDto.Moved, EventDto.Rolled }.FirstOrDefault(kinds.Contains);
    }

    /// <summary>
    /// How long until the next look at the game: a countdown step while the decision is timed; else never
    /// while it is the player's turn or the game is over.
    /// </summary>
    private TimeSpan Wait(GameViewDto view) =>
        (view.DecidingSeat, this._deadline, this._turn) switch
        {
            (null, _, _) => Timeout.InfiniteTimeSpan,
            (_, { }, _) => this.Settings.CountdownStep,
            (_, _, { }) => Timeout.InfiniteTimeSpan,
            _ => this.PaceOfOthers(),
        };

    private TimeSpan PaceOfOthers() => this._isBotDeciding ? this.Settings.BotPace : this.Settings.PollInterval;
}
