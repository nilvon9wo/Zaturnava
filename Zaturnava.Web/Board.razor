@* Any board, from the cells' layouts alone: a unit square per cell, each throne outlined in its seat's
   colour, the last move tinted, the pieces on top, then the marks of a move being made - a ring
   around each piece that can move (flashing around one that can be promoted), and a dot (or, over a piece to capture, a ring) wherever the
   piece picked up can go, or, with none picked up, wherever a piece coming onto the board can be
   dropped. Each cell's name is written small in its corner, so that the log's "from c2
   to c3" can be found. The whole board turns by Turn; the pieces' symbols and the names stay upright. *@

<svg class="board" viewBox="@this._frame.ViewBox" role="grid">
    <g transform="@this.Turn.Transform(this._frame)">
        @foreach (CellDto cell in this.View.Cells)
        {
            <rect class="@this.CellClass(cell)"
                  x="@Svg.Number(cell.X - BoardFrame.HalfCell)"
                  y="@Svg.Number(BoardFrame.ScreenY(cell.Y) - BoardFrame.HalfCell)"
                  width="1"
                  height="1"
                  data-cell="@cell.Id"
                  @onclick="() => this.OnCellClicked.InvokeAsync(cell.Id)" />
            double nameX = cell.X - BoardFrame.HalfCell + NameInset;
            double nameY = BoardFrame.ScreenY(cell.Y) - BoardFrame.HalfCell + NameInset;
            <g class="cell-name" pointer-events="none">
                <text x="@Svg.Number(nameX)" y="@Svg.Number(nameY)" transform="@this.Turn.Upright(nameX, nameY)"
                    >@cell.Name</text>
            </g>
            @if (cell.Throne is { } owner)
            {
                <rect class="throne seat-@owner"
                      pointer-events="none"
                      x="@Svg.Number(cell.X - BoardFrame.HalfCell + ThroneInset)"
                      y="@Svg.Number(BoardFrame.ScreenY(cell.Y) - BoardFrame.HalfCell + ThroneInset)"
                      width="@Svg.Number(1 - (2 * ThroneInset))"
                      height="@Svg.Number(1 - (2 * ThroneInset))" />
            }
        }
        @foreach (PieceDto piece in this.View.Pieces)
        {
            CellDto cell = this._cells[piece.Cell];
            double x = cell.X;
            double y = BoardFrame.ScreenY(cell.Y);
            <g class="@this.PieceClass(piece)" pointer-events="none">
                <title>@PieceStyle.Named(piece.Name, this.Pieces)</title>
                <circle cx="@Svg.Number(x)" cy="@Svg.Number(y)" r="0.4" />
                @if (PieceStyle.ShapeOf(piece.Kind, this.Pieces) is { } shape)
                {
                    <path d="@shape" transform="@ShapeTransform(this.Turn, x, y)" />
                }
                else
                {
                    <g>
                        <text x="@Svg.Number(x)" y="@Svg.Number(y)" transform="@this.Turn.Upright(x, y)"
                            >@PieceStyle.GlyphOf(piece, this.Pieces)</text>
                    </g>
                }
            </g>
        }
        @foreach (int target in this.Targets)
        {
            CellDto cell = this._cells[target];
            bool isCapture = this._occupied.Contains(target);
            <circle class="@(isCapture ? "mark capture" : "mark")"
                    pointer-events="none"
                    cx="@Svg.Number(cell.X)"
                    cy="@Svg.Number(BoardFrame.ScreenY(cell.Y))"
                    r="@(isCapture ? "0.46" : "0.14")" />
        }
    </g>
</svg>

@code {
    private const double ThroneInset = 0.06;
    private const double NameInset = 0.05;

    private BoardFrame _frame = BoardFrame.Empty;
    private ImmutableDictionary<int, CellDto> _cells = ImmutableDictionary<int, CellDto>.Empty;
    private ImmutableHashSet<int> _occupied = [];

    [Parameter, EditorRequired]
    public GameViewDto View { get; set; } = null!;

    [Parameter, EditorRequired]
    public BoardActions Actions { get; set; } = null!;

    [Parameter, EditorRequired]
    public BoardSelection Selection { get; set; } = null!;

    [Parameter]
    public BoardTurn Turn { get; set; } = BoardTurn.None;

    [Parameter]
    public PieceSet Pieces { get; set; }

    /// <summary>The cells the last move went from and to; tinted.</summary>
    [Parameter]
    public ImmutableHashSet<int> LastMove { get; set; } = [];

    [Parameter]
    public EventCallback<int> OnCellClicked { get; set; }

    private ImmutableHashSet<int> Targets =>
        this.Selection.Selected is { } from ? this.Actions.TargetsFrom(from) : this.Actions.Drops;

    protected override void OnParametersSet()
    {
        this._frame = BoardFrame.Of(this.View.Cells);
        this._cells = this.View.Cells.ToImmutableDictionary(cell => cell.Id);
        this._occupied = [.. this.View.Pieces.Select(piece => piece.Cell)];
    }

    /// <summary>A shape drawn about the origin, moved to its piece and kept upright.</summary>
    private static string ShapeTransform(BoardTurn turn, double x, double y) =>
        $"{turn.Upright(x, y)} translate({Svg.Number(x)} {Svg.Number(y)})";

    private string CellClass(CellDto cell) =>
        string.Join(
            ' ',
            new[]
            {
                "cell",
                BoardFrame.IsDark(cell) ? "dark" : "light",
                this.LastMove.Contains(cell.Id) ? "last" : null,
                this.Actions.Origins.Contains(cell.Id) ? "origin" : null,
                this.Selection.Selected == cell.Id ? "selected" : null,
                this.Targets.Contains(cell.Id) ? "target" : null,
            }.OfType<string>()
        );

    private string PieceClass(PieceDto piece) =>
        string.Join(
            ' ',
            new[]
            {
                "piece",
                $"seat-{piece.Owner}",
                this.Actions.Origins.Contains(piece.Cell) ? "movable" : null,
                this.Actions.AtCells.Contains(piece.Cell) ? "promotable" : null,
                this.Selection.Selected == piece.Cell ? "picked" : null,
            }.OfType<string>()
        );
}
