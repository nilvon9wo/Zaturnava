@* Start a game (each seat a person or a bot) and sit at it, or join, watch or go back to one already
   started. *@
@inject IGameServing Games
@inject Browser Browser

<section class="lobby">
    @if (this._problem is { } problem)
    {
        <p class="problem" role="alert">@problem</p>
    }

    @if (this._catalog is { } catalog)
    {
        <div class="panel">
            <h2>New game</h2>
            <p class="rules">@Ruleset(catalog).Name</p>
            <ol class="plans">
                @foreach (int seat in Enumerable.Range(0, this._plans.Count))
                {
                    <li>
                        <select class="plan" @bind="this._plans[seat]">
                            <option value="">Person</option>
                            @foreach (BotDto bot in catalog.Bots)
                            {
                                <option value="@bot.Id">@Label(bot)</option>
                            }
                        </select>
                    </li>
                }
            </ol>
            <button class="create primary" @onclick="() => this.Create(catalog)">Play</button>
            <dl class="bots">
                @foreach (BotDto bot in catalog.Bots)
                {
                    <dt>@Label(bot)</dt>
                    <dd>@bot.Description</dd>
                }
            </dl>
        </div>

        <div class="panel">
            <h2>Games</h2>
            <ul class="games">
                @foreach (GameSummaryDto game in this._games)
                {
                    <li>
                        <span class="game">@game.Id[..Math.Min(8, game.Id.Length)]</span>
                        <span class="players">@string.Join(", ", game.Players)</span>
                        <span class="moves">@Moves(game)</span>
                        @if (this._held.GetValueOrDefault(game.Id) is { } claim)
                        {
                            <button class="resume primary" @onclick="() => this.Resume(game.Id, claim)">
                                Back to seat @(claim.Seat + 1)
                            </button>
                        }
                        @foreach (int seat in game.OpenSeats)
                        {
                            <button class="join" @onclick="() => this.Join(game.Id, seat)">Join seat @(seat + 1)</button>
                        }
                        <button class="watch" @onclick="() => this.OnSeated.InvokeAsync(Seating.Watching(game.Id))">
                            Watch
                        </button>
                    </li>
                }
            </ul>
        </div>
    }
</section>

@code {
    private CatalogDto? _catalog;
    private ImmutableList<GameSummaryDto> _games = [];
    private ImmutableDictionary<string, SeatClaim> _held = ImmutableDictionary<string, SeatClaim>.Empty;
    private List<string> _plans = [];
    private string? _problem;

    [Parameter]
    public EventCallback<Seating> OnSeated { get; set; }

    protected override async Task OnInitializedAsync() => this._problem = await Requests.Attempt(this.Load);

    private static RulesetDto Ruleset(CatalogDto catalog) => catalog.Rulesets[0];

    private static string Label(BotDto bot) => bot.UsesAi ? $"Bot: {bot.Name} (AI)" : $"Bot: {bot.Name}";

    private static string Moves(GameSummaryDto game) => game.Moves == 1 ? "1 move" : $"{game.Moves} moves";

    private async Task Load()
    {
        CatalogDto catalog = await this.Games.Catalog(CancellationToken.None);
        this._games = await this.Games.List(CancellationToken.None);
        this._plans = [.. Enumerable.Range(0, Ruleset(catalog).SeatCount)
            .Select(seat => seat == 0 ? string.Empty : catalog.Bots.FirstOrDefault()?.Id ?? string.Empty)];
        this._catalog = catalog;
        foreach (GameSummaryDto game in this._games)
        {
            this._held = await this.Browser.Recall(game.Id) is { } claim ? this._held.SetItem(game.Id, claim) : this._held;
        }
    }

    private async Task Create(CatalogDto catalog) =>
        this._problem = await Requests.Attempt(() => this.CreateAndSit(catalog));

    private async Task CreateAndSit(CatalogDto catalog)
    {
        CreateGameRequest request = new(
            Ruleset(catalog).Id,
            [.. this._plans.Select(plan => plan.Length == 0 ? null : plan)]
        );
        GameCreatedDto created = await this.Games.Create(request, CancellationToken.None);
        int person = this._plans.IndexOf(string.Empty);
        await (person >= 0
            ? this.Claim(created.GameId, person)
            : this.OnSeated.InvokeAsync(Seating.Watching(created.GameId)));
    }

    private async Task Join(string gameId, int seat) =>
        this._problem = await Requests.Attempt(() => this.Claim(gameId, seat));

    private Task Resume(string gameId, SeatClaim claim) => this.OnSeated.InvokeAsync(new Seating(gameId, claim));

    private async Task Claim(string gameId, int seat)
    {
        SeatClaimedDto claimed = await this.Games.Claim(gameId, seat, CancellationToken.None);
        await this.OnSeated.InvokeAsync(new Seating(gameId, new SeatClaim(seat, claimed.Token)));
    }
}
