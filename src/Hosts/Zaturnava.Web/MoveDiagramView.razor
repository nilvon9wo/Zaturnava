@* A kind's moves and captures, drawn as the server found them: a small board, the piece on its centre, one thing at a
   time, as the player switches (the user's report of 2026-11-15, C2: showing everything at once was not working).
   Its moves: a dot on each square it may move to, as the board marks one, hollow where it leaps there, over anything
   between; and, asked, pieces put in its way, the dots they take from it faded. Its captures: a ring, in another
   colour, on each square it may capture on; a dashed square where it lands, having jumped, for a piece that jumps; for
   a piece that takes by custody, one such capture: where it moves, the enemy taken, and the piece of its side beyond
   that holds it. A piece it hops over, for a piece that hops, is a grey disc. The server draws it forward up. A river
   the piece may not cross is drawn along the lower edge of the first row across it; for a piece that steps along a
   palace's lines, a palace about it, as the board draws one: its wall, and a dashed line from each of its squares to
   the throne - the piece standing on it, or, for a piece drawn where it stands in its own palace, where it is (B6);
   either, the player may put away, to see it on an open board. It is shown turned by
   Angle, as the board shows the piece's own army - its forward, and the board's turn - with an arrow at its forward
   edge, unless it moves alike forward and back; the piece itself kept upright, on a square shaded as the one it
   stands on on the board (the centre's row and column always sum to an even number). Under it, what each mark shown
   means, each mark kept beside its meaning, and no other (C1). The player may play an example, one at a time, each
   the next: the piece where it stands, moving, and where it ends, any enemy it takes then gone (C3). *@
@using System.Globalization

@* What is drawn, in three kinds of control (the user's report of 2026-11-19: the one row of switches was confusing):
   buttons choosing the one feature drawn - its moves, its captures, or a special power at work; check boxes for
   what changes that feature - pieces in its way, its river or palace, where it stands; and a play button, a
   triangle, playing whatever is drawn. *@
@inject Browser Browser
@if (this.FeatureCount > 1)
{
    <div class="diagram-toggles" role="group" aria-label="What the drawing shows">
        @if (!this.Moving.Moves.IsEmpty)
        {
            <button type="button" class="show-moves" aria-pressed="@Pressed(this.Power is null && !this.IsCapturing)"
                    @onclick="() => this.ShowCaptures(false)">Moves</button>
        }
        @if (this.MovingCaptures)
        {
            <button type="button" class="show-captures" aria-pressed="@Pressed(this.Power is null && this.IsCapturing)"
                    @onclick="() => this.ShowCaptures(true)">Captures</button>
        }
        @foreach (NamedDiagramDto power in this.Powers)
        {
            <button type="button" class="show-power" aria-pressed="@Pressed(this.Power == power)"
                    @onclick="() => this.Switch(() => this._power = power.Name)">@power.Name</button>
        }
    </div>
}
@if (this.Power is null && (!this.ObstaclesShown.IsEmpty || this.Diagram.Elsewhere is not null || this.Situations.Any()))
{
    <div class="diagram-options" role="group" aria-label="What changes it">
        @if (!this.ObstaclesShown.IsEmpty)
        {
            <label>
                <input type="checkbox" class="show-obstacles" checked="@this.IsObstructed"
                       @onchange="change => this.Switch(() => this._isObstructed = IsChecked(change))" />
                Pieces in the way
            </label>
        }
        @if (this.Diagram.Elsewhere is not null)
        {
            <label>
                <input type="checkbox" class="show-terrain" checked="@(!this._isElsewhere)"
                       @onchange="change => this.Switch(() => (this._isElsewhere, this._situation) = IsChecked(change) ? (false, this._situation) : (true, null))" />
                @(this.Diagram.RiverRow is null ? "In its palace" : "By a river")
            </label>
        }
        @foreach (NamedDiagramDto situation in this.Situations)
        {
            <label>
                <input type="checkbox" class="show-situation" checked="@(this.Situation == situation)"
                       @onchange="change => this.Switch(() => (this._situation, this._isElsewhere) = IsChecked(change) ? (situation.Name, false) : (null, this._isElsewhere))" />
                @situation.Name
            </label>
        }
    </div>
}
@if (!this.Examples.IsEmpty)
{
    <div class="diagram-play">
        <button type="button" class="play-example" aria-label="@this.PlayLabel" title="@this.PlayLabel"
                @onclick="() => this._plays++">&#x25B6;</button>
    </div>
}
<div class="move-diagram-turn" style="transform: rotate(@(this.Angle)deg)">
    @if (!this.IsTurnless)
    {
        <span class="forward-arrow" aria-hidden="true">&#x25B2;</span>
    }
    @* Drawn anew each play, so that what changes on its squares, as an enemy won over, plays again too. *@
    <div @key="this._plays" class="move-diagram@(this.Playing is null ? string.Empty : " playing")" style="--side: @this.Shown.Side; @this.Colours" role="img" aria-label="@this.Described">
        @for (int row = this.Shown.Side - 1; row >= 0; row--)
        {
            @for (int column = 0; column < this.Shown.Side; column++)
            {
                int cell = (row * this.Shown.Side) + column;
                <span class="@this.ClassOf(cell, row, column)" data-cell="@cell">
                    @if (cell == this.Centre && this.Playing is null)
                    {
                        <span class="upright" style="transform: rotate(@(-this.Angle)deg)">
                            <PieceIcon Kind="@this.Piece.Kind" Name="@this.Piece.Name" Owner="this.Piece.Owner" Mark="this.Piece.Mark" Pieces="this.Pieces" />
                        </span>
                    }
                </span>
            }
        }
        @if (!this.Shown.Palace.IsEmpty)
        {
            <svg class="palace-lines" viewBox="0 0 @this.Shown.Side @this.Shown.Side" aria-hidden="true">
                <rect class="line palace" x="@this.Wall.X" y="@this.Wall.Y" width="@this.Wall.Width" height="@this.Wall.Height" />
                @foreach (int cell in this.Shown.Palace.Where(cell => this.Shown.IsPalaceLined && cell != this.Throne))
                {
                    <line class="line palace-line" x1="@this.XOf(cell)" y1="@this.YOf(cell)" x2="@this.XOf(this.Throne)" y2="@this.YOf(this.Throne)" />
                }
            </svg>
        }
        @if (this.Playing is { } example)
        {
            @foreach (int taken in example.Taken)
            {
                int? from = taken == example.Taken[0] ? example.EnemyFrom : null;
                string chained = example.Via is null ? string.Empty : taken == example.Taken[0] ? " jumped-first" : " jumped-last";
                <span @key="(this._plays, taken)"
                      class="@(this.TakenClassOf(taken, from) + chained)"
                      style="@this.PlacedAt(from ?? taken, from is null ? this.Centre : taken)"></span>
            }
            @if (example.PartnerFrom is { } partnerFrom)
            {
                <span @key="(this._plays, partnerFrom)" class="example-partner" style="@this.PlacedAt(partnerFrom, example.PartnerTo.GetValueOrDefault(partnerFrom))"></span>
            }
            <span @key="this._plays" class="@PieceClassOf(example)" style="@(this.PlacedAt(this.Centre, example.To) + this.ViaOf(example))">
                <span class="upright" style="transform: rotate(@(-this.Angle)deg)">
                    <PieceIcon Kind="@this.Piece.Kind" Name="@this.Piece.Name" Owner="this.Piece.Owner" Mark="this.Piece.Mark" Pieces="this.Pieces" />
                </span>
            </span>
        }
    </div>
</div>
<p class="diagram-key" style="@this.Colours">
    @if (this.Shown.Told is { } told)
    {
        <span class="key-item told">@PieceStyle.Named(told, this.Pieces)</span>
    }
    @if (!this.IsTurnless)
    {
        <span class="key-item"><span class="key arrow"></span>forward</span>
    }
    @foreach (CellMarkDto mark in this.Shown.Marks)
    {
        <span class="key-item"><span class="key @mark.Mark"></span>@PieceStyle.Named(mark.Meaning, this.Pieces)</span>
    }
    @if (this.IsCapturing)
    {
        @if (!this.Shown.Captures.IsEmpty)
        {
            <span class="key-item"><span class="key capture"></span>captures</span>
        }
        @if (!this.Shown.Jumps.IsEmpty)
        {
            <span class="key-item"><span class="key jump"></span>lands here, empty, having jumped and taken the piece before it; and may jump on again</span>
        }
        @if (this.Shown.Custody is not null)
        {
            <span class="key-item"><span class="key move"></span>moves here</span>
            <span class="key-item"><span class="key taken capture"></span>an enemy, taken</span>
            <span class="key-item"><span class="key partner"></span>a piece of its side, holding the enemy with it</span>
        }
        @if (this.IsObstructed)
        {
            <span class="key-item"><span class="key obstacle"></span>a piece in its way</span>
            <span class="key-item"><span class="key capture obstructed"></span>no longer captured on</span>
        }
    }
    else
    {
        @if (this.Shown.Moves.Except(this.Shown.Leaps).Any())
        {
            <span class="key-item"><span class="key move"></span>moves</span>
        }
        @if (!this.Shown.Leaps.IsEmpty)
        {
            <span class="key-item"><span class="key move leap"></span>leaps there, over anything between</span>
        }
        @if (!this.Shown.Leaps.IsEmpty && this.Shown.Moves.Except(this.Shown.Leaps).Any(this.IsFar))
        {
            <span class="key-item">any other dot farther off: slides there, up to the first piece in the way</span>
        }
        @if (this.IsObstructed)
        {
            <span class="key-item"><span class="key obstacle"></span>a piece in its way</span>
            <span class="key-item"><span class="key move obstructed"></span>no longer reached</span>
        }
    }
    @if (!this.Shown.Screens.IsEmpty)
    {
        <span class="key-item"><span class="key screen"></span>a piece to hop over: next to it, or further along its line</span>
    }
    @if (this.Shown.RiverRow is not null)
    {
        <span class="key-item"><span class="key river"></span>a river it may not cross</span>
    }
    @if (!this.Shown.Palace.IsEmpty && !this.Shown.IsPalaceLined)
    {
        <span class="key-item"><span class="key palace"></span>its palace, which confines it but in rare cases</span>
    }
    else if (!this.Shown.Palace.IsEmpty && this.Shown.Throne is null)
    {
        <span class="key-item"><span class="key palace"></span>in a palace, standing on its throne: along each line to the throne it moves and captures, diagonally too</span>
    }
    @if (this.Shown.Throne is not null)
    {
        <span class="key-item"><span class="key palace"></span>its palace, as it stands in it: along each line through its square to the throne, it moves and captures, diagonally too</span>
    }
</p>

@code {
    private bool _isCapturing;
    private bool _isObstructed;
    private bool _isElsewhere;
    private string? _power;
    private string? _situation;

    /// <summary>How many examples the player has played since the drawing last changed; none, none playing.</summary>
    private int _plays;

    [Parameter, EditorRequired]
    public MoveDiagramDto Diagram { get; set; } = null!;

    /// <summary>The piece drawn on the centre square.</summary>
    [Parameter, EditorRequired]
    public PieceDto Piece { get; set; } = null!;

    [Parameter]
    public PieceSet Pieces { get; set; }

    /// <summary>How far it is turned, in degrees clockwise: none shows forward up.</summary>
    [Parameter]
    public int Angle { get; set; }

    /// <summary>
    /// Whether the piece stands on a dark square on the board: its centre square is shaded so, the others
    /// alternating from it, as the board's do.
    /// </summary>
    [Parameter]
    public bool IsOnDark { get; set; }

    /// <summary>Its special powers, each drawn at work: a feature of its own, chosen by a button.</summary>
    private IEnumerable<NamedDiagramDto> Powers => this.Diagram.Alternates.Where(other => other.Diagram.Told is not null);

    /// <summary>
    /// Where it stands changing how it moves - a Xiangqi Soldier across a river, a Janggi piece off its palace's
    /// throne: each changes its moves and captures, so is checked.
    /// </summary>
    private IEnumerable<NamedDiagramDto> Situations =>
        this.Diagram.Alternates.Where(other => other.Diagram.Told is null);

    /// <summary>The power the player chose to see at work, if any.</summary>
    private NamedDiagramDto? Power => this.Powers.FirstOrDefault(power => power.Name == this._power);

    /// <summary>Where it stands the player checked, if anywhere.</summary>
    private NamedDiagramDto? Situation => this.Situations.FirstOrDefault(situation => situation.Name == this._situation);

    /// <summary>
    /// How the piece moves and captures, as checked: where it stands, if checked; on an open board, if its river or
    /// palace is unchecked; else as it is.
    /// </summary>
    private MoveDiagramDto Moving =>
        this.Situation?.Diagram ?? (this._isElsewhere ? this.Diagram.Elsewhere : null) ?? this.Diagram;

    /// <summary>The diagram drawn: the power chosen at work, if any; else how it moves and captures.</summary>
    private MoveDiagramDto Shown => this.Power?.Diagram ?? this.Moving;

    private bool HasCaptures =>
        !this.Shown.Captures.IsEmpty || !this.Shown.Jumps.IsEmpty || this.Shown.Custody is not null;

    /// <summary>Whether it captures, as checked: a feature of its own.</summary>
    private bool MovingCaptures =>
        !this.Moving.Captures.IsEmpty || !this.Moving.Jumps.IsEmpty || this.Moving.Custody is not null;

    /// <summary>How many features there are to choose from: its moves, its captures, and its powers.</summary>
    private int FeatureCount =>
        (this.Moving.Moves.IsEmpty ? 0 : 1) + (this.MovingCaptures ? 1 : 0) + this.Powers.Count();

    /// <summary>What the play button plays, for those who cannot see its triangle.</summary>
    private string PlayLabel =>
        this.Shown.Told is not null ? "Play it" : $"{(this._plays == 0 ? "Play" : "Play another")} {(this.IsCapturing ? "capture" : "move")}";

    private static bool IsChecked(ChangeEventArgs change) => Convert.ToBoolean(change.Value, CultureInfo.InvariantCulture);

    /// <summary>Whether its captures are drawn: asked for, or all it has.</summary>
    private bool IsCapturing => this.HasCaptures && (this._isCapturing || this.Shown.Moves.IsEmpty);

    /// <summary>
    /// Whether pieces are drawn in its way: asked for, where any would stop what is drawn, its moves or its captures
    /// (the user's report of 2026-11-19: a Xiangqi Horse's captures are blocked as its moves are).
    /// </summary>
    private bool IsObstructed => this._isObstructed && !this.ObstaclesShown.IsEmpty;

    /// <summary>Its capture by custody drawn, if it takes so.</summary>
    private ImmutableList<CustodyDto> Holds => [.. new[] { this.Shown.Custody }.OfType<CustodyDto>()];

    /// <summary>
    /// The colours the drawing gives the other pieces (the user's report of 2026-11-19: captures were drawn red
    /// whoever captured): its own side's, its own seat's; an enemy's, a seat of the other team - Yellow for Black
    /// and Green, Green for Yellow and Red.
    /// </summary>
    private string Colours =>
        $"--own: var(--seat-{this.Piece.Owner}); --foe: var(--seat-{(int.IsEvenInteger(this.Piece.Owner) ? 1 : 2)})";

    /// <summary>
    /// The class of a piece taken in an example, on <paramref name="cell"/>: of its own side, or an enemy; and, if it
    /// came from <paramref name="from"/> first, led there.
    /// </summary>
    private string TakenClassOf(int cell, int? from) =>
        string.Join(
            ' ',
            new[] { "example-taken", this.IsFriend(cell) ? "friend" : null, from is null ? null : "led" }
                .OfType<string>()
        );

    /// <summary>
    /// The class of the piece playing <paramref name="example"/>: after an enemy's move, if it answers one; jump by
    /// jump, if it is a chain.
    /// </summary>
    private static string PieceClassOf(PlayedExampleDto example) =>
        (example.EnemyFrom, example.Via) switch
        {
            (not null, _) => "example-piece after-lead",
            (_, not null) => "example-piece chain",
            _ => "example-piece",
        };

    /// <summary>For a chain of jumps, how far the first lands, in squares, across and down, as drawn.</summary>
    private string ViaOf(PlayedExampleDto example)
    {
        int side = this.Shown.Side;
        return example.Via is { } via
            ? string.Create(
                CultureInfo.InvariantCulture,
                $"; --via-across: {(via % side) - (this.Centre % side)}; --via-down: {(this.Centre / side) - (via / side)}"
            )
            : string.Empty;
    }

    /// <summary>Whether <paramref name="cell"/> holds a piece of the drawn piece's own side, to be taken.</summary>
    private bool IsFriend(int cell) =>
        this.Shown.Marks.Any(mark => mark.Cells.Contains(cell) && mark.Mark.Split(' ').Contains("friend"));

    /// <summary>Where pieces would stop what is drawn most: its captures', or its moves'.</summary>
    private ImmutableList<int> ObstaclesShown =>
        this.IsCapturing ? this.Shown.CaptureObstacles : this.Shown.Obstacles;

    /// <summary>What those pieces stop it reaching: where it captures, or where it moves.</summary>
    private ImmutableList<int> ObstructedShown =>
        this.IsCapturing ? this.Shown.CaptureObstructed : this.Shown.Obstructed;

    /// <summary>Whether <paramref name="cell"/> is shown out of reach: a piece in the way on it, or stopped by one.</summary>
    private bool IsStopped(int cell) =>
        this.IsObstructed && (this.ObstaclesShown.Contains(cell) || this.ObstructedShown.Contains(cell));

    /// <summary>
    /// Whether it moves alike forward and back, with no river ahead: which way is forward does not matter.
    /// </summary>
    private bool IsTurnless =>
        this.Shown.RiverRow is null
        && this.Shown.Marks.IsEmpty
        && ((ImmutableList<int>[])
            [
                this.Shown.Moves,
                this.Shown.Captures,
                this.Shown.Jumps,
                this.Shown.Screens,
                this.Shown.Leaps,
                this.Shown.Palace,
            ])
            .All(cells => cells.Select(this.Flipped).Order().SequenceEqual(cells.Order()));

    private int Centre => (this.Shown.Side * this.Shown.Side) / 2;

    /// <summary>The palace's throne: where it is, for a piece drawn where it stands; else the centre it stands on.</summary>
    private int Throne => this.Shown.Throne ?? this.Centre;

    /// <summary>The palace's wall: the box about its cells, in cells, from the top-left, as the SVG draws.</summary>
    private (int X, int Y, int Width, int Height) Wall
    {
        get
        {
            ImmutableList<int> columns = [.. this.Shown.Palace.Select(cell => cell % this.Shown.Side)];
            ImmutableList<int> rows = [.. this.Shown.Palace.Select(cell => cell / this.Shown.Side)];
            return (
                columns.Min(),
                this.Shown.Side - 1 - rows.Max(),
                columns.Max() - columns.Min() + 1,
                rows.Max() - rows.Min() + 1
            );
        }
    }

    /// <summary>For one who cannot see it: how many squares it may move to and capture on.</summary>
    private string Described =>
        $"From the centre, it may move to {this.Shown.Moves.Count} squares and capture on "
        + $"{this.Shown.Captures.Count}";

    /// <summary>
    /// What the piece may be shown doing, one at a time (C3): moving to each square it may move to, as drawn, none in
    /// the way; or capturing - on each square it captures on, the enemy there taken; landing on each it jumps to, the
    /// enemy before it taken; or, by custody, moving on, the enemy held taken.
    /// </summary>
    private ImmutableList<PlayedExampleDto> Examples
    {
        get
        {
            MoveDiagramDto shown = this.Shown;
            return shown.Told is not null
                ? [.. new[] { shown.Example }.OfType<PlayedExampleDto>()]
                : this.IsCapturing
                ? [
                    .. shown.Captures
                        .Where(cell => !this.IsStopped(cell))
                        .Select(cell => new PlayedExampleDto(cell, [cell])),
                    .. shown.Jumps.Select(cell => new PlayedExampleDto(cell, [this.Between(cell)])),
                    .. this.Holds
                        .GroupBy(held => held.Landing)
                        .Select(held => new PlayedExampleDto(held.Key, [.. held.Select(each => each.Taken)])),
                ]
                : [.. shown.Moves.Where(cell => !this.IsStopped(cell)).Select(cell => new PlayedExampleDto(cell, []))];
        }
    }

    /// <summary>
    /// The example playing, if one is: each played in turn, again from the first after the last; none, if the piece
    /// shown has none, as when another's card replaced its own.
    /// </summary>
    private PlayedExampleDto? Playing =>
        this._plays == 0 ? null : this.Examples.ElementAtOrDefault((this._plays - 1) % Math.Max(1, this.Examples.Count));

    /// <summary>A change to what is drawn, the example playing stopped.</summary>
    private void Switch(Action change)
    {
        change();
        this._plays = 0;
    }

    /// <summary>
    /// Its captures drawn, or its moves, as every card opens from now on (the user's word of 2026-11-20: the cards
    /// no longer remembered which).
    /// </summary>
    private async Task ShowCaptures(bool isCapturing)
    {
        this.Switch(() => (this._power, this._isCapturing) = (null, isCapturing));
        await this.Browser.SetCardCapturesShown(isCapturing);
    }

    /// <summary>Opens on its captures if the player last looked at a card's captures.</summary>
    protected override async Task OnInitializedAsync() =>
        this._isCapturing = await this.Browser.AreCardCapturesShown();

    /// <summary>The square halfway from the centre to <paramref name="cell"/>, where the piece jumped over lies.</summary>
    private int Between(int cell) =>
        ((((cell / this.Shown.Side) + (this.Centre / this.Shown.Side)) / 2) * this.Shown.Side)
        + (((cell % this.Shown.Side) + (this.Centre % this.Shown.Side)) / 2);

    /// <summary>
    /// The style placing a square-sized thing on <paramref name="from"/>, and how far it goes to reach
    /// <paramref name="to"/>, in squares, across and down, as the drawing shows them.
    /// </summary>
    private string PlacedAt(int from, int to)
    {
        int side = this.Shown.Side;
        return string.Create(
            CultureInfo.InvariantCulture,
            $"--side: {side}; --column: {from % side}; --row: {side - 1 - (from / side)}; "
                + $"--across: {(to % side) - (from % side)}; --down: {(from / side) - (to / side)}"
        );
    }

    private static string Pressed(bool isPressed) => isPressed ? "true" : "false";

    /// <summary>The cell as far behind the centre's row as <paramref name="cell"/> is ahead of it.</summary>
    private int Flipped(int cell) =>
        ((this.Shown.Side - 1 - (cell / this.Shown.Side)) * this.Shown.Side) + (cell % this.Shown.Side);

    /// <summary>
    /// Whether, with the enemies <paramref name="capturing"/> takes standing, the piece could move to
    /// <paramref name="cell"/>: one of its moves, not an enemy taken, nor behind one on the same line from the centre,
    /// nor cut off by pieces put in its way.
    /// </summary>
    private bool IsMovedToWhile(PlayedExampleDto capturing, int cell) =>
        this.Shown.Moves.Contains(cell)
        && !capturing.Taken.Contains(cell)
        && !capturing.Taken.Any(taken => this.IsBehind(cell, taken))
        && !(this.IsObstructed && this.ObstructedShown.Contains(cell));

    /// <summary>
    /// Whether <paramref name="cell"/> lies on the line from the centre through <paramref name="taken"/>, past it.
    /// </summary>
    private bool IsBehind(int cell, int taken)
    {
        int side = this.Shown.Side;
        (int across, int down) = ((cell % side) - (this.Centre % side), (cell / side) - (this.Centre / side));
        (int toAcross, int toDown) = ((taken % side) - (this.Centre % side), (taken / side) - (this.Centre / side));
        return (across * toDown) == (down * toAcross)
            && (across * toAcross) + (down * toDown) > (toAcross * toAcross) + (toDown * toDown);
    }

    /// <summary>Whether <paramref name="cell"/> is farther from the centre than the squares around it.</summary>
    private bool IsFar(int cell)
    {
        int middle = this.Shown.Side / 2;
        return Math.Max(Math.Abs((cell % this.Shown.Side) - middle), Math.Abs((cell / this.Shown.Side) - middle)) > 1;
    }

    private string XOf(int cell) =>
        ((cell % this.Shown.Side) + 0.5).ToString(CultureInfo.InvariantCulture);

    private string YOf(int cell)
    {
        int row = cell / this.Shown.Side;
        return (this.Shown.Side - row - 0.5).ToString(CultureInfo.InvariantCulture);
    }

    private string ClassOf(int cell, int row, int column)
    {
        MoveDiagramDto shown = this.Shown;
        bool isMoving = !this.IsCapturing;
        bool isInTheWay = this.IsObstructed && this.ObstaclesShown.Contains(cell);
        // a capture playing: only the enemies it takes ringed; every other square it could reach so, a move (the
        // user's word of 2026-11-20: squares it could only move to were ringed as captures)
        PlayedExampleDto? capturing = isMoving ? null : this.Playing;
        bool isRinged = capturing is null
            ? shown.Captures.Contains(cell) || this.Holds.Any(held => held.Taken == cell)
            : capturing.Taken.Contains(cell);
        return string.Join(
            ' ',
            new[]
            {
                "square",
                int.IsEvenInteger(row + column) == this.IsOnDark ? "dark" : "light",
                (isMoving && shown.Moves.Contains(cell) && !isInTheWay)
                || (!isMoving && this.Holds.Any(held => held.Landing == cell))
                || (capturing is not null && !isInTheWay && this.IsMovedToWhile(capturing, cell))
                    ? "move"
                    : null,
                isMoving && shown.Leaps.Contains(cell) ? "leap" : null,
                this.IsObstructed && this.ObstructedShown.Contains(cell) ? "obstructed" : null,
                isInTheWay ? "obstacle" : null,
                !isMoving && this.Holds.Any(held => held.Taken == cell) ? "taken" : null,
                !isMoving && !isInTheWay && isRinged ? "capture" : null,
                !isMoving && this.Holds.Any(held => held.Partner == cell) ? "partner" : null,
                !isMoving && shown.Jumps.Contains(cell) ? "jump" : null,
                shown.Screens.Contains(cell) ? "screen" : null,
                row == shown.RiverRow ? "river-bank" : null,
                cell == this.Playing?.PartnerFrom ? "left" : null,
            }
                .Concat(shown.Marks.Where(mark => mark.Cells.Contains(cell)).Select(mark => mark.Mark))
                .OfType<string>()
        );
    }
}
