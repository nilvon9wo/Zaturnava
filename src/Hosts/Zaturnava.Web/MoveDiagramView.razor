@* A kind's moves and captures, drawn as the server found them: a small board, the piece on its centre, a dot on each
   square it may move to, as the board marks one, and a ring, in another colour, on each it may capture on; a square
   it may do both on has both. A square it leaps to, over anything between, has a hollow dot, a ring, the key
   saying so; any other dot farther off, it slides to. A piece it hops over, for a piece that hops, is drawn as a grey disc. The server draws
   it forward up; a cross on each square a piece on which would block one of its leaps; a river the piece may not
   cross, drawn along the lower edge of the first row across it. It is shown turned by Angle, as the board shows the
   piece's own army - its forward, and the board's
   turn - with an arrow at its forward edge, the piece itself kept upright, on a square shaded as the one it stands
   on on the board (the centre's row and column always sum to an even number). Under it, what each mark means, each
   mark kept beside its meaning. For a piece that steps along a palace's lines, a palace about it, as the board draws
   one: its wall, and a dashed line from each of its squares to the throne the piece stands on. *@
@using System.Globalization

<div class="move-diagram-turn" style="transform: rotate(@(this.Angle)deg)">
    <span class="forward-arrow" aria-hidden="true">&#x25B2;</span>
    <div class="move-diagram" style="--side: @this.Diagram.Side" role="img" aria-label="@this.Described">
        @for (int row = this.Diagram.Side - 1; row >= 0; row--)
        {
            @for (int column = 0; column < this.Diagram.Side; column++)
            {
                int cell = (row * this.Diagram.Side) + column;
                <span class="@this.ClassOf(cell, row, column)" data-cell="@cell">
                    @if (cell == this.Centre)
                    {
                        <span class="upright" style="transform: rotate(@(-this.Angle)deg)">
                            <PieceIcon Kind="@this.Piece.Kind" Name="@this.Piece.Name" Owner="this.Piece.Owner" Mark="this.Piece.Mark" Pieces="this.Pieces" />
                        </span>
                    }
                </span>
            }
        }
        @if (!this.Diagram.Palace.IsEmpty)
        {
            <svg class="palace-lines" viewBox="0 0 @this.Diagram.Side @this.Diagram.Side" aria-hidden="true">
                <rect class="line palace" x="@this.Wall.X" y="@this.Wall.Y" width="@this.Wall.Width" height="@this.Wall.Height" />
                @foreach (int cell in this.Diagram.Palace.Where(cell => cell != this.Centre))
                {
                    <line class="line palace-line" x1="@this.XOf(cell)" y1="@this.YOf(cell)" x2="@this.XOf(this.Centre)" y2="@this.YOf(this.Centre)" />
                }
            </svg>
        }
    </div>
</div>
<p class="diagram-key">
    <span class="key-item"><span class="key arrow"></span>forward</span>
    <span class="key-item"><span class="key move"></span>moves</span>
    <span class="key-item"><span class="key capture"></span>captures</span>
    @if (!this.Diagram.Screens.IsEmpty)
    {
        <span class="key-item"><span class="key screen"></span>a piece to hop over: next to it, or further along its line</span>
    }
    @if (!this.Diagram.Leaps.IsEmpty)
    {
        <span class="key-item"><span class="key move leap"></span>leaps there, over anything between</span>
        <span class="key-item">any other dot farther off: slides there, up to the first piece in the way</span>
    }
    @if (!this.Diagram.Jumps.IsEmpty)
    {
        <span class="key-item"><span class="key jump"></span>lands here, empty, having jumped and taken the piece before it; and may jump on again</span>
    }
    @if (!this.Diagram.Blockers.IsEmpty)
    {
        <span class="key-item"><span class="key blocker"></span>a piece here blocks a leap</span>
    }
    @if (this.Diagram.RiverRow is not null)
    {
        <span class="key-item"><span class="key river"></span>a river it may not cross</span>
    }
    @if (!this.Diagram.Palace.IsEmpty)
    {
        <span class="key-item"><span class="key palace"></span>in a palace, standing on its throne: along each line to the throne it moves and captures, diagonally too</span>
    }
</p>

@code {
    [Parameter, EditorRequired]
    public MoveDiagramDto Diagram { get; set; } = null!;

    /// <summary>The piece drawn on the centre square.</summary>
    [Parameter, EditorRequired]
    public PieceDto Piece { get; set; } = null!;

    [Parameter]
    public PieceSet Pieces { get; set; }

    /// <summary>How far it is turned, in degrees clockwise: none shows forward up.</summary>
    [Parameter]
    public int Angle { get; set; }

    /// <summary>
    /// Whether the piece stands on a dark square on the board: its centre square is shaded so, the others
    /// alternating from it, as the board's do.
    /// </summary>
    [Parameter]
    public bool IsOnDark { get; set; }

    private int Centre => (this.Diagram.Side * this.Diagram.Side) / 2;

    /// <summary>The palace's wall: the box about its cells, in cells, from the top-left, as the SVG draws.</summary>
    private (int X, int Y, int Width, int Height) Wall
    {
        get
        {
            ImmutableList<int> columns = [.. this.Diagram.Palace.Select(cell => cell % this.Diagram.Side)];
            ImmutableList<int> rows = [.. this.Diagram.Palace.Select(cell => cell / this.Diagram.Side)];
            return (
                columns.Min(),
                this.Diagram.Side - 1 - rows.Max(),
                columns.Max() - columns.Min() + 1,
                rows.Max() - rows.Min() + 1
            );
        }
    }

    private string XOf(int cell) =>
        ((cell % this.Diagram.Side) + 0.5).ToString(CultureInfo.InvariantCulture);

    private string YOf(int cell)
    {
        int row = cell / this.Diagram.Side;
        return (this.Diagram.Side - row - 0.5).ToString(CultureInfo.InvariantCulture);
    }

    /// <summary>For one who cannot see it: how many squares it may move to and capture on.</summary>
    private string Described =>
        $"From the centre, it may move to {this.Diagram.Moves.Count} squares and capture on "
        + $"{this.Diagram.Captures.Count}";

    private string ClassOf(int cell, int row, int column) =>
        string.Join(
            ' ',
            new[]
            {
                "square",
                int.IsEvenInteger(row + column) == this.IsOnDark ? "dark" : "light",
                this.Diagram.Moves.Contains(cell) ? "move" : null,
                this.Diagram.Captures.Contains(cell) ? "capture" : null,
                this.Diagram.Screens.Contains(cell) ? "screen" : null,
                row == this.Diagram.RiverRow ? "river-bank" : null,
                this.Diagram.Blockers.Contains(cell) ? "blocker" : null,
                this.Diagram.Leaps.Contains(cell) ? "leap" : null,
                this.Diagram.Jumps.Contains(cell) ? "jump" : null,
            }.OfType<string>()
        );
}
