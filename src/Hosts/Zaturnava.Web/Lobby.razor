@* Start a game (each seat a person or a bot, no bot in two seats) and sit at it: the game (the one last started),
   and, for one played at several sizes, its size (the middle one); each game set up as the player last started it,
   and quick or custom as last chosen (both remembered in the browser), else quick - custom: the
   player's colour, then for their ally and each enemy a person, an AI of the player's own (the seat left open
   for it), or how strong a bot (easy, medium or
   hard, by the bots' ratings; a strength whose bots all have seats is offered to no other), and, if they like,
   which of those bots, each named with its rating; else each is chosen at random among them; and, for a game whose
   armies are dealt at random, whether every army is alike (each its own, unless asked) - or quick: start one
   at once, at a seat chosen at random, easy, medium or hard by which bots it seats among the others - or join,
   watch or go back to one already started (a guest may not join one whose open seats are for players signed in,
   as a player signed in may set up a custom game), each saying whether it waits for players or has not started,
   who at it is away, and when it
   was created and last changed, and listed by game, size, state (or, for a player signed in, Mine: their own games),
   bots or who is at it ("Bob, Jo*, open"); a game
   over is only listed, with nothing left to watch. Seats go by
   the ruleset's names for them (Black, Yellow...), not by number. A bot paid for each use is seated only when
   chosen: never by default, nor at random. A server in development also offers scenarios, games set up
   part-way, to start from. Preview games, not yet ready for everyone, are named so, and neither offered nor listed
   unless the player chooses to show them (remembered in the browser). Beside them, the leaderboard
   (<see cref="Leaderboard"/>). One choice of game, at the top, with the choice to show previews, serves the whole
   lobby (Stated): the game to start, the games listed and the leaderboard; the games waiting for the player's
   move are listed whatever their game. *@
@inject IGameServing Games
@inject Browser Browser
@inject TimeProvider Clock

<section class="lobby">
    @if (this._problem is { } problem)
    {
        <p class="problem" role="alert">@problem</p>
    }

    @if (this._catalog is { } catalog)
    {
        ImmutableList<RulesetDto> games = this.GamesOf(catalog);
        <div class="lobby-games">
            @if (games.Count > 1)
            {
                <label class="rules">
                    <span class="choice-name">Game</span>
                    <select class="game" @bind="this.Game" @bind:after="this.ListGame">
                        @foreach (RulesetDto game in games)
                        {
                            <option value="@game.Game">@GameNameOf(game)</option>
                        }
                    </select>
                </label>
            }
            else
            {
                <p class="rules">@GameNameOf(this.Ruleset(catalog))</p>
            }
            @if (catalog.Rulesets.Any(ruleset => ruleset.IsPreview))
            {
                <label class="previews">
                    <input type="checkbox"
                           class="show-previews"
                           checked="@this._arePreviewsShown"
                           @onchange="change => this.ShowPreviews(catalog, change)" />
                    Show preview games, not yet ready for everyone
                </label>
            }
        </div>
        @if (this._me is { } me && !this._awaited.IsEmpty)
        {
            <div class="panel awaited">
                <h2>Waiting for your move</h2>
                <p class="awaited-hint">
                    End the games you no longer play (<strong>End game</strong>, at the table), and resume the oldest of
                    the rest: the others are waiting for you.
                </p>
                <ul class="games">
                    @foreach (AwaitedGameDto awaited in this._awaited)
                    {
                        GameSummaryDto game = awaited.Game;
                        <li>
                            <span class="ruleset">@NameOf(catalog, game.RulesetId)</span>
                            <span class="players">@Players(game)</span>
                            <span class="state">@this.StateOf(game)</span>
                            <button class="awaited-resume primary"
                                    @onclick="() => this.BackTo(game.Id, awaited.Seat, me.Token)">
                                Back to @SeatName(game.SeatNames, awaited.Seat)
                            </button>
                        </li>
                    }
                </ul>
            </div>
        }
        <div class="panel">
            <h2>New game</h2>
            @{
                ImmutableList<RulesetDto> sizes = SizesOf(catalog, this.Ruleset(catalog).Game);
            }
            <div class="setup-modes">
                <button class="mode quick-game"
                        aria-pressed="@this.IsPressed(SetupMode.Quick)"
                        @onclick="() => this.SetUp(SetupMode.Quick)">
                    Quick game
                </button>
                <button class="mode custom"
                        aria-pressed="@this.IsPressed(SetupMode.Custom)"
                        @onclick="() => this.SetUp(SetupMode.Custom)">
                    Custom
                </button>
            </div>
            <p class="hint setup-hint">
                Click <strong>Custom</strong> to play other people.
            </p>
            <div class="choices">
                @if (sizes.Count > 1)
                {
                    <label class="size">
                        <span class="choice-name">Size</span>
                        <select class="size" @bind="this.RulesetId">
                            @foreach (RulesetDto ruleset in sizes)
                            {
                                <option value="@ruleset.Id">@ruleset.Size</option>
                            }
                        </select>
                    </label>
                }
                @if (this.Ruleset(catalog).SizableBoard is not null)
                {
                    <label class="board">
                        <span class="choice-name">Board</span>
                        <input type="number"
                               class="board-side"
                               aria-label="Cells on each side of the board"
                               min="6"
                               max="26"
                               @bind="this._side"
                               @bind:after="this.Resized" />
                        cells square
                    </label>
                    <label class="kingdoms">
                        <span class="choice-name">Kingdoms</span>
                        <input type="number"
                               class="kingdom-width"
                               aria-label="Cells along each kingdom's back rank"
                               min="3"
                               max="13"
                               @bind="this._kingdomWidth"
                               @bind:after="this.Resized" />
                        wide,
                        <input type="number"
                               class="kingdom-depth"
                               aria-label="Cells deep each kingdom is"
                               min="3"
                               max="13"
                               @bind="this._kingdomDepth"
                               @bind:after="this.Resized" />
                        deep
                    </label>
                }
            </div>
            @if (this._mode == SetupMode.Quick)
            {
                <div class="quick-games">
                    <span class="quick-label">At any seat, against bots:</span>
                    <button class="quick easy primary" @onclick="() => this.Quick(catalog, Difficulty.Easy)">Easy</button>
                    <button class="quick medium primary" @onclick="() => this.Quick(catalog, Difficulty.Medium)">Medium</button>
                    <button class="quick hard primary" @onclick="() => this.Quick(catalog, Difficulty.Hard)">Hard</button>
                </div>
                <p class="quick-hint">
                    Easy seats the three easiest bots; medium, any three; hard, the three hardest. Who they are is under
                    <strong>The bots</strong>, below.
                </p>
            }
            else
            {
                <ol class="plans strengths">
                    <li>
                        <span class="seat-name">You play</span>
                        <select class="colour" @bind="this.Colour">
                            @foreach (int seat in Enumerable.Range(0, this.Ruleset(catalog).SeatCount))
                            {
                                <option value="@seat">@SeatName(this.Ruleset(catalog).SeatNames, seat)</option>
                            }
                        </select>
                    </li>
                    @foreach (int seat in OthersOf(this.Ruleset(catalog), this._colour))
                    {
                        <li>
                            <span class="seat-name">
                                @RoleOf(this.Ruleset(catalog), this._colour, seat), @SeatName(this.Ruleset(catalog).SeatNames, seat)
                            </span>
                            <select class="strength"
                                    @bind="this._levels[seat]"
                                    @bind:after="() => this._picks[seat] = string.Empty">
                                <option value="@PersonLevel">Person</option>
                                <option value="@OwnAiLevel">Your own AI</option>
                                @foreach (int level in Enumerable.Range(0, this._strengths.Count))
                                {
                                    <option value="@level" disabled="@(!this.HasRoom(level, seat))">
                                        @this._strengths[level].Label
                                    </option>
                                }
                            </select>
                            @if (this.StrengthOf(seat) is { Bots.Count: > 1 } strength)
                            {
                                <select class="pick" aria-label="Which bot" @bind="this._picks[seat]">
                                    <option value="">Any of them</option>
                                    @foreach (BotDto bot in strength.Bots)
                                    {
                                        <option value="@bot.Id" disabled="@this.IsPicked(bot.Id, seat)">
                                            @strength.LabelOf(bot)
                                        </option>
                                    }
                                </select>
                            }
                        </li>
                    }
                </ol>
                @if (this._levels.Contains(OwnAiLevel))
                {
                    <p class="hint own-ai">
                        A seat for your own AI stays open until it takes it: by MCP or the HTTP API, with this game's
                        id, shown at the table, and an AI token from your profile.
                        <a href="@DocsLinks.Bots" target="_blank" rel="noopener noreferrer">How to connect it</a>
                    </p>
                }
            }
            @if (this._mode != SetupMode.Quick && this.Ruleset(catalog).IsDealt)
            {
                <label class="armies">
                    <span class="choice-name">Armies</span>
                    <select class="armies" @bind="this._armies">
                        @if (this.Ruleset(catalog).IsDraftable)
                        {
                            <option value="@DraftOwn">Each player drafts their own</option>
                            <option value="@DraftOne">I draft one army for everyone</option>
                        }
                        <option value="@RandomEach">Every army at random</option>
                        <option value="@RandomOne">One army at random for everyone</option>
                    </select>
                </label>
                @if (this.IsDrafting)
                {
                    <label class="budget">
                        <span class="choice-name">Points to spend</span>
                        <input type="number"
                               class="draft-budget"
                               min="1"
                               max="@this.BudgetLimit(catalog)"
                               @bind="this._budget"
                               placeholder="@this.Ruleset(catalog).DraftBudget" />
                    </label>
                }
                @if (this._armies == DraftOwn)
                {
                    <label class="secret">
                        <input type="checkbox" class="draft-secret" @bind="this._isSecret" />
                        Draft in secret, all at once: no one sees another team's army until all are drafted, and
                        each may change their mind until done
                    </label>
                    @if (this._isSecret)
                    {
                        <label class="secret-from-allies">
                            <input type="checkbox" class="draft-hidden-from-allies" @bind="this._isHiddenFromAllies" />
                            From allies too: each player sees only their own army until all are drafted
                        </label>
                    }
                }
            }
            @if (this._mode != SetupMode.Quick && this._me is not null)
            {
                <label class="for-players">
                    <input type="checkbox" class="players-only" @bind="this._isForPlayers" />
                    Players signed in only: no guests at the open seats, nor taking over a bot's
                </label>
            }
            @if (this._mode != SetupMode.Quick && !catalog.Scenarios.IsEmpty)
            {
                <label class="scenario">
                    <span class="choice-name">Start from</span>
                    <select class="scenario" @bind="this._scenario">
                        <option value="">The beginning</option>
                        @foreach (ScenarioDto scenario in catalog.Scenarios)
                        {
                            <option value="@scenario.Id">Scenario: @scenario.Name</option>
                        }
                    </select>
                </label>
                @if (catalog.Scenarios.FirstOrDefault(scenario => scenario.Id == this._scenario) is { } chosen)
                {
                    <p class="scenario-description">@chosen.Description</p>
                }
            }
            @if (this._mode != SetupMode.Quick)
            {
                <div class="start">
                    <button class="create primary" @onclick="() => this.Create(catalog)">Play</button>
                </div>
            }
        </div>

        <div class="panel">
            <h2>Games</h2>
            <div class="game-filters">
                @{
                    ImmutableList<RulesetDto> filteredSizes = SizesOf(catalog, this.Game);
                }
                @if (filteredSizes.Count > 1)
                {
                    <label>
                        Size
                        <select class="filter-size" value="@this._filter.Ruleset" @onchange="this.FilterSize">
                            <option value="">Any</option>
                            @foreach (RulesetDto ruleset in filteredSizes)
                            {
                                <option value="@ruleset.Id">@ruleset.Size</option>
                            }
                        </select>
                    </label>
                }
                <label>
                    Show
                    <select class="filter-state" value="@StateOf(this._filter)" @onchange="this.FilterState">
                        <option value="@NotOver">Any not over</option>
                        <option value="@Waiting">Waiting for players</option>
                        <option value="@InProgress">In progress</option>
                        @if (this._me is not null)
                        {
                            <option value="@Mine">Mine</option>
                        }
                    </select>
                </label>
                <label class="people-only">
                    <input type="checkbox"
                           class="filter-people"
                           checked="@(this._filter.PeopleOnly == true)"
                           @onchange="this.FilterPeople" />
                    No bots
                </label>
                <label class="players-filter">
                    Players
                    <input type="search"
                           class="filter-players"
                           placeholder="Bob, Jo*, open"
                           title="Who must be at the game, separated by commas: * for any letters, open for an open seat"
                           value="@this._filter.Players"
                           @onchange="this.FilterPlayers" />
                </label>
            </div>
            @if (this._games.IsEmpty)
            {
                <p class="no-games">No games like that.</p>
            }
            <ul class="games">
                @foreach (GameSummaryDto game in this._games)
                {
                    <li>
                        <span class="game">@game.Id[..Math.Min(8, game.Id.Length)]</span>
                        <span class="ruleset">@NameOf(catalog, game.RulesetId)</span>
                        <span class="players">@Players(game)</span>
                        <span class="moves">@Moves(game)</span>
                        <span class="state">@this.StateOf(game)</span>
                        @if (game.IsOver)
                        {
                            <span class="over">Over</span>
                        }
                        else
                        {
                            @if (this._held.GetValueOrDefault(game.Id) is { } claim)
                            {
                                <button class="resume primary" @onclick="() => this.Resume(game.Id, claim)">Back to @SeatName(game.SeatNames, claim.Seat)</button>
                            }
                            else if (this.MySeat(game) is { } mine)
                            {
                                <button class="take-back primary"
                                        title="Your seat, taken from another device: take it back here"
                                        @onclick="() => this.TakeBack(game.Id, mine.Seat, mine.Token)">
                                    Back to @SeatName(game.SeatNames, mine.Seat)
                                </button>
                            }
                            @if (game.IsForPlayers && this._me is null)
                            {
                                <span class="for-players" title="Whoever set it up barred guests from its open seats">
                                    Sign in to join
                                </span>
                            }
                            else
                            {
                                @foreach (int seat in game.OpenSeats)
                                {
                                    <button class="join" @onclick="() => this.Join(game.Id, seat)">Join as @SeatName(game.SeatNames, seat)</button>
                                }
                            }
                            <button class="watch" @onclick="() => this.OnSeated.InvokeAsync(Seating.Watching(game.Id))">
                                Watch
                            </button>
                        }
                    </li>
                }
            </ul>
            @if (this._pages > 1)
            {
                <div class="pages">
                    <button class="previous" disabled="@(this._pageNumber <= 1)" @onclick="() => this.Turn(-1)">
                        Previous
                    </button>
                    <span class="page-number">Page @this._pageNumber of @this._pages (@this._total games)</span>
                    <button class="next" disabled="@(this._pageNumber >= this._pages)" @onclick="() => this.Turn(1)">
                        Next
                    </button>
                </div>
            }
        </div>

        <Leaderboard Game="@this.Game" />
    }
</section>

@code {
    private CatalogDto? _catalog;
    private string _rulesetId = string.Empty;
    private const string NotOver = "not-over";
    private const string Waiting = "waiting";
    private const string InProgress = "in-progress";
    private const string Mine = "mine";

    private ImmutableList<GameSummaryDto> _games = [];

    /// <summary>Which games the list shows: those waiting for players, until the player asks otherwise.</summary>
    private GameListQuery _filter = new(Open: true, Over: false);
    private int _pageNumber = 1;
    private int _pages = 1;
    private int _total;
    private ImmutableDictionary<string, SeatClaim> _held = ImmutableDictionary<string, SeatClaim>.Empty;

    /// <summary>The player signed in, by id, and the token they are signed in by; none, if no one is.</summary>
    private (string Id, string Token)? _me;

    /// <summary>The games waiting for the player signed in to decide, the one that changed earliest first.</summary>
    private ImmutableList<AwaitedGameDto> _awaited = [];
    private const int PersonLevel = GameStarter.PersonLevel;
    private const int OwnAiLevel = GameStarter.OwnAiLevel;

    private SetupMode _mode;
    private int _colour;
    private ImmutableList<Strength> _strengths = [];

    /// <summary>For each seat set up by strength, the index of its strength, or <see cref="PersonLevel"/>.</summary>
    private List<int> _levels = [];

    /// <summary>For each seat set up by strength, the bot chosen for it; empty, for any of its strength.</summary>
    private List<string> _picks = [];
    private string _scenario = string.Empty;

    private const string DraftOwn = "draft-own";
    private const string DraftOne = "draft-one";
    private const string RandomEach = "random-each";
    private const string RandomOne = "random-one";

    /// <summary>
    /// How a custom game's armies come to be (Stated, 2026-11-12, a choice of its own, not a checkbox): each player
    /// drafting their own, the default where the game lets them; the player drafting one army for everyone; every army
    /// at random, the default elsewhere; or one army at random for everyone. Set to the default as each game is chosen.
    /// </summary>
    private string _armies = RandomEach;

    /// <summary>
    /// What each seat has to spend, if the armies are drafted, one value for everyone: the game's own, as each game is
    /// chosen, until changed; if cleared, the game's own still.
    /// </summary>
    private int? _budget;

    /// <summary>
    /// For a game whose board's size its creator may set (Stated, 2026-11-12: the board's and the kingdoms' both): the
    /// cells on each side of the board, and each kingdom's width and depth; the game's own, as each game is chosen.
    /// </summary>
    private int _side;

    private int _kingdomWidth;
    private int _kingdomDepth;

    /// <summary>Whether the game's open seats are for players signed in only, as a player signed in may ask.</summary>
    private bool _isForPlayers;
    private bool _isSecret;
    private bool _isHiddenFromAllies;
    private string? _problem;

    /// <summary>How the player last started each game, by the game, as the browser remembers.</summary>
    private ImmutableDictionary<string, GameSetup> _setups = ImmutableDictionary<string, GameSetup>.Empty;

    /// <summary>Whether the lobby shows preview games, as the player last chose; not, unless they did.</summary>
    private bool _arePreviewsShown;

    [Parameter]
    public EventCallback<Seating> OnSeated { get; set; }

    /// <summary>Which game the lobby shows, as it is first shown and whenever the player chooses another.</summary>
    [Parameter]
    public EventCallback<string?> OnGameChosen { get; set; }

    protected override async Task OnInitializedAsync() => this._problem = await Requests.Attempt(this.Load);

    /// <summary>The game chosen to set up, at its size (<see cref="Choose"/> chose one before anything asks).</summary>
    private RulesetDto Ruleset(CatalogDto catalog) =>
        catalog.Rulesets.First(ruleset => ruleset.Id == this._rulesetId);

    /// <summary>The game, of the size, to set up; choosing another sets its seats up afresh.</summary>
    private string RulesetId
    {
        get => this._rulesetId;
        set
        {
            this._rulesetId = value;
            this.Prepare(this._catalog!);
        }
    }

    /// <summary>
    /// The game to set up, whatever its size; choosing another keeps this one's setup for coming back to it, and sets
    /// the other up as <see cref="Choose"/> does.
    /// </summary>
    private string Game
    {
        get => this.Ruleset(this._catalog!).Game;
        set
        {
            this._setups = this._setups.SetItem(this.Game, this.SetupNow(this._catalog!));
            this.Choose(this._catalog!, value);
        }
    }

    /// <summary>The game as it is set up now.</summary>
    private GameSetup SetupNow(CatalogDto catalog) =>
        new(this.Ruleset(catalog).Id, this._colour, [.. this._levels], [.. this._picks]);

    /// <summary>
    /// <paramref name="game"/> set up as the player last started it, if they have, and it still can be; else
    /// afresh, at its middle size (Proposed: of small, medium and large, medium).
    /// </summary>
    private void Choose(CatalogDto catalog, string game)
    {
        ImmutableList<RulesetDto> sizes = SizesOf(catalog, game);
        GameSetup? setup = this._setups.GetValueOrDefault(game);
        RulesetDto? remembered = sizes.FirstOrDefault(size => size.Id == setup?.RulesetId);
        this._rulesetId = (remembered ?? sizes[(sizes.Count - 1) / 2]).Id;
        this.Prepare(catalog);
        if (remembered is not null && this.Fits(setup!))
        {
            this.Restore(setup!);
        }
    }

    /// <summary>
    /// Whether <paramref name="setup"/> still fits the game: a colour it has, a strength it offers (or a person, or
    /// the player's own AI) for each of its seats, and room among each strength's bots for the seats given it.
    /// </summary>
    private bool Fits(GameSetup setup)
    {
        int seats = this._levels.Count;
        bool isWhole = setup.Colour >= 0
            && setup.Colour < seats
            && setup.Levels.Count == seats
            && setup.Picks.Count == seats
            && setup.Levels.All(level => level >= OwnAiLevel && level < this._strengths.Count);
        return isWhole
            && Enumerable.Range(0, seats).All(seat =>
                seat == setup.Colour
                || setup.Levels[seat] < 0
                || GameStarter.HasRoom(
                    this._strengths,
                    setup.Levels.Where((level, other) => other != seat && other != setup.Colour && level >= 0),
                    setup.Levels[seat]
                )
            );
    }

    /// <summary>The seats as <paramref name="setup"/> has them; a bot it chose that is no longer offered, any.</summary>
    private void Restore(GameSetup setup)
    {
        this._colour = setup.Colour;
        this._levels = [.. setup.Levels];
        this._picks =
        [
            .. setup.Picks.Select((pick, seat) =>
                this.StrengthOf(seat)?.Bots.Any(bot => bot.Id == pick) == true ? pick : string.Empty
            ),
        ];
    }

    /// <summary>Remembers the game the player starts, as they set it up, to set it up so again.</summary>
    private async Task Remember(CatalogDto catalog)
    {
        GameSetup setup = this.SetupNow(catalog);
        this._setups = this._setups.SetItem(this.Ruleset(catalog).Game, setup);
        await this.Browser.RememberSetup(this.Ruleset(catalog).Game, setup);
    }

    /// <summary>
    /// Each game the server offers, by its first ruleset, whatever the sizes it is played at; but for its previews,
    /// unless the player shows them, or the server offers nothing else.
    /// </summary>
    private ImmutableList<RulesetDto> GamesOf(CatalogDto catalog)
    {
        ImmutableList<RulesetDto> games = AllGamesOf(catalog);
        ImmutableList<RulesetDto> shown = [.. games.Where(game => this._arePreviewsShown || !game.IsPreview)];
        return shown.IsEmpty ? games : shown;
    }

    private static ImmutableList<RulesetDto> AllGamesOf(CatalogDto catalog) =>
        [.. catalog.Rulesets.DistinctBy(ruleset => ruleset.Game, StringComparer.Ordinal)];

    /// <summary>What a game is called, "Grand Legions (preview)" if it is a preview.</summary>
    private static string GameNameOf(RulesetDto game) => game.IsPreview ? $"{game.GameName} (preview)" : game.GameName;

    /// <summary>
    /// Shows preview games, or hides them, here and whenever the lobby is shown again: in the list, and among the
    /// games to start, of which one hidden while chosen gives way to the first shown.
    /// </summary>
    private async Task ShowPreviews(CatalogDto catalog, ChangeEventArgs change)
    {
        this._arePreviewsShown = true.Equals(change.Value);
        await this.Browser.SetPreviewsShown(this._arePreviewsShown);
        ImmutableList<RulesetDto> games = this.GamesOf(catalog);
        if (games.All(game => game.Game != this.Game))
        {
            this.Game = games[0].Game;
        }

        await this.Filter(this.OfGame(this._filter) with { Preview = this.PreviewFilter });
    }

    /// <summary>The list of the game chosen anew, at any size (Stated: one choice of game for the whole lobby).</summary>
    private async Task ListGame()
    {
        await this.Filter(this.OfGame(this._filter));
        await this.OnGameChosen.InvokeAsync(this.Game);
    }

    /// <summary>The list kept to the game chosen: at the size it was, if it is still that game, else at any.</summary>
    private GameListQuery OfGame(GameListQuery filter) =>
        filter.Game == this.Game ? filter : filter with { Game = this.Game, Ruleset = null };

    /// <summary>Which games the list keeps to: any, if the player shows previews; else those not previews.</summary>
    private bool? PreviewFilter => this._arePreviewsShown ? null : false;

    /// <summary>The sizes <paramref name="game"/> is played at, each its ruleset: one, unless it has several.</summary>
    private static ImmutableList<RulesetDto> SizesOf(CatalogDto catalog, string game) =>
        [.. catalog.Rulesets.Where(ruleset => ruleset.Game == game)];

    /// <summary>What the catalog calls a game's ruleset, "Grand Legions (small)"; its id, if one no longer offered.</summary>
    private static string NameOf(CatalogDto catalog, string rulesetId) =>
        catalog.Rulesets.FirstOrDefault(ruleset => ruleset.Id == rulesetId)?.Name ?? rulesetId;

    /// <summary>
    /// The seats other than <paramref name="you"/>, in the order they play after it: allies first, then enemies.
    /// </summary>
    private static IEnumerable<int> OthersOf(RulesetDto ruleset, int you) =>
        Enumerable.Range(1, ruleset.SeatCount - 1)
            .Select(step => (you + step) % ruleset.SeatCount)
            .OrderBy(seat => !IsAlly(ruleset, you, seat));

    private static bool IsAlly(RulesetDto ruleset, int you, int seat) =>
        ruleset.SeatTeams.ElementAtOrDefault(seat) == ruleset.SeatTeams.ElementAtOrDefault(you);

    private static string RoleOf(RulesetDto ruleset, int you, int seat) =>
        IsAlly(ruleset, you, seat) ? "Your ally" : "Enemy";

    private static string Moves(GameSummaryDto game) => game.Moves == 1 ? "1 move" : $"{game.Moves} moves";

    /// <summary>
    /// "Waiting for a player; created 3 h ago, last change 5 min ago", "Yellow away; ...": whether it waits for a seat
    /// to be taken or has not started, who is away (their turns passing until they come back), and when it was created
    /// and last changed, if those were kept.
    /// </summary>
    private string StateOf(GameSummaryDto game)
    {
        DateTimeOffset now = this.Clock.GetUtcNow();
        string? progress = (game.IsOver, game.OpenSeats.Count, game.Moves) switch
        {
            (false, 1, _) => "Waiting for a player",
            (false, > 1, _) => "Waiting for players",
            (false, _, 0) => "Not started",
            _ => null,
        };
        string away = game.AwaySeats.IsEmpty || game.IsOver
            ? string.Empty
            : $"{string.Join(" and ", game.AwaySeats.Select(seat => SeatName(game.SeatNames, seat)))} away";
        string? created = game.Created is { } time ? $"created {TimeAgo.Since(time, now)}" : null;
        string? changed = game.LastChanged is { } last ? $"last change {TimeAgo.Since(last, now)}" : null;
        string times = string.Join(", ", new[] { created, changed }.OfType<string>());
        return string.Join("; ", new[] { progress, away, times }.Where(part => !string.IsNullOrEmpty(part)));
    }

    /// <summary>What the ruleset calls the seat, "Black"; "seat 2" if it names none.</summary>
    private static string SeatName(ImmutableList<string> names, int seat) =>
        names.ElementAtOrDefault(seat) ?? $"seat {seat + 1}";

    /// <summary>"Black: person, Yellow: random, ...".</summary>
    private static string Players(GameSummaryDto game) =>
        string.Join(", ", game.Players.Select((player, seat) => $"{SeatName(game.SeatNames, seat)}: {player}"));

    private async Task Load()
    {
        CatalogDto catalog = await this.Games.Catalog(CancellationToken.None);
        this._me = await this.Browser.PlayerToken() is { } token
            && await this.Games.Me(token, CancellationToken.None) is { } player
                ? (player.Id, token)
                : null;
        this._awaited = this._me is { } me
            ? await this.Games.Awaiting(me.Token, CancellationToken.None) ?? []
            : [];
        await this.Recall(this._awaited.Select(awaited => awaited.Game));
        this._arePreviewsShown = await this.Browser.ArePreviewsShown();
        foreach (RulesetDto game in AllGamesOf(catalog))
        {
            this._setups = await this.Browser.SetupOf(game.Game) is { } setup
                ? this._setups.SetItem(game.Game, setup)
                : this._setups;
        }

        string? last = await this.Browser.LastGame();
        ImmutableList<RulesetDto> games = this.GamesOf(catalog);
        RulesetDto first = games.FirstOrDefault(game => game.Game == last) ?? games[0];
        this.Choose(catalog, first.Game);
        this._filter = this._filter with { Game = first.Game, Preview = this.PreviewFilter };
        await this.ListGames();
        this._mode = await this.Browser.Setup();
        this._catalog = catalog;
        await this.OnGameChosen.InvokeAsync(first.Game);
    }

    /// <summary>The page of games the filter asks for, and the seats this browser holds at them.</summary>
    private async Task ListGames()
    {
        GamePageDto page = await this.Games.List(this._filter, CancellationToken.None);
        this._games = page.Games;
        this._total = page.Total;
        this._pageNumber = page.Page;
        this._pages = Math.Max(1, (page.Total + page.PageSize - 1) / page.PageSize);
        await this.Recall(this._games);
    }

    /// <summary>The seats this browser holds at the games.</summary>
    private async Task Recall(IEnumerable<GameSummaryDto> games)
    {
        foreach (GameSummaryDto game in games)
        {
            this._held = await this.Browser.Recall(game.Id) is { } claim ? this._held.SetItem(game.Id, claim) : this._held;
        }
    }

    /// <summary>The list filtered anew, from its first page; told why not, if the server cannot.</summary>
    private async Task Filter(GameListQuery filter)
    {
        this._filter = filter with { Page = null };
        this._problem = await Requests.Attempt(this.ListGames);
    }

    /// <summary>The list of the chosen game at one size, or at any.</summary>
    private Task FilterSize(ChangeEventArgs change) => this.Filter(this._filter with { Ruleset = Chosen(change) });

    /// <summary>What was chosen; none, for "Any".</summary>
    private static string? Chosen(ChangeEventArgs change)
    {
        string chosen = $"{change.Value}";
        return chosen.Length > 0 ? chosen : null;
    }

    /// <summary>
    /// The games waiting for players to take their open seats, those under way, either, or those of the player signed
    /// in (Mine): at a seat they claimed signed in, whether or not they wait for others.
    /// </summary>
    private Task FilterState(ChangeEventArgs change) =>
        this.Filter(
            $"{change.Value}" switch
            {
                Waiting => this._filter with { Open = true, Player = null },
                InProgress => this._filter with { Open = false, Player = null },
                Mine => this._filter with { Open = null, Player = this._me.GetValueOrDefault().Id },
                _ => this._filter with { Open = null, Player = null },
            }
        );

    private Task FilterPeople(ChangeEventArgs change) =>
        this.Filter(this._filter with { PeopleOnly = true.Equals(change.Value) ? true : null });

    /// <summary>
    /// The games everyone named is at (Proposed: "Bob, Jo*, open", as <see cref="GameListQuery.Players"/> reads
    /// it); any, if no one is named.
    /// </summary>
    private Task FilterPlayers(ChangeEventArgs change) =>
        this.Filter(this._filter with { Players = Chosen(change) });

    /// <summary>The page <paramref name="by"/> pages on (or back).</summary>
    private async Task Turn(int by)
    {
        this._filter = this._filter with { Page = this._pageNumber + by };
        this._problem = await Requests.Attempt(this.ListGames);
    }

    /// <summary>What the list shows, as the Show choice names it.</summary>
    private static string StateOf(GameListQuery filter)
    {
        if (filter.Player is not null)
        {
            return Mine;
        }

        if (true.Equals(filter.Open))
        {
            return Waiting;
        }

        return false.Equals(filter.Open) ? InProgress : NotOver;
    }

    /// <summary>
    /// The chosen game's seats set up afresh: the player's ally and enemies each at the middle strength with a bot
    /// left.
    /// </summary>
    private void Prepare(CatalogDto catalog)
    {
        this._colour = 0;
        if (this.Ruleset(catalog).SizableBoard is { } board)
        {
            (this._side, this._kingdomWidth, this._kingdomDepth) = (board.Side, board.KingdomWidth, board.KingdomDepth);
        }

        this._strengths = this.StrengthsOf(catalog);
        this._levels = [.. Enumerable.Repeat(PersonLevel, this.Ruleset(catalog).SeatCount)];
        foreach (int seat in OthersOf(this.Ruleset(catalog), this._colour).Append(this._colour))
        {
            this._levels[seat] =
                GameStarter.LevelWithRoom(this._strengths, this.TakenBesides(seat), this._strengths.Count / 2);
        }

        this._picks = [.. Enumerable.Repeat(string.Empty, this.Ruleset(catalog).SeatCount)];
        this._armies = this.Ruleset(catalog).IsDraftable ? DraftOwn : RandomEach;
        this._budget = this.Ruleset(catalog).DraftBudget;
    }

    /// <summary>
    /// The bots' strengths at the game, rated, for a board set to another size, as at the nearest of the game's own
    /// (<see cref="GameStarter.RatedAs"/>).
    /// </summary>
    private ImmutableList<Strength> StrengthsOf(CatalogDto catalog) =>
        GameStarter.Strengths(
            catalog,
            GameStarter.RatedAs(catalog, this.Ruleset(catalog).Id, this.BoardAsked(catalog))
        );

    /// <summary>
    /// The board as set, if the game's creator may set it; none, if not. Its budget grows with the kingdoms, cell for
    /// cell, from the game's own (<see cref="RulesetDto.SizableBoard"/>).
    /// </summary>
    private BoardSizeDto? BoardAsked(CatalogDto catalog) =>
        this.Ruleset(catalog).SizableBoard is null
            ? null
            : new BoardSizeDto(this._side, this._kingdomWidth, this._kingdomDepth);

    /// <summary>
    /// The most an army may have to spend, the game's own limit, grown with the kingdoms as they are set; any more is
    /// held to it.
    /// </summary>
    private int BudgetLimit(CatalogDto catalog)
    {
        RulesetDto ruleset = this.Ruleset(catalog);
        int limit = ruleset.DraftBudgetLimit.GetValueOrDefault();
        return ruleset.SizableBoard is { } board
            ? limit * this._kingdomWidth * this._kingdomDepth / (board.KingdomWidth * board.KingdomDepth)
            : limit;
    }

    /// <summary>
    /// The budget again, for kingdoms of the size now set, as the game's grows with them; and the bots' strengths, as
    /// rated at the size nearest it, each seat keeping its strength where it still may.
    /// </summary>
    private void Resized()
    {
        RulesetDto ruleset = this.Ruleset(this._catalog!);
        BoardSizeDto board = ruleset.SizableBoard!;
        this._budget = ruleset.DraftBudget is { } budget
            ? budget * this._kingdomWidth * this._kingdomDepth / (board.KingdomWidth * board.KingdomDepth)
            : null;
        this._strengths = this.StrengthsOf(this._catalog!);
        this._levels = [.. this._levels.Select(level => Math.Min(level, this._strengths.Count - 1))];
    }

    /// <summary>
    /// The player's colour. A seat they take keeps no bot chosen for it, which another seat might have chosen
    /// since; the seat they leave is played as it was, unless its strength's bots all have seats by now, when it
    /// is played at the nearest strength with a bot left (or by a person, if none has).
    /// </summary>
    private int Colour
    {
        get => this._colour;
        set
        {
            int left = this._colour;
            this._colour = value;
            this._picks[value] = string.Empty;
            this._levels[left] = this._levels[left] < 0 || this.HasRoom(this._levels[left], left)
                ? this._levels[left]
                : GameStarter.LevelWithRoom(this._strengths, this.TakenBesides(left), this._levels[left]);
        }
    }

    /// <summary>The strengths of the seats played by bots, but for <paramref name="seat"/> and the player's.</summary>
    private IEnumerable<int> TakenBesides(int seat) =>
        this._levels.Where((level, other) => other != seat && other != this._colour && level >= 0);

    /// <summary>Whether the strength at <paramref name="level"/> has a bot left for <paramref name="seat"/>.</summary>
    private bool HasRoom(int level, int seat) => GameStarter.HasRoom(this._strengths, this.TakenBesides(seat), level);

    private async Task Create(CatalogDto catalog)
    {
        await this.Remember(catalog);
        await this.Sit(async () => await GameStarter.Start(
            this.Games,
            this.Ruleset(catalog).Id,
            GameStarter.ByStrength(this.ChoicesOfSeats(), this._strengths),
            this._colour,
            this._scenario.Length == 0 ? null : this._scenario,
            await this.Browser.Claimant(),
            armies: this.ArmiesAsked(catalog),
            isForPlayers: this._isForPlayers
        ));
    }

    private bool IsDrafting => this._armies is DraftOwn or DraftOne;

    /// <summary>
    /// How the game is asked to have its armies, as chosen, on the board as set; the player drafting for all from their
    /// seat.
    /// </summary>
    private ArmyDeal ArmiesAsked(CatalogDto catalog) =>
        this._armies switch
        {
            DraftOwn => new ArmyDeal(false)
            {
                IsDrafted = true,
                Budget = this._budget,
                IsSecret = this._isSecret,
                IsHiddenFromAllies = this._isSecret && this._isHiddenFromAllies,
            },
            DraftOne => new ArmyDeal(false) { IsDrafted = true, Budget = this._budget, Drafter = this._colour },
            RandomOne => new ArmyDeal(true),
            _ => new ArmyDeal(false),
        } with
        {
            Board = this.BoardAsked(catalog),
        };

    /// <summary>How each seat set up by strength is played: the player's own, and a person's, by no bot.</summary>
    private IEnumerable<SeatChoice> ChoicesOfSeats() =>
        Enumerable.Range(0, this._levels.Count).Select(seat =>
            seat == this._colour
                ? new SeatChoice(null)
                : new SeatChoice(this.StrengthOf(seat), this._picks[seat].Length == 0 ? null : this._picks[seat])
        );

    /// <summary>The strength the seat is played at; none, if by a person or the player's own AI.</summary>
    private Strength? StrengthOf(int seat) =>
        this._levels[seat] < 0 ? null : this._strengths[this._levels[seat]];

    /// <summary>Whether <paramref name="bot"/> was chosen for a seat other than <paramref name="seat"/>.</summary>
    private bool IsPicked(string bot, int seat) =>
        this._picks.Where((_, other) => other != seat && other != this._colour).Contains(bot);

    private string IsPressed(SetupMode mode) => this._mode == mode ? "true" : "false";

    /// <summary>Sets up new games as <paramref name="mode"/> does, here and whenever the lobby is shown again.</summary>
    private async Task SetUp(SetupMode mode)
    {
        this._mode = mode;
        await this.Browser.SetSetup(mode);
    }

    private async Task Quick(CatalogDto catalog, Difficulty difficulty)
    {
        await this.Remember(catalog);
        await this.Sit(async () =>
            await GameStarter.Quick(
                this.Games,
                catalog,
                this.Ruleset(catalog),
                difficulty,
                await this.Browser.Claimant(),
                this.BoardAsked(catalog)
            )
        );
    }

    private Task Join(string gameId, int seat) =>
        this.Sit(async () => await GameStarter.Claim(this.Games, gameId, seat, await this.Browser.Claimant()));

    /// <summary>Back to a seat held, known there as the player is now: signed in, or by their nickname.</summary>
    private Task Resume(string gameId, SeatClaim claim) =>
        this.Sit(async () => await GameStarter.Resume(this.Games, gameId, claim, await this.Browser.Claimant()));

    /// <summary>
    /// Back to a seat the player claimed signed in, from another device, or a browser that has forgotten it: taken
    /// back for a new token, which this browser keeps from now on (Stated: from any device).
    /// </summary>
    private Task TakeBack(string gameId, int seat, string playerToken) =>
        this.Sit(async () =>
        {
            SeatClaimedDto taken = await this.Games.TakeBack(gameId, seat, playerToken, CancellationToken.None);
            return new Seating(gameId, new SeatClaim(seat, taken.Token));
        });

    /// <summary>
    /// Back to a game waiting for the player: to the seat this browser holds there, if it holds it; else taken back.
    /// </summary>
    private Task BackTo(string gameId, int seat, string playerToken) =>
        this._held.GetValueOrDefault(gameId) is { } claim && claim.Seat == seat
            ? this.Resume(gameId, claim)
            : this.TakeBack(gameId, seat, playerToken);

    /// <summary>The seat the player signed in plays at the game, themselves, if any, and their token.</summary>
    private (int Seat, string Token)? MySeat(GameSummaryDto game) =>
        this._me is { } me && game.PlayerIds.IndexOf(me.Id) is >= 0 and var seat ? (seat, me.Token) : null;

    private async Task Sit(Func<Task<Seating>> seating) =>
        this._problem = await Requests.Attempt(async () => await this.OnSeated.InvokeAsync(await seating()));
}
