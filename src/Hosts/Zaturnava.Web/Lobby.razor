@* Start a game (each seat a person or a bot, no bot in two seats) and sit at it: the game, and, for one played at
   several sizes, its size; set up as the player last chose (remembered in the browser), else quick - custom: the
   player's colour, then for their ally and each enemy a person, an AI of the player's own (the seat left open
   for it), or how strong a bot (easy, medium or
   hard, by the bots' ratings; a strength whose bots all have seats is offered to no other), and, if they like,
   which of those bots, each named with its rating; else each is chosen at random among them - or quick: start one
   at once, at a seat chosen at random, easy, medium or hard by which bots it seats among the others - or join,
   watch or go back to one already started; a game over is only listed, with nothing left to watch. Seats go by
   the ruleset's names for them (Black, Yellow...), not by number. A bot paid for each use is seated only when
   chosen: never by default, nor at random. A server in development also offers scenarios, games set up
   part-way, to start from. *@
@inject IGameServing Games
@inject Browser Browser

<section class="lobby">
    @if (this._problem is { } problem)
    {
        <p class="problem" role="alert">@problem</p>
    }

    @if (this._catalog is { } catalog)
    {
        <div class="panel">
            <h2>New game</h2>
            @{
                ImmutableList<RulesetDto> games = GamesOf(catalog);
                ImmutableList<RulesetDto> sizes = SizesOf(catalog, this.Ruleset(catalog).Game);
            }
            @if (games.Count > 1)
            {
                <label class="rules">
                    Game
                    <select class="game" @bind="this.Game">
                        @foreach (RulesetDto game in games)
                        {
                            <option value="@game.Game">@game.GameName</option>
                        }
                    </select>
                </label>
            }
            else
            {
                <p class="rules">@this.Ruleset(catalog).GameName</p>
            }
            <div class="setup-modes">
                <button class="mode quick-game"
                        aria-pressed="@this.IsPressed(SetupMode.Quick)"
                        @onclick="() => this.SetUp(SetupMode.Quick)">
                    Quick game
                </button>
                <button class="mode custom"
                        aria-pressed="@this.IsPressed(SetupMode.Custom)"
                        @onclick="() => this.SetUp(SetupMode.Custom)">
                    Custom
                </button>
            </div>
            @if (sizes.Count > 1)
            {
                <label class="size">
                    Size
                    <select class="size" @bind="this.RulesetId">
                        @foreach (RulesetDto ruleset in sizes)
                        {
                            <option value="@ruleset.Id">@ruleset.Size</option>
                        }
                    </select>
                </label>
            }
            @if (this._mode == SetupMode.Quick)
            {
                <div class="quick-games">
                    <span class="quick-label">At any seat, against bots:</span>
                    <button class="quick easy primary" @onclick="() => this.Quick(catalog, Difficulty.Easy)">Easy</button>
                    <button class="quick medium primary" @onclick="() => this.Quick(catalog, Difficulty.Medium)">Medium</button>
                    <button class="quick hard primary" @onclick="() => this.Quick(catalog, Difficulty.Hard)">Hard</button>
                </div>
                <p class="quick-hint">
                    Easy seats the three easiest bots; medium, any three; hard, the three hardest. Who they are is under
                    <strong>The bots</strong>, below.
                </p>
            }
            else
            {
                <ol class="plans strengths">
                    <li>
                        <span class="seat-name">You play</span>
                        <select class="colour" @bind="this.Colour">
                            @foreach (int seat in Enumerable.Range(0, this.Ruleset(catalog).SeatCount))
                            {
                                <option value="@seat">@SeatName(this.Ruleset(catalog).SeatNames, seat)</option>
                            }
                        </select>
                    </li>
                    @foreach (int seat in OthersOf(this.Ruleset(catalog), this._colour))
                    {
                        <li>
                            <span class="seat-name">
                                @RoleOf(this.Ruleset(catalog), this._colour, seat), @SeatName(this.Ruleset(catalog).SeatNames, seat)
                            </span>
                            <select class="strength"
                                    @bind="this._levels[seat]"
                                    @bind:after="() => this._picks[seat] = string.Empty">
                                <option value="@PersonLevel">Person</option>
                                <option value="@OwnAiLevel">Your own AI</option>
                                @foreach (int level in Enumerable.Range(0, this._strengths.Count))
                                {
                                    <option value="@level" disabled="@(!this.HasRoom(level, seat))">
                                        @this._strengths[level].Label
                                    </option>
                                }
                            </select>
                            @if (this.StrengthOf(seat) is { Bots.Count: > 1 } strength)
                            {
                                <select class="pick" aria-label="Which bot" @bind="this._picks[seat]">
                                    <option value="">Any of them</option>
                                    @foreach (BotDto bot in strength.Bots)
                                    {
                                        <option value="@bot.Id" disabled="@this.IsPicked(bot.Id, seat)">
                                            @strength.LabelOf(bot)
                                        </option>
                                    }
                                </select>
                            }
                        </li>
                    }
                </ol>
                @if (this._levels.Contains(OwnAiLevel))
                {
                    <p class="hint own-ai">
                        A seat for your own AI stays open until it takes it: by MCP or the HTTP API, with this game's
                        id, shown at the table, and an AI token from your profile.
                        <a href="@DocsLinks.Bots" target="_blank" rel="noopener noreferrer">How to connect it</a>
                    </p>
                }
            }
            @if (this._mode != SetupMode.Quick && !catalog.Scenarios.IsEmpty)
            {
                <label class="scenario">
                    Start from
                    <select class="scenario" @bind="this._scenario">
                        <option value="">The beginning</option>
                        @foreach (ScenarioDto scenario in catalog.Scenarios)
                        {
                            <option value="@scenario.Id">Scenario: @scenario.Name</option>
                        }
                    </select>
                </label>
                @if (catalog.Scenarios.FirstOrDefault(scenario => scenario.Id == this._scenario) is { } chosen)
                {
                    <p class="scenario-description">@chosen.Description</p>
                }
            }
            @if (this._mode != SetupMode.Quick)
            {
                <button class="create primary" @onclick="() => this.Create(catalog)">Play</button>
            }
        </div>

        <div class="panel">
            <h2>Games</h2>
            <div class="game-filters">
                <label>
                    Game
                    <select class="filter-game" value="@this._filter.Game" @onchange="this.FilterGame">
                        <option value="">Any</option>
                        @foreach (RulesetDto game in GamesOf(catalog))
                        {
                            <option value="@game.Game">@game.GameName</option>
                        }
                    </select>
                </label>
                @{
                    ImmutableList<RulesetDto> filteredSizes =
                        this._filter.Game is { } filtered ? SizesOf(catalog, filtered) : [];
                }
                @if (filteredSizes.Count > 1)
                {
                    <label>
                        Size
                        <select class="filter-size" value="@this._filter.Ruleset" @onchange="this.FilterSize">
                            <option value="">Any</option>
                            @foreach (RulesetDto ruleset in filteredSizes)
                            {
                                <option value="@ruleset.Id">@ruleset.Size</option>
                            }
                        </select>
                    </label>
                }
                <label>
                    Show
                    <select class="filter-state" value="@StateOf(this._filter)" @onchange="this.FilterState">
                        <option value="@NotOver">Any not over</option>
                        <option value="@Waiting">Waiting for players</option>
                        <option value="@InProgress">In progress</option>
                    </select>
                </label>
                <label class="people-only">
                    <input type="checkbox"
                           class="filter-people"
                           checked="@(this._filter.PeopleOnly == true)"
                           @onchange="this.FilterPeople" />
                    No bots
                </label>
            </div>
            @if (this._games.IsEmpty)
            {
                <p class="no-games">No games like that.</p>
            }
            <ul class="games">
                @foreach (GameSummaryDto game in this._games)
                {
                    <li>
                        <span class="game">@game.Id[..Math.Min(8, game.Id.Length)]</span>
                        <span class="ruleset">@NameOf(catalog, game.RulesetId)</span>
                        <span class="players">@Players(game)</span>
                        <span class="moves">@Moves(game)</span>
                        @if (game.IsOver)
                        {
                            <span class="over">Over</span>
                        }
                        else
                        {
                            @if (this._held.GetValueOrDefault(game.Id) is { } claim)
                            {
                                <button class="resume primary" @onclick="() => this.Resume(game.Id, claim)">Back to @SeatName(game.SeatNames, claim.Seat)</button>
                            }
                            @foreach (int seat in game.OpenSeats)
                            {
                                <button class="join" @onclick="() => this.Join(game.Id, seat)">Join as @SeatName(game.SeatNames, seat)</button>
                            }
                            <button class="watch" @onclick="() => this.OnSeated.InvokeAsync(Seating.Watching(game.Id))">
                                Watch
                            </button>
                        }
                    </li>
                }
            </ul>
            @if (this._pages > 1)
            {
                <div class="pages">
                    <button class="previous" disabled="@(this._pageNumber <= 1)" @onclick="() => this.Turn(-1)">
                        Previous
                    </button>
                    <span class="page-number">Page @this._pageNumber of @this._pages (@this._total games)</span>
                    <button class="next" disabled="@(this._pageNumber >= this._pages)" @onclick="() => this.Turn(1)">
                        Next
                    </button>
                </div>
            }
        </div>
    }
</section>

@code {
    private CatalogDto? _catalog;
    private string _rulesetId = string.Empty;
    private const string NotOver = "not-over";
    private const string Waiting = "waiting";
    private const string InProgress = "in-progress";

    private ImmutableList<GameSummaryDto> _games = [];

    /// <summary>Which games the list shows (Proposed): only those not over, until the player asks otherwise.</summary>
    private GameListQuery _filter = new(Over: false);
    private int _pageNumber = 1;
    private int _pages = 1;
    private int _total;
    private ImmutableDictionary<string, SeatClaim> _held = ImmutableDictionary<string, SeatClaim>.Empty;
    private const int PersonLevel = GameStarter.PersonLevel;
    private const int OwnAiLevel = GameStarter.OwnAiLevel;

    private SetupMode _mode;
    private int _colour;
    private ImmutableList<Strength> _strengths = [];

    /// <summary>For each seat set up by strength, the index of its strength, or <see cref="PersonLevel"/>.</summary>
    private List<int> _levels = [];

    /// <summary>For each seat set up by strength, the bot chosen for it; empty, for any of its strength.</summary>
    private List<string> _picks = [];
    private string _scenario = string.Empty;
    private string? _problem;

    [Parameter]
    public EventCallback<Seating> OnSeated { get; set; }

    protected override async Task OnInitializedAsync() => this._problem = await Requests.Attempt(this.Load);

    /// <summary>The game chosen to set up: the first the server offers, until another is.</summary>
    private RulesetDto Ruleset(CatalogDto catalog) =>
        catalog.Rulesets.FirstOrDefault(ruleset => ruleset.Id == this._rulesetId) ?? catalog.Rulesets[0];

    /// <summary>The game, of the size, to set up; choosing another sets its seats up afresh.</summary>
    private string RulesetId
    {
        get => this._rulesetId;
        set
        {
            this._rulesetId = value;
            this.Prepare(this._catalog!);
        }
    }

    /// <summary>
    /// The game to set up, whatever its size; choosing another sets it up at the same size, if it has one, else at
    /// its first.
    /// </summary>
    private string Game
    {
        get => this.Ruleset(this._catalog!).Game;
        set
        {
            ImmutableList<RulesetDto> sizes = SizesOf(this._catalog!, value);
            string? size = this.Ruleset(this._catalog!).Size;
            this.RulesetId = (sizes.FirstOrDefault(ruleset => ruleset.Size == size) ?? sizes[0]).Id;
        }
    }

    /// <summary>Each game the server offers, by its first ruleset, whatever the sizes it is played at.</summary>
    private static ImmutableList<RulesetDto> GamesOf(CatalogDto catalog) =>
        [.. catalog.Rulesets.DistinctBy(ruleset => ruleset.Game, StringComparer.Ordinal)];

    /// <summary>The sizes <paramref name="game"/> is played at, each its ruleset: one, unless it has several.</summary>
    private static ImmutableList<RulesetDto> SizesOf(CatalogDto catalog, string game) =>
        [.. catalog.Rulesets.Where(ruleset => ruleset.Game == game)];

    /// <summary>What the catalog calls a game's ruleset, "Grand Legions (small)"; its id, if one no longer offered.</summary>
    private static string NameOf(CatalogDto catalog, string rulesetId) =>
        catalog.Rulesets.FirstOrDefault(ruleset => ruleset.Id == rulesetId)?.Name ?? rulesetId;

    /// <summary>
    /// The seats other than <paramref name="you"/>, in the order they play after it: allies first, then enemies.
    /// </summary>
    private static IEnumerable<int> OthersOf(RulesetDto ruleset, int you) =>
        Enumerable.Range(1, ruleset.SeatCount - 1)
            .Select(step => (you + step) % ruleset.SeatCount)
            .OrderBy(seat => !IsAlly(ruleset, you, seat));

    private static bool IsAlly(RulesetDto ruleset, int you, int seat) =>
        ruleset.SeatTeams.ElementAtOrDefault(seat) == ruleset.SeatTeams.ElementAtOrDefault(you);

    private static string RoleOf(RulesetDto ruleset, int you, int seat) =>
        IsAlly(ruleset, you, seat) ? "Your ally" : "Enemy";

    private static string Moves(GameSummaryDto game) => game.Moves == 1 ? "1 move" : $"{game.Moves} moves";

    /// <summary>What the ruleset calls the seat, "Black"; "seat 2" if it names none.</summary>
    private static string SeatName(ImmutableList<string> names, int seat) =>
        names.ElementAtOrDefault(seat) ?? $"seat {seat + 1}";

    /// <summary>"Black: person, Yellow: random, ...".</summary>
    private static string Players(GameSummaryDto game) =>
        string.Join(", ", game.Players.Select((player, seat) => $"{SeatName(game.SeatNames, seat)}: {player}"));

    private async Task Load()
    {
        CatalogDto catalog = await this.Games.Catalog(CancellationToken.None);
        await this.ListGames();
        this.Prepare(catalog);
        this._mode = await this.Browser.Setup();
        this._catalog = catalog;
    }

    /// <summary>The page of games the filter asks for, and the seats this browser holds at them.</summary>
    private async Task ListGames()
    {
        GamePageDto page = await this.Games.List(this._filter, CancellationToken.None);
        this._games = page.Games;
        this._total = page.Total;
        this._pageNumber = page.Page;
        this._pages = Math.Max(1, (page.Total + page.PageSize - 1) / page.PageSize);
        foreach (GameSummaryDto game in this._games)
        {
            this._held = await this.Browser.Recall(game.Id) is { } claim ? this._held.SetItem(game.Id, claim) : this._held;
        }
    }

    /// <summary>The list filtered anew, from its first page; told why not, if the server cannot.</summary>
    private async Task Filter(GameListQuery filter)
    {
        this._filter = filter with { Page = null };
        this._problem = await Requests.Attempt(this.ListGames);
    }

    /// <summary>The list of one game, at any size, or of any game.</summary>
    private Task FilterGame(ChangeEventArgs change) =>
        this.Filter(this._filter with { Game = Chosen(change), Ruleset = null });

    /// <summary>The list of the chosen game at one size, or at any.</summary>
    private Task FilterSize(ChangeEventArgs change) => this.Filter(this._filter with { Ruleset = Chosen(change) });

    /// <summary>What was chosen; none, for "Any".</summary>
    private static string? Chosen(ChangeEventArgs change)
    {
        string chosen = $"{change.Value}";
        return chosen.Length > 0 ? chosen : null;
    }

    /// <summary>The games waiting for players to take their open seats, those under way, or either.</summary>
    private Task FilterState(ChangeEventArgs change) =>
        this.Filter(
            $"{change.Value}" switch
            {
                Waiting => this._filter with { Open = true },
                InProgress => this._filter with { Open = false },
                _ => this._filter with { Open = null },
            }
        );

    private Task FilterPeople(ChangeEventArgs change) =>
        this.Filter(this._filter with { PeopleOnly = true.Equals(change.Value) ? true : null });

    /// <summary>The page <paramref name="by"/> pages on (or back).</summary>
    private async Task Turn(int by)
    {
        this._filter = this._filter with { Page = this._pageNumber + by };
        this._problem = await Requests.Attempt(this.ListGames);
    }

    /// <summary>What the list shows, as the Show choice names it.</summary>
    private static string StateOf(GameListQuery filter)
    {
        if (true.Equals(filter.Open))
        {
            return Waiting;
        }

        return false.Equals(filter.Open) ? InProgress : NotOver;
    }

    /// <summary>
    /// The chosen game's seats set up afresh: the player's ally and enemies each at the middle strength with a bot
    /// left.
    /// </summary>
    private void Prepare(CatalogDto catalog)
    {
        this._colour = 0;
        this._strengths = GameStarter.Strengths(catalog, this.Ruleset(catalog).Id);
        this._levels = [.. Enumerable.Repeat(PersonLevel, this.Ruleset(catalog).SeatCount)];
        foreach (int seat in OthersOf(this.Ruleset(catalog), this._colour).Append(this._colour))
        {
            this._levels[seat] =
                GameStarter.LevelWithRoom(this._strengths, this.TakenBesides(seat), this._strengths.Count / 2);
        }

        this._picks = [.. Enumerable.Repeat(string.Empty, this.Ruleset(catalog).SeatCount)];
    }

    /// <summary>
    /// The player's colour. A seat they take keeps no bot chosen for it, which another seat might have chosen
    /// since; the seat they leave is played as it was, unless its strength's bots all have seats by now, when it
    /// is played at the nearest strength with a bot left (or by a person, if none has).
    /// </summary>
    private int Colour
    {
        get => this._colour;
        set
        {
            int left = this._colour;
            this._colour = value;
            this._picks[value] = string.Empty;
            this._levels[left] = this._levels[left] < 0 || this.HasRoom(this._levels[left], left)
                ? this._levels[left]
                : GameStarter.LevelWithRoom(this._strengths, this.TakenBesides(left), this._levels[left]);
        }
    }

    /// <summary>The strengths of the seats played by bots, but for <paramref name="seat"/> and the player's.</summary>
    private IEnumerable<int> TakenBesides(int seat) =>
        this._levels.Where((level, other) => other != seat && other != this._colour && level >= 0);

    /// <summary>Whether the strength at <paramref name="level"/> has a bot left for <paramref name="seat"/>.</summary>
    private bool HasRoom(int level, int seat) => GameStarter.HasRoom(this._strengths, this.TakenBesides(seat), level);

    private Task Create(CatalogDto catalog) =>
        this.Sit(async () => await GameStarter.Start(
            this.Games,
            this.Ruleset(catalog).Id,
            GameStarter.ByStrength(this.ChoicesOfSeats(), this._strengths),
            this._colour,
            this._scenario.Length == 0 ? null : this._scenario,
            await this.Browser.Claimant()
        ));

    /// <summary>How each seat set up by strength is played: the player's own, and a person's, by no bot.</summary>
    private IEnumerable<SeatChoice> ChoicesOfSeats() =>
        Enumerable.Range(0, this._levels.Count).Select(seat =>
            seat == this._colour
                ? new SeatChoice(null)
                : new SeatChoice(this.StrengthOf(seat), this._picks[seat].Length == 0 ? null : this._picks[seat])
        );

    /// <summary>The strength the seat is played at; none, if by a person or the player's own AI.</summary>
    private Strength? StrengthOf(int seat) =>
        this._levels[seat] < 0 ? null : this._strengths[this._levels[seat]];

    /// <summary>Whether <paramref name="bot"/> was chosen for a seat other than <paramref name="seat"/>.</summary>
    private bool IsPicked(string bot, int seat) =>
        this._picks.Where((_, other) => other != seat && other != this._colour).Contains(bot);

    private string IsPressed(SetupMode mode) => this._mode == mode ? "true" : "false";

    /// <summary>Sets up new games as <paramref name="mode"/> does, here and whenever the lobby is shown again.</summary>
    private async Task SetUp(SetupMode mode)
    {
        this._mode = mode;
        await this.Browser.SetSetup(mode);
    }

    private Task Quick(CatalogDto catalog, Difficulty difficulty) =>
        this.Sit(async () =>
            await GameStarter.Quick(
                this.Games,
                catalog,
                this.Ruleset(catalog),
                difficulty,
                await this.Browser.Claimant()
            )
        );

    private Task Join(string gameId, int seat) =>
        this.Sit(async () => await GameStarter.Claim(this.Games, gameId, seat, await this.Browser.Claimant()));

    /// <summary>Back to a seat held, known there as the player is now: signed in, or by their nickname.</summary>
    private Task Resume(string gameId, SeatClaim claim) =>
        this.Sit(async () => await GameStarter.Resume(this.Games, gameId, claim, await this.Browser.Claimant()));

    private async Task Sit(Func<Task<Seating>> seating) =>
        this._problem = await Requests.Attempt(async () => await this.OnSeated.InvokeAsync(await seating()));
}
