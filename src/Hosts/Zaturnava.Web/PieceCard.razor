@* What a player is told of a piece they clicked on, whether or not they may move it: as labelled facts, whose it
   is, where it stands, and its kind's class, the game it comes from, value (what taking it scores), and what its own promotion may make
   it, if it has one, and where, saying so if the game does not play it yet; then how it moves and captures -
   drawn (MoveDiagramView), turned as the board shows its army, and in words where the ruleset draws nothing or
   the drawing has pieces to hop over, which one drawing cannot tell all of (a hop over any gap, say) - its
   powers, those every piece of its sort has (common) apart from its own (special), and what holds it back, each as
   the ruleset tells it. A kind the ruleset tells nothing of shows its owner and square alone. The player may drag
   the card by its header wherever they like; it opens where they last put it. *@
@inject Browser Browser

<aside class="piece-card" aria-label="About this piece" @ref="this._card">
    <header>
        <PieceIcon Kind="@this.Piece.Kind" Name="@this.Piece.Name" Owner="this.Piece.Owner" Mark="this.Piece.Mark" Pieces="this.Pieces" />
        <h2>@this.Named(this.Piece.Name)</h2>
        <button class="close" title="Close" @onclick="this.OnClose">&#x2715;</button>
    </header>
    <dl class="facts">
        <dt>Owner</dt>
        <dd class="owner">@this.Owner</dd>
        @if (this.Cell.Length > 0)
        {
            <dt>Square</dt>
            <dd class="square">@this.Cell</dd>
        }
        @if (this.Kind?.Class is { } pieceClass)
        {
            <dt>Class</dt>
            <dd class="class">@pieceClass</dd>
        }
        @if (this.Kind?.Origin is { } origin)
        {
            <dt title="The game it comes from">From</dt>
            <dd class="origin">@origin</dd>
        }
        @if (this.Kind is { } known)
        {
            <dt title="What taking it scores">Value</dt>
            <dd class="value">@known.Value</dd>
            @if (!known.PromotesTo.IsEmpty)
            {
                <dt title="What its own promotion may make it">Promotes to</dt>
                <dd class="promotes-to">
                    @this.Named(string.Join(", ", known.PromotesTo))
                    @if (known.PromotesWhere is { } where)
                    {
                        <span class="where">, @where</span>
                    }
                    @if (!known.IsPromotionPlayed)
                    {
                        <span class="not-yet"> (not yet in play)</span>
                    }
                </dd>
            }
        }
    </dl>
    @if (this.Kind is { } kind)
    {
        @if (kind.Diagram is { Side: > 0 } diagram)
        {
            <MoveDiagramView Diagram="diagram"
                             Piece="this.Piece"
                             Pieces="this.Pieces"
                             Angle="this.Turn.AngleOf(this.Forward)"
                             IsOnDark="this.IsOnDark" />
        }
        @if (kind.Diagram is not { Side: > 0 } || !kind.Diagram.Screens.IsEmpty || !kind.Diagram.Jumps.IsEmpty)
        {
            @this.Listed("moves", "Moves", kind.Moves)
            @this.Listed("captures", "Captures", kind.Captures)
        }
        @this.Listed("powers", "Common powers", kind.Powers)
        @this.Listed("special-powers", "Special powers", kind.SpecialPowers)
        @this.Listed("restrictions", "Restrictions", kind.Restrictions)
    }
</aside>

@code {
    private ElementReference _card;

    [Parameter, EditorRequired]
    public PieceDto Piece { get; set; } = null!;

    /// <summary>What the ruleset tells of the piece's kind; none, from a server that tells nothing.</summary>
    [Parameter]
    public PieceKindDto? Kind { get; set; }

    /// <summary>Whose it is: "Yellow".</summary>
    [Parameter, EditorRequired]
    public string Owner { get; set; } = string.Empty;

    /// <summary>Where it stands: "c3"; empty, for a piece not yet on the board, being placed.</summary>
    [Parameter, EditorRequired]
    public string Cell { get; set; } = string.Empty;

    [Parameter]
    public PieceSet Pieces { get; set; }

    /// <summary>Which way is forward for the piece's army, on the board unturned: up, unless set.</summary>
    [Parameter]
    public DirectionDto Forward { get; set; } = new(0, 1);

    /// <summary>Whether the piece stands on a dark square: the diagram's centre is shaded to match.</summary>
    [Parameter]
    public bool IsOnDark { get; set; }

    /// <summary>How the board is turned: the diagram is turned with it.</summary>
    [Parameter]
    public BoardTurn Turn { get; set; } = BoardTurn.None;

    [Parameter]
    public EventCallback OnClose { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender) =>
        await (firstRender ? this.Browser.MakeDraggable(this._card) : ValueTask.CompletedTask);

    private string Named(string text) => PieceStyle.Named(text, this.Pieces);

    /// <summary>A heading and its list, the list classed <paramref name="name"/>; nothing, for an empty list.</summary>
    private RenderFragment Listed(string name, string heading, ImmutableList<string> lines) =>
        @<text>
            @if (!lines.IsEmpty)
            {
                <h3>@heading</h3>
                <ul class="@name">
                    @foreach (string line in lines)
                    {
                        <li>@this.Named(line)</li>
                    }
                </ul>
            }
        </text>;
}
