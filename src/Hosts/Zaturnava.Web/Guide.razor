@* How to play: the game's ideas, aims and scoring, for a player rather than an engine (that is rules.md): the
   game's chosen in the lobby, or played at the table. Shown over the lobby or the table, until closed. *@

<div class="guide-backdrop">
    <section class="guide" role="dialog" aria-modal="true" aria-labelledby="guide-title">
        <header class="guide-head">
            <h2 id="guide-title">How to play</h2>
            <button class="close" @onclick="this.OnClose">Close</button>
        </header>

        @if (this.Game == GrandLegions)
        {
            <GrandLegionsGuide />
        }
        else
        {
            <ChaturajiGuide />
        }

        <h3>More</h3>
        <p class="more">
            Every rule in full: <a href="@DocsLinks.Rules" target="_blank" rel="noopener">the rules</a>. Playing
            with an AI of your own, or writing one:
            <a href="@DocsLinks.Bots" target="_blank" rel="noopener">bring your own AI</a>. What is kept about
            you, and how to have it deleted: <a href="@DocsLinks.Privacy" target="_blank" rel="noopener">privacy</a>.
        </p>
    </section>
</div>

@code {
    /// <summary>Grand Legions' id, as the catalog gives it: its guide is its own; any other game's, Chaturaji 2027's.</summary>
    private const string GrandLegions = "grand-legions";

    /// <summary>The game chosen in the lobby, or played at the table: the guide is to it.</summary>
    [Parameter]
    public string? Game { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnClose { get; set; }
}
