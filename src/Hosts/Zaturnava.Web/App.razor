@* The whole page: the lobby until the player sits at (or watches) a table, over a quiet bar of the
   page's name, a button opening the guide to the game, and the page's own settings (how it looks: theme
   and pieces; then sound); at a table, the table shows the guide's button and the settings in its own
   bar. No URL routing, so the page works from any address it is served at. A seat the player takes is
   remembered in the browser, so that they can come back to it. *@
@inject Browser Browser

@if (this._seating is { } seating)
{
    <Table @key="seating.GameId"
           Seating="seating"
           IsSoundOn="this._isSoundOn"
           Pieces="this._pieces"
           PageSettings="this.Settings"
           HowToPlay="this.HowToPlay"
           OnLeave="this.Leave"
           OnSeated="this.Sit" />
}
else
{
    <Lobby OnSeated="this.Sit" />
    <footer class="bar">
        <span class="where">
            <span class="brand">Zaturnava</span>
            @this.HowToPlay
        </span>
        @this.Settings
    </footer>
}

@if (this._isGuideOpen)
{
    <Guide OnClose="this.CloseGuide" />
}

@code {
    private Seating? _seating;
    private string _theme = Browser.Dark;
    private bool _isSoundOn = true;
    private bool _isGuideOpen;
    private PieceSet _pieces;

    private RenderFragment HowToPlay =>
        @<button class="how-to-play" @onclick="this.OpenGuide">How to play</button>;

    private RenderFragment Settings =>
        @<span class="settings">
            <button class="theme" @onclick="this.SwitchTheme">@(this._theme == Browser.Dark ? "Light theme" : "Dark theme")</button>
            <button class="pieces" @onclick="this.SwitchPieces">
                @(this._pieces == PieceSet.Chess ? "Pieces: chess" : "Pieces: chaturaji")
            </button>
            <button class="sound" @onclick="this.SwitchSound">@(this._isSoundOn ? "Sound: on" : "Sound: off")</button>
        </span>;

    protected override async Task OnInitializedAsync()
    {
        this._theme = await this.Browser.Theme();
        this._isSoundOn = await this.Browser.IsSoundOn();
        this._pieces = await this.Browser.Pieces();
        await this.Browser.ShowTheme(this._theme);
    }

    private async Task Sit(Seating seating)
    {
        this._seating = seating;
        await (seating.Claim is { } claim ? this.Browser.Remember(seating.GameId, claim) : ValueTask.CompletedTask);
    }

    private void Leave() => this._seating = null;

    private void OpenGuide() => this._isGuideOpen = true;

    private void CloseGuide() => this._isGuideOpen = false;

    private async Task SwitchTheme()
    {
        this._theme = this._theme == Browser.Dark ? Browser.Light : Browser.Dark;
        await this.Browser.ShowTheme(this._theme);
    }

    private async Task SwitchPieces()
    {
        this._pieces = this._pieces == PieceSet.Chess ? PieceSet.Chaturaji : PieceSet.Chess;
        await this.Browser.SetPieces(this._pieces);
    }

    private async Task SwitchSound()
    {
        this._isSoundOn = !this._isSoundOn;
        await this.Browser.SetSound(this._isSoundOn);
    }
}
