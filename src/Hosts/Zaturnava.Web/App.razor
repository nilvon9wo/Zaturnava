@* The whole page: the lobby until the player sits at (or watches) a table, under signing in (at the top right, if
   the server offers it) and over a quiet bar of the page's name, buttons opening the guide to the game and the
   guide to the bots and the leaderboard, and the page's own settings (the safety, beside
   the table's view buttons; how it looks: theme, and pieces at a table whose pieces that changes; at a table, the
   piece cards on or off; then sound); at a
   table, the table shows the guide's button and the settings in its own bar. No URL routing, so the page works from any address it is served at. A seat the player takes is
   remembered in the browser, so that they can come back to it. A player signed in keeps the settings with the
   server too, and the page takes them up whenever they sign in. *@
@inject Browser Browser

@if (this._seating is { } seating)
{
    <Table @key="seating.GameId"
           Seating="seating"
           IsSoundOn="this._isSoundOn"
           IsSafetyOn="this._isSafetyOn"
           AreCardsShown="this._areCardsShown"
           Pieces="this._pieces"
           PageSettings="this.Settings"
           HowToPlay="this.HowToPlay"
           OnLeave="this.Leave"
           OnRuleset="this.AtRuleset"
           OnSeated="this.Sit" />
}
else
{
    <header class="account">
        <PlayerBar OnSignedInOrOut="this.Refresh" />
    </header>
    <Lobby @key="this._signIns" OnSeated="this.Sit" />
    <footer class="bar">
        <span class="where">
            <span class="brand">Zaturnava</span>
            <span class="build" title="Which build of the page this is">@BuildStamp.Current</span>
            @this.HowToPlay
        </span>
        @this.Settings(false)
    </footer>
}

@if (this._isGuideOpen)
{
    <Guide OnClose="this.CloseGuide" />
}

@if (this._isBotGuideOpen)
{
    <BotGuide OnClose="this.CloseBotGuide" />
}

@if (this._isLeaderboardOpen)
{
    <Leaderboard OnClose="this.CloseLeaderboard" RulesetId="@(this._seating is null ? null : this._rulesetId)" />
}

@code {
    private Seating? _seating;
    private string? _rulesetId;
    private string _theme = Browser.Dark;
    private bool _isSoundOn = true;
    private bool _isSafetyOn = true;
    private bool _areCardsShown = true;
    private bool _isGuideOpen;
    private bool _isBotGuideOpen;
    private bool _isLeaderboardOpen;
    private PieceSet _pieces;

    /// <summary>How many times a player has signed in or out here: the lobby is made anew each time.</summary>
    private int _signIns;

    private RenderFragment HowToPlay =>
        builder =>
        {
            builder.AddContent(0, this.HowToPlayButton);
            builder.AddContent(1, this.BotsButton);
            builder.AddContent(2, this.LeaderboardButton);
        };

    private RenderFragment HowToPlayButton =>
        @<button class="how-to-play" @onclick="this.OpenGuide">How to play</button>;

    private RenderFragment BotsButton =>
        @<button class="the-bots" @onclick="this.OpenBotGuide">The bots</button>;

    private RenderFragment LeaderboardButton =>
        @<button class="leaderboard-open" @onclick="this.OpenLeaderboard">Leaderboard</button>;

    /// <summary>The page's settings; the choice of pieces only where it changes them, at a table.</summary>
    private RenderFragment<bool> Settings =>
        hasPieceSets =>
            @<span class="settings">
                <button class="@(this._isSafetyOn ? "safety" : "safety off")"
                        title="While on, you cannot take your own team's pieces, as an enemy army you command could"
                        @onclick="this.SwitchSafety">
                    @(this._isSafetyOn ? "Safety: on" : "Safety: OFF")
                </button>
                <button class="theme" @onclick="this.SwitchTheme">@(this._theme == Browser.Dark ? "Theme: dark" : "Theme: light")</button>
                @if (hasPieceSets)
                {
                    <button class="pieces" @onclick="this.SwitchPieces">
                        @(this._pieces == PieceSet.Chess ? "Pieces: chess" : "Pieces: chaturaji")
                    </button>
                }
                @if (this._seating is not null)
                {
                    <button class="cards"
                            title="Whether clicking a piece opens a card telling how it moves"
                            @onclick="this.SwitchCards">
                        @(this._areCardsShown ? "Cards: on" : "Cards: off")
                    </button>
                }
                <button class="sound" @onclick="this.SwitchSound">@(this._isSoundOn ? "Sound: on" : "Sound: off")</button>
            </span>;

    protected override Task OnInitializedAsync() => this.LoadSettings();

    /// <summary>
    /// The page's settings as this browser keeps them, after taking up those the player signed in keeps, if one is.
    /// </summary>
    private async Task LoadSettings()
    {
        await this.Browser.Adopt();
        this._theme = await this.Browser.Theme();
        this._isSoundOn = await this.Browser.IsSoundOn();
        this._isSafetyOn = await this.Browser.IsSafetyOn();
        this._areCardsShown = await this.Browser.AreCardsShown();
        this._pieces = await this.Browser.Pieces();
        await this.Browser.ShowTheme(this._theme);
    }

    private async Task Sit(Seating seating)
    {
        this._seating = seating;
        await (seating.Claim is { } claim ? this.Browser.Remember(seating.GameId, claim) : ValueTask.CompletedTask);
    }

    private void Leave() => this._seating = null;

    /// <summary>The ruleset of the table the player is at, for the leaderboard to open at.</summary>
    private void AtRuleset(string rulesetId) => this._rulesetId = rulesetId;

    /// <summary>
    /// The lobby anew, for whoever is signed in now: the games waiting for them, the seats they may take back; and
    /// the settings they keep.
    /// </summary>
    private async Task Refresh()
    {
        this._signIns++;
        await this.LoadSettings();
    }

    private void OpenGuide() => this._isGuideOpen = true;

    private void CloseGuide() => this._isGuideOpen = false;

    private void OpenBotGuide() => this._isBotGuideOpen = true;

    private void CloseBotGuide() => this._isBotGuideOpen = false;

    private void OpenLeaderboard() => this._isLeaderboardOpen = true;

    private void CloseLeaderboard() => this._isLeaderboardOpen = false;

    private async Task SwitchTheme()
    {
        this._theme = this._theme == Browser.Dark ? Browser.Light : Browser.Dark;
        await this.Browser.SetTheme(this._theme);
    }

    private async Task SwitchPieces()
    {
        this._pieces = this._pieces == PieceSet.Chess ? PieceSet.Chaturaji : PieceSet.Chess;
        await this.Browser.SetPieces(this._pieces);
    }

    private async Task SwitchSafety()
    {
        this._isSafetyOn = !this._isSafetyOn;
        await this.Browser.SetSafety(this._isSafetyOn);
    }

    private async Task SwitchCards()
    {
        this._areCardsShown = !this._areCardsShown;
        await this.Browser.SetCards(this._areCardsShown);
    }

    private async Task SwitchSound()
    {
        this._isSoundOn = !this._isSoundOn;
        await this.Browser.SetSound(this._isSoundOn);
    }
}
