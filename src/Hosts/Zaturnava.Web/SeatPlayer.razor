@* Who holds a seat, as the table shows them. A player who claimed it signed in may be looked at: their name opens a
   dialog with their profile, as anyone may see it: their description, and the services they chose to show; and how
   they stand at the game, from its leaderboard: their Elo, experience, and games won, lost and drawn (the user's
   request of 2026-11-12), and their three winning streaks, each with the mean Elo it beat (Proposed). A bot may be looked at too: its name opens its profile, from the server's catalog - what it
   does, whether it asks an AI (and costs tokens each use), and its rating at this game. Figures are laid out as
   labelled fields, a table or a list of terms, never run into a sentence (Stated 2026-11-13). *@
@using System.Globalization
@inject IGameServing Games

@if (this.PlayerId is { } playerId)
{
    <button class="player profile" title="See their profile" @onclick="() => this.Open(playerId)">@this.Text</button>
}
else if (this.BotId is { } botId)
{
    <button class="player bot-profile" title="See the bot's profile" @onclick="() => this.OpenBot(botId)">
        @this.Text
    </button>
}
else
{
    <span class="player">@this.Text</span>
}
@if (this._isOpen)
{
    <div class="backdrop">
        <div class="dialog public-profile" role="dialog" aria-modal="true" aria-labelledby="public-profile-title">
            @if (this._profile is { } profile)
            {
                <h2 id="public-profile-title">@profile.Name</h2>
                @if (profile.Description.Length > 0)
                {
                    <p class="player-description">@profile.Description</p>
                }
                @if (!profile.Services.IsEmpty)
                {
                    <p class="player-services">Signs in with @string.Join(", ", profile.Services).</p>
                }
                @if (this._standing is { } standing)
                {
                    <table class="player-standing">
                        <caption>At this game</caption>
                        <thead>
                            <tr><th>Elo</th><th>Experience</th><th>Won</th><th>Lost</th><th>Drawn</th></tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>@standing.Elo</td>
                                <td>@standing.Experience</td>
                                <td>@standing.Won</td>
                                <td>@standing.Lost</td>
                                <td>@standing.Drawn</td>
                            </tr>
                        </tbody>
                    </table>
                    <table class="player-streaks">
                        <caption>Winning streaks at this game</caption>
                        <thead>
                            <tr><th>Of</th><th>Won in a row</th><th>Mean Elo beaten</th></tr>
                        </thead>
                        <tbody>
                            @foreach ((string of, StreakDto streak) in StreaksOf(standing))
                            {
                                <tr>
                                    <th scope="row">@of</th>
                                    <td>@streak.Wins</td>
                                    <td>@(streak.OpponentElo?.ToString(CultureInfo.InvariantCulture) ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="player-standing">Not yet on this game's leaderboard.</p>
                }
            }
            else if (this._bot is { } bot)
            {
                <h2 id="public-profile-title">@bot.Name</h2>
                <p class="bot-description">@bot.Description</p>
                <dl class="bot-facts">
                    <dt>Plays by</dt>
                    <dd class="bot-kind">@KindOf(bot)</dd>
                    <dt>Elo at this game</dt>
                    <dd class="bot-rating">@this.RatingOf(bot)</dd>
                </dl>
            }
            else
            {
                <h2 id="public-profile-title">@this.Text</h2>
                <p class="problem" role="alert">@(this._problem ?? this.Gone)</p>
            }
            <div class="actions">
                <button class="close-public-profile" @onclick="() => this._isOpen = false">Close</button>
            </div>
        </div>
    </div>
}

@code {
    public const string GonePlayer = "This player's profile is gone.";
    public const string GoneBot = "This bot is no longer offered.";

    /// <summary>What the table calls whoever holds the seat.</summary>
    [Parameter, EditorRequired]
    public string Text { get; set; } = string.Empty;

    /// <summary>The id of the player who claimed the seat signed in; null for anyone else.</summary>
    [Parameter]
    public string? PlayerId { get; set; }

    /// <summary>The id of the bot that plays the seat; null for anyone else.</summary>
    [Parameter]
    public string? BotId { get; set; }

    /// <summary>The game's ruleset, which a bot's rating is at.</summary>
    [Parameter]
    public string RulesetId { get; set; } = string.Empty;

    /// <summary>
    /// The game a player's standing is at, by its id (<see cref="RulesetDto.Game"/>); if unset, the game of
    /// <see cref="RulesetId"/>, as the catalog says.
    /// </summary>
    [Parameter]
    public string Game { get; set; } = string.Empty;

    /// <summary>
    /// The board, if the game's creator set its size: a bot's rating is then at the size nearest it, as best guess
    /// (<see cref="GameStarter.RatedAs"/>).
    /// </summary>
    [Parameter]
    public BoardSizeDto? Board { get; set; }

    private bool _isOpen;
    private ProfileDto? _profile;
    private StandingDto? _standing;
    private BotDto? _bot;
    private string _ratedAs = string.Empty;
    private string? _problem;

    private string Gone => this.BotId is null ? GonePlayer : GoneBot;

    private async Task Open(string playerId)
    {
        this._isOpen = true;
        this._profile = null;
        this._standing = null;
        this._problem = await Requests.Attempt(async () =>
        {
            this._profile = await this.Games.Profile(playerId, CancellationToken.None);
            string game = this.Game.Length > 0 ? this.Game : await this.GameOfRuleset();
            this._standing = game.Length > 0
                ? (await this.Games.Leaderboard(game, CancellationToken.None))
                    .FirstOrDefault(standing => standing.PlayerId == playerId)
                : null;
        });
    }

    /// <summary>The game <see cref="RulesetId"/> plays, by its id; none, if the catalog no longer offers it.</summary>
    private async Task<string> GameOfRuleset() =>
        (await this.Games.Catalog(CancellationToken.None)).Rulesets
            .FirstOrDefault(ruleset => ruleset.Id == this.RulesetId)?.Game ?? string.Empty;

    private async Task OpenBot(string botId)
    {
        this._isOpen = true;
        this._bot = null;
        this._problem = await Requests.Attempt(async () =>
        {
            CatalogDto catalog = await this.Games.Catalog(CancellationToken.None);
            this._ratedAs = GameStarter.RatedAs(catalog, this.RulesetId, this.Board);
            this._bot = catalog.Bots.FirstOrDefault(bot => bot.Id == botId);
        });
    }

    /// <summary>
    /// The player's three winning streaks, as the leaderboard counts them: over every game, over the games that count
    /// toward Elo, and over the games against people.
    /// </summary>
    private static (string Of, StreakDto Streak)[] StreaksOf(StandingDto standing) =>
    [
        ("Every game", standing.Streak),
        ("Rated games", standing.RatedStreak),
        ("Games against people", standing.PeopleStreak),
    ];

    /// <summary>"AI, paid per use", "AI", or "Plain algorithm".</summary>
    private static string KindOf(BotDto bot) =>
        (bot.UsesAi, bot.IsPaid) switch
        {
            (true, true) => "AI, paid per use",
            (true, false) => "AI",
            _ => "Plain algorithm",
        };

    /// <summary>Its rating at the game, from games between the bots; or "Not yet rated".</summary>
    private string RatingOf(BotDto bot) =>
        bot.Ratings.TryGetValue(this._ratedAs, out int rating)
            ? rating.ToString(CultureInfo.InvariantCulture)
            : "Not yet rated";
}
