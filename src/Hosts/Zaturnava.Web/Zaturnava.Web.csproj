<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!--
    The browser client, published as static files to any web host: a lobby and a table, drawing any
    board from the cell layouts the server sends. It reaches the server only through
    IGameServing (Zaturnava.Client) and decides what to show through Zaturnava.Presentation,
    so it knows no ruleset, board or piece set.
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Net.NowhereAtAll.Zaturnava.Web.Test" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Apis\Zaturnava.Client\Zaturnava.Client.csproj" />
    <ProjectReference Include="..\..\Apis\Zaturnava.Presentation\Zaturnava.Presentation.csproj" />
  </ItemGroup>

</Project>
