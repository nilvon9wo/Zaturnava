@* Who is playing, top right (Stated 2026-11-11), one of three things. To someone not yet known, one call to say who
   they are, opening a dialog that offers both ways: an alias for the visit, shown as "Alias (guest)", which the
   server holds for them alone (no other guest's at the time, and no player's username: "Ada 2", if Ada is taken),
   kept in the browser with the token it is held by, and renewed as the page opens; or signing in, with any service
   the server is set up for, each in a window of its own. To a guest, their alias, which opens the same dialog. To a
   player signed in, their username, with a down arrow: a menu of their profile (where they may change their
   username, which no one else may have, link other services to sign in with, or unlink any but the last, and have a
   token issued for an AI to play for them), signing out (the server lets the token go), and deleting the account,
   which asks first, here in the page, and once confirmed has the server forget the player altogether. The player's
   token is kept in the browser. *@
@using Microsoft.JSInterop
@implements IDisposable
@inject IGameServing Games
@inject Browser Browser
@inject ServerAddress Server
@inject NavigationManager Navigation

@if (this._signedIn is var (player, token))
{
    <span class="player">
        <button class="account-name"
                aria-haspopup="menu"
                aria-expanded="@(this._isMenuOpen ? "true" : "false")"
                title="Your account"
                @onclick="() => this._isMenuOpen = !this._isMenuOpen"><strong>@player.Name</strong> ▾</button>
        @if (this._isMenuOpen)
        {
            <span class="account-menu" role="menu" aria-label="Your account">
                <button class="open-profile" role="menuitem" @onclick="() => this.OpenProfile(token)">
                    Profile and sign-in services
                </button>
                <button class="sign-out" role="menuitem" @onclick="() => this.SignOut(token)">Sign out</button>
                <button class="delete-account" role="menuitem" @onclick="this.AskToDelete">Delete account</button>
            </span>
        }
    </span>
    @if (this._isConfirming)
    {
        <span class="confirm-deletion" role="alertdialog" aria-label="Delete your account?">
            Delete your account? Your name and how you sign in are erased for good; games you played stay, without
            your name. This cannot be undone.
            <button class="delete-confirmed" @onclick="() => this.Delete(token)">Delete it</button>
            <button class="delete-cancelled" @onclick="() => this._isConfirming = false">Keep it</button>
        </span>
    }
    @if (this._isEditing)
    {
        ImmutableList<string> services = player.Services ?? [];
        ImmutableList<string> others = [.. this._providers.Except(services)];
        <div class="backdrop">
            <div class="dialog profile-dialog" role="dialog" aria-modal="true" aria-labelledby="profile-title">
                <h2 id="profile-title">Your profile</h2>
                <p class="autosave">
                    Each change is saved as you make it: your username and description once you leave their field.
                </p>
                <label class="name">
                    Username
                    <input class="name"
                           maxlength="@RenameRequest.MaximumNameLength"
                           value="@player.Name"
                           @onchange="change => this.Rename(token, change)" />
                </label>
                <label class="description">
                    About you, for anyone who opens your profile
                    <textarea class="description"
                              rows="3"
                              maxlength="@DescribeRequest.MaximumDescriptionLength"
                              value="@player.Description"
                              @onchange="change => this.Describe(token, change, player.Shown)"></textarea>
                </label>
                <p>You sign in with (ticked: your profile shows anyone that you do):</p>
                <ul class="services">
                    @foreach (string service in services)
                    {
                        <li>
                            <label class="shown">
                                <input type="checkbox"
                                       class="shown"
                                       checked="@player.Shown.Contains(service)"
                                       @onchange="change => this.Show(token, player, service, change)" />
                                @service
                            </label>
                            @if (services.Count > 1)
                            {
                                <button class="unlink" @onclick="() => this.Unlink(token, service)">Unlink</button>
                            }
                        </li>
                    }
                </ul>
                <p>An AI may play for you with a token of its own, which may claim seats, but not change your profile;
                    a seat it claims is shown as played by an AI.</p>
                <div class="actions">
                    <button class="ai-token" @onclick="() => this.IssueAiToken(token)">New AI token</button>
                </div>
                @if (this._aiToken is { } aiToken)
                {
                    <p class="ai-token">Your AI's token, shown only this once: <code>@aiToken</code></p>
                }
                @if (!others.IsEmpty && this._linkCode is { } code)
                {
                    <p>Link another, to sign in as yourself with it too:</p>
                    <div class="actions">
                        @foreach (string provider in others)
                        {
                            <button class="link" @onclick="() => this.Link(token, provider, code)">Link @provider</button>
                        }
                    </div>
                }
                @if (this._saved is { } saved)
                {
                    <p class="saved" role="status">@saved</p>
                }
                <div class="actions">
                    <button class="close-profile" @onclick="this.CloseProfile">Close</button>
                </div>
            </div>
        </div>
    }
}
else
{
    <span class="player">
        @if (this._nickname is { Length: > 0 } nickname)
        {
            <button class="open-sign-in guest-name"
                    aria-haspopup="dialog"
                    title="Change your name for this visit, or sign in"
                    @onclick="() => this._isChoosing = true"><strong>@nickname</strong> (guest) ▾</button>
        }
        else
        {
            <button class="open-sign-in" aria-haspopup="dialog" @onclick="() => this._isChoosing = true">
                Sign in, or choose a name
            </button>
        }
    </span>
    @if (this._isChoosing)
    {
        <div class="backdrop">
            <div class="dialog sign-in-dialog" role="dialog" aria-modal="true" aria-labelledby="sign-in-title">
                <h2 id="sign-in-title">Who are you?</h2>
                <p>Play as a guest, by a name for this visit, shown to the others as "Name (guest)": no one else's, so
                    if it is taken, the next free one ("Ada 2"). A guest may play, and read what is said at the
                    table.</p>
                <label class="nickname">
                    Name for this visit
                    <input class="nickname"
                           maxlength="@ClaimSeatRequest.MaximumNicknameLength"
                           placeholder="none: just guest"
                           value="@this._nickname"
                           @onchange="this.SetNickname" />
                </label>
                @if (this._aliasNote is { } note)
                {
                    <p class="alias-note" role="status">@note</p>
                }
                <div class="actions">
                    <button class="as-guest" @onclick="() => this._isChoosing = false">Play as a guest</button>
                </div>
                @if (!this._providers.IsEmpty)
                {
                    <p>Or sign in, to be known by your name, and to speak at the table:</p>
                    <div class="actions">
                        @foreach (string provider in this._providers)
                        {
                            <button class="sign-in" @onclick="() => this.SignIn(provider)">Sign in with @provider</button>
                        }
                    </div>
                }
                <div class="actions">
                    <button class="cancel" @onclick="() => this._isChoosing = false">Cancel</button>
                </div>
            </div>
        </div>
    }
}
@if (this._notice is { } notice)
{
    <span class="notice" role="status">@notice</span>
}

@code {
    public const string Deleted = "Your account is deleted.";

    /// <summary>Told once a player has signed in, or out: what the page shows for them may change.</summary>
    [Parameter]
    public EventCallback OnSignedInOrOut { get; set; }

    private ImmutableList<string> _providers = [];
    private string? _nickname;

    /// <summary>The player signed in, and their token; none, if no one is.</summary>
    private (PlayerDto Player, string Token)? _signedIn;
    private bool _isConfirming;
    private bool _isChoosing;
    private bool _isEditing;
    private bool _isMenuOpen;

    /// <summary>Why the guest's alias is not the name they asked for (it was taken), until they choose another.</summary>
    private string? _aliasNote;

    /// <summary>
    /// A code to link another service with, asked for as the profile opens, so that a window can be opened the moment
    /// the player chooses one (a browser lets a page open one only then); spent once used.
    /// </summary>
    private string? _linkCode;

    /// <summary>The token last issued for an AI, shown once, until the profile closes.</summary>
    private string? _aiToken;

    /// <summary>What the profile last saved, told until the profile closes.</summary>
    private string? _saved;
    private string? _notice;
    private DotNetObjectReference<PlayerBar>? _listener;

    protected override async Task OnInitializedAsync()
    {
        this._nickname = await this.Browser.Nickname();
        _ = await Requests.Attempt(this.Load);
        _ = this._signedIn is null && this._nickname is { } nickname
            ? await Requests.Attempt(() => this.KeepAlias(nickname))
            : null;
    }

    /// <summary>
    /// Renews the alias this browser holds for its guest; or, if it holds none now (it lapsed, or it was kept before
    /// aliases were held), takes <paramref name="nickname"/> afresh, or the next free name like it.
    /// </summary>
    private async Task KeepAlias(string nickname)
    {
        GuestAliasDto? held = await this.Browser.AliasToken() is { } token
            ? await this.Games.MyAlias(token, CancellationToken.None)
            : null;
        await this.Hold(held ?? await this.Games.TakeAlias(nickname, null, CancellationToken.None));
    }

    /// <summary>Plays by the alias held from now on, keeping it and the token it is held by in the browser.</summary>
    private async Task Hold(GuestAliasDto held)
    {
        await this.Browser.RememberAlias(held.Token);
        await this.Browser.SetNickname(held.Alias);
        this._nickname = held.Alias;
    }

    /// <summary>The token the sign-in window posted back: remembered, and the player it stands for shown.</summary>
    [JSInvokable]
    public async Task SignedIn(string token)
    {
        await this.Browser.RememberPlayer(token);
        this._notice = null;
        this._isChoosing = false;
        _ = await Requests.Attempt(async () => await this.Show(token));
        if (this._isEditing)
        {
            this._saved = "Linked.";
            await this.AskLinkCode(token);
        }

        this.StateHasChanged();
        await this.OnSignedInOrOut.InvokeAsync();
    }

    public void Dispose() => this._listener?.Dispose();

    private async Task Load()
    {
        this._providers = await this.Games.SignInProviders(CancellationToken.None);
        if (await this.Browser.PlayerToken() is { } token)
        {
            await this.Show(token);
            await (this._signedIn is null ? this.Browser.ForgetPlayer() : ValueTask.CompletedTask);
        }
    }

    private async Task Show(string token) =>
        this._signedIn = await this.Games.Me(token, CancellationToken.None) is { } player ? (player, token) : null;

    /// <summary>
    /// Opens the window to sign in with <paramref name="provider"/>, to post back to this page; with a
    /// <paramref name="link"/> code, to link it to the player signed in.
    /// </summary>
    private async Task SignIn(string provider, string? link = null)
    {
        this._listener ??= DotNetObjectReference.Create(this);
        string origin = new Uri(this.Navigation.BaseUri).GetLeftPart(UriPartial.Authority);
        Uri url = new(this.Server.Value, GameRoutes.SignIn(provider, origin, link));
        await this.Browser.SignIn(url, this._listener);
    }

    private async Task OpenProfile(string token)
    {
        this._isMenuOpen = false;
        this._isEditing = true;
        await this.AskLinkCode(token);
    }

    private void AskToDelete()
    {
        this._isMenuOpen = false;
        this._isConfirming = true;
    }

    private async Task AskLinkCode(string token) =>
        this._notice = await Requests.Attempt(async () =>
            this._linkCode = await this.Games.LinkCode(token, CancellationToken.None)
        );

    /// <summary>
    /// Links <paramref name="provider"/>, in a window of its own, with the code, which is then spent; and asks another
    /// at once, so that the player may try again, or link another, whether or not that window links it.
    /// </summary>
    private async Task Link(string token, string provider, string code)
    {
        this._linkCode = null;
        await this.SignIn(provider, code);
        await this.AskLinkCode(token);
    }

    /// <summary>Names the player anew, as the name's field is left; told why not, if the server cannot.</summary>
    private async Task Rename(string token, ChangeEventArgs change) =>
        this._notice = await Requests.Attempt(async () =>
            await this.Showing(
                token,
                this.Games.Rename(token, $"{change.Value}", CancellationToken.None),
                "Username saved."
            )
        );

    /// <summary>Has the server keep what the player's profile shows anyone; told why not, if it cannot.</summary>
    private async Task Describe(string token, string description, ImmutableList<string> shown) =>
        this._notice = await Requests.Attempt(async () =>
            await this.Showing(
                token,
                this.Games.Describe(token, new DescribeRequest(description, shown), CancellationToken.None),
                "Profile saved."
            )
        );

    /// <summary>Has the server keep the description, as its field is left, and the services shown.</summary>
    private Task Describe(string token, ChangeEventArgs change, ImmutableList<string> shown) =>
        this.Describe(token, $"{change.Value}", shown);

    /// <summary>Shows <paramref name="service"/> on the player's profile, ticked, or no longer, unticked.</summary>
    private Task Show(string token, PlayerDto player, string service, ChangeEventArgs change)
    {
        ImmutableList<string> others = player.Shown.Remove(service);
        return this.Describe(token, player.Description, Equals(change.Value, true) ? others.Add(service) : others);
    }

    private async Task Unlink(string token, string provider) =>
        this._notice = await Requests.Attempt(async () =>
            await this.Showing(
                token,
                this.Games.Unlink(token, provider, CancellationToken.None),
                $"{provider} unlinked."
            )
        );

    /// <summary>A new token for an AI to play for the player, shown until the profile closes.</summary>
    private async Task IssueAiToken(string token) =>
        this._notice = await Requests.Attempt(async () =>
            this._aiToken = await this.Games.AiToken(token, CancellationToken.None)
        );

    private void CloseProfile()
    {
        this._isEditing = false;
        this._aiToken = null;
        this._saved = null;
    }

    /// <summary>
    /// Shows the player the server answered with, telling what was <paramref name="saved"/>; or, if the token stood
    /// for no one, no one.
    /// </summary>
    private async Task Showing(string token, Task<PlayerDto?> answer, string saved)
    {
        this._signedIn = await answer is { } player ? (player, token) : null;
        this._saved = saved;
    }

    /// <summary>Has the server let the token go, and forgets it here, even if the server cannot be reached.</summary>
    private async Task SignOut(string token)
    {
        _ = await Requests.Attempt(() => this.Games.SignOut(token, CancellationToken.None));
        await this.Forget();
    }

    /// <summary>Has the server forget the player; told why not, if it cannot.</summary>
    private async Task Delete(string token)
    {
        this._notice = await Requests.Attempt(async () => _ = await this.Games.DeleteMe(token, CancellationToken.None));
        if (this._notice is null)
        {
            await this.Forget();
            this._notice = Deleted;
        }
    }

    /// <summary>
    /// Has the server hold the name the guest chose as their alias, letting go the one they held, and plays by it at
    /// every table from now on, told so if it was taken and they are given the next free one; told why not, if the
    /// server cannot. An empty name clears it: they play as just "guest".
    /// </summary>
    private async Task SetNickname(ChangeEventArgs change)
    {
        string wanted = $"{change.Value}".Trim();
        this._aliasNote = null;
        if (wanted.Length == 0)
        {
            await this.Browser.SetNickname(string.Empty);
            await this.Browser.RememberAlias(string.Empty);
            this._nickname = null;
            return;
        }

        this._notice = await Requests.Attempt(async () =>
        {
            GuestAliasDto held =
                await this.Games.TakeAlias(wanted, await this.Browser.AliasToken(), CancellationToken.None);
            await this.Hold(held);
            this._aliasNote = string.Equals(held.Alias, wanted, StringComparison.Ordinal)
                ? null
                : $"{wanted} is taken, so you are {held.Alias}.";
        });
    }

    private async Task Forget()
    {
        await this.Browser.ForgetPlayer();
        this._signedIn = null;
        this._isConfirming = false;
        this._isEditing = false;
        this._isMenuOpen = false;
        await this.OnSignedInOrOut.InvokeAsync();
    }
}
