@* Who stands highest at each game, one board at a time, as a panel of the lobby: the players signed in, by their Elo
   rating at it, with their experience, their points and how many of its games they won, lost, drew and abandoned;
   the server's bots, by their rating, with their points and how they did, all told and against people alone; or
   everyone, players and bots together, each marked as a person or a bot. Each board sorts by any of its columns,
   its header clicked (again, the other way), and shows ten at a time, page by page. Of the game the lobby has chosen,
   at every size. Each name opens the player's, or the bot's, profile. *@
@inject IGameServing Games

<div class="panel leaderboard">
    <h2>Leaderboard</h2>

    @if (this._problem is { } problem)
    {
        <p class="problem" role="alert">@problem</p>
    }

    <label class="choice">
        <span class="choice-name">Board</span>
        <select class="leaderboard-board" value="@this._board" @onchange="this.ChooseBoard">
            <option value="@PlayersBoard">Players</option>
            <option value="@BotsBoard">Bots</option>
            <option value="@EveryoneBoard">Everyone</option>
        </select>
    </label>

    @if (this._rows is { } rows)
    {
        @if (rows.IsEmpty)
        {
            <p class="no-leaders">@this.Columns.Empty</p>
        }
        else
        {
            ImmutableList<Row> sorted = this.Sorted(rows);
            int pages = ((sorted.Count - 1) / PageSize) + 1;
            <table class="leaders @this.Columns.Class">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>@this.Columns.Who</th>
                        @foreach (Column column in this.Columns.All)
                        {
                            <th title="@column.Title" aria-sort="@this.SortOf(column)">
                                <button class="sort @column.Key" @onclick="() => this.SortBy(column)">
                                    @column.Header@this.ArrowOf(column)
                                </button>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach ((Row row, int index) in sorted.Select((row, index) => (row, index))
                        .Skip(this._page * PageSize)
                        .Take(PageSize))
                    {
                        <tr>
                            <td class="place">@(index + 1)</td>
                            <td class="name">
                                @if (this._board == EveryoneBoard)
                                {
                                    <span class="kind"
                                          role="img"
                                          aria-label="@KindOf(row)"
                                          title="@KindOf(row)">@(row.BotId is null ? "🧑" : "🤖")</span>
                                }
                                <SeatPlayer Text="@row.Name"
                                            PlayerId="@row.PlayerId"
                                            BotId="@row.BotId"
                                            RulesetId="@string.Empty" />
                            </td>
                            @foreach ((Column column, int value) in this.Columns.All.Zip(row.Values))
                            {
                                <td class="@column.Key">@value</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
            @if (pages > 1)
            {
                <nav class="pager" aria-label="Pages">
                    <button class="previous" disabled="@(this._page == 0)" @onclick="() => this._page--">
                        Previous
                    </button>
                    <span class="page">Page @(this._page + 1) of @pages</span>
                    <button class="next" disabled="@(this._page == pages - 1)" @onclick="() => this._page++">
                        Next
                    </button>
                </nav>
            }
        }
    }

    <p class="about-standings">@this.Columns.About</p>
</div>

@code {
    /// <summary>How many rows a page shows (Stated).</summary>
    private const int PageSize = 10;

    private const string PlayersBoard = "players";
    private const string BotsBoard = "bots";
    private const string EveryoneBoard = "everyone";

    private const string PointsTitle = "The points scored at the board, in every game finished, won or lost";

    private static readonly Board Players = new(
        string.Empty,
        "Player",
        "No one signed in has finished a game of it yet.",
        "Each game finished counts for the players signed in at it, but not for a seat their own AI played. Everyone "
            + "starts at Elo 1500, and gains or loses by how their team did against what the teams' ratings led to "
            + "expect, a bot's team by the bot's own rating. Each win earns as experience your own points, and as "
            + "much again times your share of your team's: carrying a weak ally earns more than being carried by a "
            + "strong one. Points are the points you scored yourself, taking pieces and earning bonuses, in every game "
            + "finished, won or lost. A game not over, with no guest at it, counts as abandoned by a player once it has "
            + "waited a day for their move, and no longer once they make it.",
        [
            new("elo", "Elo", null),
            new("experience", "Experience", "In each game won, your own points, and as much again times your share of your team's"),
            new("points", "Points", PointsTitle),
            new("won", "Won", null),
            new("lost", "Lost", null),
            new("drawn", "Drawn", null),
            new("abandoned", "Abandoned", "Games not over that have waited a day or more for their move"),
        ]
    );

    private static readonly Board Bots = new(
        "bot-leaders",
        "Bot",
        "No bot has finished a game of it yet.",
        "Every game finished counts for the bots at it, a bot at several seats once for each. A bot's Elo is its rating "
            + "from games against the other bots, averaged over the game's sizes. Points are the points it scored "
            + "itself, in every game finished, won or lost. Against people counts the games in which every seat not on "
            + "the bot's team was played by a person, signed in or a guest, rather than a bot or an AI.",
        [
            new("elo", "Elo", "Its rating from games against the other bots, averaged over the game's sizes"),
            new("points", "Points", PointsTitle),
            new("won", "Won", null),
            new("lost", "Lost", null),
            new("drawn", "Drawn", null),
            new("won-against", "Won against people", null),
            new("lost-against", "Lost against people", null),
            new("drawn-against", "Drawn against people", null),
        ]
    );

    private static readonly Board Everyone = new(
        "everyone",
        "Player or bot",
        "No one has finished a game of it yet.",
        "Players signed in and the server's bots together, 🧑 a person, 🤖 a bot. A player's Elo comes from the games "
            + "they finished; a bot's, from its games against the other bots. Points are the points each scored "
            + "itself, in every game finished, won or lost.",
        [
            new("elo", "Elo", null),
            new("points", "Points", PointsTitle),
            new("won", "Won", null),
            new("lost", "Lost", null),
            new("drawn", "Drawn", null),
        ]
    );

    private string? _game;
    private string _board = PlayersBoard;
    private ImmutableList<Row>? _rows;

    /// <summary>The column the board is sorted by: the first, most first, until another is chosen.</summary>
    private int _sort;
    private bool _isAscending;
    private int _page;
    private string? _problem;

    /// <summary>The game whose leaderboard it is, by its id (<see cref="RulesetDto.Game"/>), as the lobby chose it.</summary>
    [Parameter, EditorRequired]
    public string Game { get; set; } = string.Empty;

    private Board Columns =>
        this._board switch
        {
            BotsBoard => Bots,
            EveryoneBoard => Everyone,
            _ => Players,
        };

    /// <summary>The leaderboard of the game, once it is another; told why not, if the server cannot give it.</summary>
    protected override async Task OnParametersSetAsync() =>
        this._problem = this.Game == this._game ? this._problem : await Requests.Attempt(() => this.Show(this.Game));

    /// <summary>The board chosen, of the same game, by its first column; told why not, if the server cannot give it.</summary>
    private async Task ChooseBoard(ChangeEventArgs change)
    {
        this._board = $"{change.Value}";
        this._sort = 0;
        this._isAscending = false;
        this._problem = await Requests.Attempt(() => this.Show(this.Game));
    }

    /// <summary>Sorted by the column, most first; by the same column again, the other way; from the first page.</summary>
    private void SortBy(Column column)
    {
        int chosen = this.Columns.All.IndexOf(column);
        this._isAscending = chosen == this._sort && !this._isAscending;
        this._sort = chosen;
        this._page = 0;
    }

    /// <summary>The rows by the column chosen; rows alike, in the order the server ranked them.</summary>
    private ImmutableList<Row> Sorted(ImmutableList<Row> rows) =>
        this._isAscending
            ? [.. rows.OrderBy(row => row.Values[this._sort])]
            : [.. rows.OrderByDescending(row => row.Values[this._sort])];

    private string SortOf(Column column) =>
        this.Columns.All.IndexOf(column) != this._sort ? "none" : this._isAscending ? "ascending" : "descending";

    private string ArrowOf(Column column) =>
        this.Columns.All.IndexOf(column) != this._sort ? string.Empty : this._isAscending ? " ▲" : " ▼";

    private static string KindOf(Row row) => row.BotId is null ? "Person" : "Bot";

    private async Task Show(string game)
    {
        this._game = game;
        this._rows = null;
        this._page = 0;
        this._rows = this._board switch
        {
            BotsBoard =>
            [
                .. (await this.Games.BotLeaderboard(game, CancellationToken.None)).Select(bot =>
                    new Row(
                        bot.Name,
                        [
                            bot.Elo,
                            bot.Points,
                            bot.Won,
                            bot.Lost,
                            bot.Drawn,
                            bot.WonAgainstPeople,
                            bot.LostAgainstPeople,
                            bot.DrawnAgainstPeople,
                        ]
                    )
                    {
                        BotId = bot.BotId,
                    }
                ),
            ],
            EveryoneBoard =>
            [
                .. (await this.Games.Leaderboard(game, CancellationToken.None)).Select(player =>
                    new Row(player.Name, [player.Elo, player.Points, player.Won, player.Lost, player.Drawn])
                    {
                        PlayerId = player.PlayerId,
                    }
                ),
                .. (await this.Games.BotLeaderboard(game, CancellationToken.None)).Select(bot =>
                    new Row(bot.Name, [bot.Elo, bot.Points, bot.Won, bot.Lost, bot.Drawn])
                    {
                        BotId = bot.BotId,
                    }
                ),
            ],
            _ =>
            [
                .. (await this.Games.Leaderboard(game, CancellationToken.None)).Select(player =>
                    new Row(
                        player.Name,
                        [
                            player.Elo,
                            player.Experience,
                            player.Points,
                            player.Won,
                            player.Lost,
                            player.Drawn,
                            player.Abandoned,
                        ]
                    )
                    {
                        PlayerId = player.PlayerId,
                    }
                ),
            ],
        };
    }

    /// <summary>A column a board may be sorted by: its class, header and what it means, if the header says too little.</summary>
    private sealed record Column(string Key, string Header, string? Title);

    /// <summary>
    /// A board: its table's class; what its rows are (Player, Bot); what to say when it has none; what it counts; and its
    /// columns, each a number.
    /// </summary>
    private sealed record Board(string Class, string Who, string Empty, string About, ImmutableList<Column> All);

    /// <summary>
    /// A row of a board: whose, with the player's or bot's id, to see their profile by (a bot's, if it has one, else a
    /// player's); and its numbers, one for each column.
    /// </summary>
    private sealed record Row(string Name, ImmutableList<int> Values)
    {
        public string? PlayerId { get; init; }

        public string? BotId { get; init; }
    }
}
