@* Who stands highest at each game, one board at a time: the players signed in, by their Elo rating at it, with their
   experience and how many of its games they won, lost, drew and abandoned; the server's bots, by games won, with how
   they did against people alone; or the players who have done best against bots alone. Each board sorts by any of
   its columns, its header clicked (again, the other way), and shows ten at a time, page by page. One game at a time,
   chosen among those the server offers: to begin with, at a table, the table's game; else the game the player last
   started; else the first. Each name opens the player's, or the bot's, profile. Shown over the lobby or the table,
   from the page's bar, until closed. *@
@inject IGameServing Games
@inject Browser Browser

<div class="guide-backdrop">
    <section class="guide leaderboard" role="dialog" aria-modal="true" aria-labelledby="leaderboard-title">
        <header class="guide-head">
            <h2 id="leaderboard-title">Leaderboard</h2>
            <button class="close" @onclick="this.OnClose">Close</button>
        </header>

        @if (this._problem is { } problem)
        {
            <p class="problem" role="alert">@problem</p>
        }

        <label class="choice">
            <span class="choice-name">Board</span>
            <select class="leaderboard-board" value="@this._board" @onchange="this.ChooseBoard">
                <option value="@PlayersBoard">Players</option>
                <option value="@BotsBoard">Bots</option>
                <option value="@AgainstBotsBoard">People against bots</option>
            </select>
        </label>

        @if (this._games.Count > 1)
        {
            <label class="choice">
                <span class="choice-name">Game</span>
                <select class="leaderboard-game" value="@this._game" @onchange="this.Choose">
                    @foreach (RulesetDto game in this._games)
                    {
                        <option value="@game.Game">@game.GameName</option>
                    }
                </select>
            </label>
        }

        @if (this._rows is { } rows)
        {
            @if (rows.IsEmpty)
            {
                <p class="no-leaders">@this.Columns.Empty</p>
            }
            else
            {
                ImmutableList<Row> sorted = this.Sorted(rows);
                int pages = ((sorted.Count - 1) / PageSize) + 1;
                <table class="leaders @this.Columns.Class">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@this.Columns.Who</th>
                            @foreach (Column column in this.Columns.All)
                            {
                                <th title="@column.Title" aria-sort="@this.SortOf(column)">
                                    <button class="sort @column.Key" @onclick="() => this.SortBy(column)">
                                        @column.Header@this.ArrowOf(column)
                                    </button>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach ((Row row, int index) in sorted.Select((row, index) => (row, index))
                            .Skip(this._page * PageSize)
                            .Take(PageSize))
                        {
                            <tr>
                                <td class="place">@(index + 1)</td>
                                <td class="name">
                                    <SeatPlayer Text="@row.Name"
                                                PlayerId="@row.PlayerId"
                                                BotId="@row.BotId"
                                                RulesetId="@(this.RulesetId ?? string.Empty)" />
                                </td>
                                @foreach ((Column column, int value) in this.Columns.All.Zip(row.Values))
                                {
                                    <td class="@column.Key">@value</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
                @if (pages > 1)
                {
                    <nav class="pager" aria-label="Pages">
                        <button class="previous" disabled="@(this._page == 0)" @onclick="() => this._page--">
                            Previous
                        </button>
                        <span class="page">Page @(this._page + 1) of @pages</span>
                        <button class="next" disabled="@(this._page == pages - 1)" @onclick="() => this._page++">
                            Next
                        </button>
                    </nav>
                }
            }
        }

        <p class="about-standings">@this.Columns.About</p>
    </section>
</div>

@code {
    /// <summary>How many rows a page shows (Stated).</summary>
    private const int PageSize = 10;

    private const string PlayersBoard = "players";
    private const string BotsBoard = "bots";
    private const string AgainstBotsBoard = "against-bots";

    private static readonly Board Players = new(
        string.Empty,
        "Player",
        "No one signed in has finished a game of it yet.",
        "Each game finished counts for the players signed in at it, but not for a seat their own AI played. Everyone "
            + "starts at Elo 1500, and gains or loses by how their team did against what the teams' ratings led to "
            + "expect, a bot's team by the bot's own rating. Each win earns as experience your own points plus your "
            + "team's. A game not over, with no guest at it, counts as abandoned by a player once it has waited a day "
            + "for their move, and no longer once they make it.",
        [
            new("elo", "Elo", null),
            new("experience", "Experience", "Your own points plus your team's, in each game won"),
            new("won", "Won", null),
            new("lost", "Lost", null),
            new("drawn", "Drawn", null),
            new("abandoned", "Abandoned", "Games not over that have waited a day or more for their move"),
        ]
    );

    private static readonly Board Bots = new(
        "bot-leaders",
        "Bot",
        "No bot has finished a game of it yet.",
        "Every game finished counts for the bots at it, a bot at several seats once for each. Against people counts "
            + "the games in which every seat not on the bot's team was played by a person, signed in or a guest, "
            + "rather than a bot or an AI.",
        [
            new("won", "Won", null),
            new("lost", "Lost", null),
            new("drawn", "Drawn", null),
            new("won-against", "Won against people", null),
            new("lost-against", "Lost against people", null),
            new("drawn-against", "Drawn against people", null),
        ]
    );

    private static readonly Board AgainstBots = new(
        "against-bots",
        "Player",
        "No one signed in has finished a game of it against bots alone yet.",
        "A game counts here when every seat not on the player's team was a bot's. A seat their own AI played does "
            + "not count.",
        [new("won", "Won", null), new("lost", "Lost", null), new("drawn", "Drawn", null)]
    );

    private ImmutableList<RulesetDto> _games = [];
    private string _game = string.Empty;
    private string _board = PlayersBoard;
    private ImmutableList<Row>? _rows;

    /// <summary>The column the board is sorted by: the first, most first, until another is chosen.</summary>
    private int _sort;
    private bool _isAscending;
    private int _page;
    private string? _problem;

    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>The ruleset of the table the leaderboard is opened over, if any.</summary>
    [Parameter]
    public string? RulesetId { get; set; }

    private Board Columns =>
        this._board switch
        {
            BotsBoard => Bots,
            AgainstBotsBoard => AgainstBots,
            _ => Players,
        };

    protected override async Task OnInitializedAsync() => this._problem = await Requests.Attempt(this.Load);

    private async Task Load()
    {
        CatalogDto catalog = await this.Games.Catalog(CancellationToken.None);
        this._games = [.. catalog.Rulesets.DistinctBy(ruleset => ruleset.Game, StringComparer.Ordinal)];
        string? preferred = catalog.Rulesets.Find(ruleset => ruleset.Id == this.RulesetId)?.Game
            ?? await this.Browser.LastGame();
        await this.Show((this._games.Find(game => game.Game == preferred) ?? this._games[0]).Game);
    }

    /// <summary>The leaderboard of the game chosen; told why not, if the server cannot give it.</summary>
    private async Task Choose(ChangeEventArgs change) =>
        this._problem = await Requests.Attempt(() => this.Show($"{change.Value}"));

    /// <summary>The board chosen, of the same game, by its first column; told why not, if the server cannot give it.</summary>
    private async Task ChooseBoard(ChangeEventArgs change)
    {
        this._board = $"{change.Value}";
        this._sort = 0;
        this._isAscending = false;
        this._problem = await Requests.Attempt(() => this.Show(this._game));
    }

    /// <summary>Sorted by the column, most first; by the same column again, the other way; from the first page.</summary>
    private void SortBy(Column column)
    {
        int chosen = this.Columns.All.IndexOf(column);
        this._isAscending = chosen == this._sort && !this._isAscending;
        this._sort = chosen;
        this._page = 0;
    }

    /// <summary>The rows by the column chosen; rows alike, in the order the server ranked them.</summary>
    private ImmutableList<Row> Sorted(ImmutableList<Row> rows) =>
        this._isAscending
            ? [.. rows.OrderBy(row => row.Values[this._sort])]
            : [.. rows.OrderByDescending(row => row.Values[this._sort])];

    private string SortOf(Column column) =>
        this.Columns.All.IndexOf(column) != this._sort ? "none" : this._isAscending ? "ascending" : "descending";

    private string ArrowOf(Column column) =>
        this.Columns.All.IndexOf(column) != this._sort ? string.Empty : this._isAscending ? " ▲" : " ▼";

    private async Task Show(string game)
    {
        this._game = game;
        this._rows = null;
        this._page = 0;
        this._rows = this._board switch
        {
            BotsBoard =>
            [
                .. (await this.Games.BotLeaderboard(game, CancellationToken.None)).Select(bot =>
                    new Row(
                        bot.Name,
                        [
                            bot.Won,
                            bot.Lost,
                            bot.Drawn,
                            bot.WonAgainstPeople,
                            bot.LostAgainstPeople,
                            bot.DrawnAgainstPeople,
                        ]
                    )
                    {
                        BotId = bot.BotId,
                    }
                ),
            ],
            AgainstBotsBoard =>
            [
                .. (await this.Games.AgainstBotsLeaderboard(game, CancellationToken.None)).Select(player =>
                    new Row(player.Name, [player.WonAgainstBots, player.LostAgainstBots, player.DrawnAgainstBots])
                    {
                        PlayerId = player.PlayerId,
                    }
                ),
            ],
            _ =>
            [
                .. (await this.Games.Leaderboard(game, CancellationToken.None)).Select(player =>
                    new Row(
                        player.Name,
                        [player.Elo, player.Experience, player.Won, player.Lost, player.Drawn, player.Abandoned]
                    )
                    {
                        PlayerId = player.PlayerId,
                    }
                ),
            ],
        };
    }

    /// <summary>A column a board may be sorted by: its class, header and what it means, if the header says too little.</summary>
    private sealed record Column(string Key, string Header, string? Title);

    /// <summary>
    /// A board: its table's class; what its rows are (Player, Bot); what to say when it has none; what it counts; and its
    /// columns, each a number.
    /// </summary>
    private sealed record Board(string Class, string Who, string Empty, string About, ImmutableList<Column> All);

    /// <summary>
    /// A row of a board: whose, with the player's or bot's id, to see their profile by; and its numbers, one for each
    /// column.
    /// </summary>
    private sealed record Row(string Name, ImmutableList<int> Values)
    {
        public string? PlayerId { get; init; }

        public string? BotId { get; init; }
    }
}
