@* Who stands highest at each game, one board at a time, as a panel of the lobby: the players signed in, by their Elo
   rating at it, with their experience, their points, how many of its games they won, lost, drew and abandoned, and
   their winning streaks, of every game, of rated games and of games against people, each with the mean Elo beaten;
   the server's bots, by their rating, with their points and how they did, all told and against people alone; or
   everyone, players and bots together, each marked as a person or a bot. Each board sorts by any of its columns,
   its header clicked (again, the other way), and shows ten at a time, page by page. Of the game the lobby has chosen,
   at every size. Each name opens the player's, or the bot's, profile. Everyone's board says whether each is a person
   or a bot in a column of its own (Stated, 2026-11-19: not in the name's). The board chosen, and how it is sorted, are
   remembered (Stated, the same day). *@
@inject IGameServing Games
@inject Browser Browser
@inject LobbyMemory Memory

<div class="panel leaderboard">
    <h2>Leaderboard</h2>

    @if (this._problem is { } problem)
    {
        <p class="problem" role="alert">@problem</p>
    }

    <div class="leaderboard-choices">
        <label class="choice">
            <span class="choice-name">Board</span>
            <select class="leaderboard-board" value="@this._board" @onchange="this.ChooseBoard">
                @* People, not players: a bot plays too (the user's word of 2026-11-20). *@
                <option value="@PlayersBoard">People</option>
                <option value="@BotsBoard">Bots</option>
                <option value="@EveryoneBoard">Everyone</option>
            </select>
        </label>
        @* Each counted from the same games; each viewer picks one, as a theme (the user's word of 2026-11-20). *@
        <label class="choice">
            <span class="choice-name">Rating</span>
            <select class="leaderboard-rating" value="@this._rating" @onchange="this.ChooseRating">
                <option value="@EloRating">Elo</option>
                <option value="@GlickoRating">Glicko-2</option>
                <option value="@TrueSkillRating">TrueSkill</option>
            </select>
        </label>
    </div>

    @if (this.Rows is null && this._problem is null)
    {
        <div class="standings-coming" role="status">
            <span class="spinner" aria-hidden="true"></span>
            <span class="visually-hidden">Counting the standings</span>
        </div>
    }
    @if (this.Rows is { } rows)
    {
        @if (rows.IsEmpty)
        {
            <p class="no-leaders">@this.Columns.Empty</p>
        }
        else
        {
            ImmutableList<Row> sorted = this.Sorted(rows);
            int pages = ((sorted.Count - 1) / PageSize) + 1;
            <div class="leaders-scroll">
            <table class="leaders @this.Columns.Class">
                <thead>
                    <tr>
                        <th>#</th>
                        @if (this._board == EveryoneBoard)
                        {
                            <th class="kind">Kind</th>
                        }
                        <th class="name">@this.Columns.Who</th>
                        @foreach (Column column in this.Columns.All)
                        {
                            <th title="@column.Title" aria-sort="@this.SortOf(column)">
                                <button class="sort @column.Key" @onclick="() => this.SortBy(column)">
                                    @column.Header<span class="arrow">@this.ArrowOf(column)</span>
                                </button>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach ((Row row, int index) in sorted.Select((row, index) => (row, index))
                        .Skip(this._page * PageSize)
                        .Take(PageSize))
                    {
                        <tr>
                            <td class="place">@(index + 1)</td>
                            @if (this._board == EveryoneBoard)
                            {
                                <td class="kind">
                                    <span role="img"
                                          class="@(row.BotId is not null && !row.UsesAi ? "mechanical" : null)"
                                          aria-label="@KindOf(row)"
                                          title="@KindOf(row)">@IconOf(row)</span>
                                </td>
                            }
                            <td class="name">
                                <SeatPlayer Text="@row.Name"
                                            PlayerId="@row.PlayerId"
                                            BotId="@row.BotId"
                                            RulesetId="@string.Empty"
                                            Game="@this.Game" />
                            </td>
                            @foreach ((Column column, int at) in this.Columns.All.Select((column, at) => (column, at)))
                            {
                                <td class="@column.Key">
                                    @if (double.IsNaN(row.Values[at]))
                                    {
                                        <span class="unknown" title="@UnknownTitle">?</span>
                                    }
                                    else
                                    {
                                        @row.Values[at]
                                    }
                                    @if (row.Against.ElementAtOrDefault(at) is { } against)
                                    {
                                        <span class="against" title="@AgainstTitle">vs @against</span>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
            </div>
            @if (pages > 1)
            {
                <nav class="pager" aria-label="Pages">
                    <button class="previous" disabled="@(this._page == 0)" @onclick="() => this._page--">
                        Previous
                    </button>
                    <span class="page">Page @(this._page + 1) of @pages</span>
                    <button class="next" disabled="@(this._page == pages - 1)" @onclick="() => this._page++">
                        Next
                    </button>
                </nav>
            }
        }
    }

    @* No key to the kinds' icons: each in the list names itself on hovering, as a key's would (the user, 2026-11-20). *@
    <p class="about-standings">@this.Columns.About</p>
</div>

@code {
    /// <summary>How many rows a page shows (Stated).</summary>
    private const int PageSize = 10;

    private const string PlayersBoard = "players";
    private const string BotsBoard = "bots";
    private const string EveryoneBoard = "everyone";

    /// <summary>The name the board chosen is remembered by.</summary>
    private const string BoardChoice = "board";

    /// <summary>The name the rating system chosen is remembered by.</summary>
    private const string RatingChoice = RatingSystems.Choice;

    private const string EloRating = RatingSystems.EloKey;
    private const string GlickoRating = RatingSystems.GlickoKey;
    private const string TrueSkillRating = RatingSystems.TrueSkillKey;

    /// <summary>The first column's key, whatever the rating system.</summary>
    private const string RatingKey = "rating";

    private const string PointsTitle = "The points scored at the board, in every game finished, won or lost";

    private const string AgainstTitle = "The mean Elo of the opposing teams the streak was won against";

    private static readonly Board Players = new(
        string.Empty,
        "Person",
        "No one signed in has finished a game of it yet.",
        "Each game finished counts for the people signed in at it, but not for a seat their own AI played. Everyone "
            + "starts at Elo 1500, and gains or loses by how their team did against what the teams' ratings led to "
            + "expect, a bot's team by the bot's own rating. Each win earns as experience your own points, and as "
            + "much again times your share of your team's: carrying a weak ally earns more than being carried by a "
            + "strong one. Points are the points you scored yourself, taking pieces and earning bonuses, in every game "
            + "finished, won or lost. A game not over, with no guest at it, counts as abandoned by a player once it has "
            + "waited a day for their move, and no longer once they make it. A streak counts the games won in a row "
            + "since the last loss, a draw neither adding to it nor ending it, beside the mean Elo of the teams it beat: "
            + "of every game; of the rated ones, counting toward Elo; and of those against people alone.",
        [
            new(RatingKey, "Rating", null),
            new("experience", "Experience", "In each game won, your own points, and as much again times your share of your team's"),
            new("points", "Points", PointsTitle),
            new("won", "Won", null),
            new("lost", "Lost", null),
            new("drawn", "Drawn", null),
            new("abandoned", "Abandoned", "Games not over that have waited a day or more for their move"),
            new("streak", "Streak", "Games won in a row since the last loss, of every game"),
            new("rated-streak", "Rated streak", "Games won in a row since the last loss, of those counting toward Elo"),
            new("people-streak", "People streak", "Games won in a row since the last loss, against people alone"),
        ]
    );

    private static readonly Board Bots = new(
        "bot-leaders",
        "Bot",
        "No bot has finished a game of it yet.",
        "Every game finished counts for the bots at it, a bot at several seats once for each. A bot's Elo is its rating "
            + "from games against the other bots, averaged over the game's sizes. Points are the points it scored "
            + "itself, in every game finished, won or lost. Against people counts the games in which every seat not on "
            + "the bot's team was played by a person, signed in or a guest, rather than a bot or an AI.",
        [
            new(RatingKey, "Rating", null),
            new("points", "Points", PointsTitle),
            new("won", "Won", null),
            new("lost", "Lost", null),
            new("drawn", "Drawn", null),
            new("won-against", "Won against people", null),
            new("lost-against", "Lost against people", null),
            new("drawn-against", "Drawn against people", null),
        ]
    );

    private static readonly Board Everyone = new(
        "everyone",
        "Person or bot",
        "No one has finished a game of it yet.",
        "People signed in and the server's bots together. A person's Elo comes from the games "
            + "they finished; a bot's, from its games against the other bots. Points are the points each scored "
            + "itself, in every game finished, won or lost.",
        [
            new(RatingKey, "Rating", null),
            new("points", "Points", PointsTitle),
            new("won", "Won", null),
            new("lost", "Lost", null),
            new("drawn", "Drawn", null),
        ]
    );

    private string? _game;
    private string _board = PlayersBoard;
    private string _rating = EloRating;
    private Standings? _standings;

    /// <summary>The column the board is sorted by: the first, most first, until another is chosen.</summary>
    private int _sort;
    private bool _isAscending;
    private int _page;
    private string? _problem;

    /// <summary>The game whose leaderboard it is, by its id (<see cref="RulesetDto.Game"/>), as the lobby chose it.</summary>
    [Parameter, EditorRequired]
    public string Game { get; set; } = string.Empty;

    /// <summary>
    /// Told the rating system chosen, as it is chosen, so that it holds for the whole page (the user's request of
    /// 2026-11-20).
    /// </summary>
    [Parameter]
    public EventCallback<RatingSystem> RatingChosen { get; set; }

    /// <summary>
    /// The board chosen, its first column the rating by the system chosen, on every board (the user's report of
    /// 2026-11-20: no way to switch, the choice having been on the people's board alone).
    /// </summary>
    private Board Columns =>
        this._board switch
        {
            BotsBoard => this.Rated(Bots),
            EveryoneBoard => this.Rated(Everyone),
            _ => this.Rated(Players),
        };

    /// <summary>The board with its first column, its rating, by the system chosen.</summary>
    private Board Rated(Board board) => board with { All = board.All.SetItem(0, this.RatingColumn) };

    /// <summary>
    /// The first column: "Rating", whichever system is chosen, the choice above it saying which, so that no other
    /// column shifts as it changes (the user's word of 2026-11-20); the system told on hovering.
    /// </summary>
    private Column RatingColumn =>
        new(
            RatingKey,
            "Rating",
            this._rating switch
            {
                GlickoRating => "Glicko-2, from 1500: like Elo, but surer of a rating the more games are behind it",
                TrueSkillRating =>
                    "TrueSkill, as it ranks: the skill a player very likely has at least, from 0, rising as games show"
                    + " more",
                _ => "Elo, from 1500",
            }
        );

    /// <summary>A player's rating by the system chosen.</summary>
    private double RatingOf(StandingDto player) =>
        this._rating switch
        {
            GlickoRating => player.Glicko,
            TrueSkillRating => player.TrueSkill,
            _ => player.Elo,
        };

    /// <summary>A bot's rating by the system chosen, each from its Elo, as people's games against it take it.</summary>
    private double RatingOf(BotStandingDto bot) =>
        this._rating switch
        {
            GlickoRating => bot.Glicko,
            TrueSkillRating => bot.TrueSkill,
            _ => bot.Elo,
        };

    /// <summary>The board, and how it is sorted, as the player last left it; the players', by Elo, until they choose.</summary>
    protected override async Task OnInitializedAsync()
    {
        if (await this.Browser.Leaderboard() is not { } view)
        {
            return;
        }

        this._board = view[BoardChoice] is BotsBoard or EveryoneBoard ? view[BoardChoice]! : PlayersBoard;
        this._rating = view[RatingChoice] is GlickoRating or TrueSkillRating ? view[RatingChoice]! : EloRating;
        int sort = this.Columns.All.FindIndex(column => column.Key == view.Sort);
        this._sort = Math.Max(0, sort);
        this._isAscending = sort >= 0 && !view.IsDescending;
    }

    /// <summary>The leaderboard of the game, once it is another; told why not, if the server cannot give it.</summary>
    protected override async Task OnParametersSetAsync() =>
        this._problem = this.Game == this._game ? this._problem : await Requests.Attempt(() => this.Show(this.Game));

    /// <summary>The board chosen, of the same game, by its first column, most first, from the first page.</summary>
    private async Task ChooseBoard(ChangeEventArgs change)
    {
        this._board = $"{change.Value}";
        await this.Resorted();
    }

    /// <summary>The rating system chosen, the board by it, most first, from the first page.</summary>
    private async Task ChooseRating(ChangeEventArgs change)
    {
        this._rating = $"{change.Value}";
        await this.Resorted();
        await this.RatingChosen.InvokeAsync(RatingSystems.Of(this._rating));
    }

    /// <summary>The board by its first column, most first, from the first page, remembered.</summary>
    private ValueTask Resorted()
    {
        this._sort = 0;
        this._isAscending = false;
        this._page = 0;
        return this.Remember();
    }

    /// <summary>Sorted by the column, most first; by the same column again, the other way; from the first page.</summary>
    private async Task SortBy(Column column)
    {
        int chosen = this.Columns.All.IndexOf(column);
        this._isAscending = chosen == this._sort && !this._isAscending;
        this._sort = chosen;
        this._page = 0;
        await this.Remember();
    }

    /// <summary>Remembers the board shown, and how it is sorted, to show it so again.</summary>
    private ValueTask Remember() =>
        this.Browser.SetLeaderboard(
            new ListView(
                ImmutableDictionary<string, string>.Empty.Add(BoardChoice, this._board).Add(RatingChoice, this._rating),
                this.Columns.All[this._sort].Key,
                !this._isAscending
            )
        );

    /// <summary>The rows by the column chosen; rows alike, in the order the server ranked them.</summary>
    private ImmutableList<Row> Sorted(ImmutableList<Row> rows) =>
        this._isAscending
            ? [.. rows.OrderBy(row => row.Values[this._sort])]
            : [.. rows.OrderByDescending(row => row.Values[this._sort])];

    private string SortOf(Column column) =>
        this.Columns.All.IndexOf(column) != this._sort ? "none" : this._isAscending ? "ascending" : "descending";

    private string ArrowOf(Column column) =>
        this.Columns.All.IndexOf(column) != this._sort ? string.Empty : this._isAscending ? " ▲" : " ▼";

    /// <summary>
    /// What a row is: a person; a bot playing by a plain algorithm; or a bot playing by an AI (the user's request of
    /// 2026-11-19).
    /// </summary>
    private static string KindOf(Row row) =>
        (row.BotId, row.UsesAi) switch
        {
            (null, _) => "Person",
            (_, false) => "Bot, a plain algorithm",
            _ => "Bot, an AI",
        };

    /// <summary>
    /// A row's kind as an icon: 🧑 a person, 🤖 a bot; a bot by an AI the robot as drawn, as Claude's own is
    /// elsewhere, and a plain algorithm the same robot tinted apart by its class (the user's report of 2026-11-20: a
    /// brain was a blob, unlike the other icons; then, the untinted robot better the AI's).
    /// </summary>
    private static string IconOf(Row row) => row.BotId is null ? "🧑" : "🤖";

    /// <summary>
    /// The game's people and bots, both asked for at once: a board or a rating chosen is then shown from them at once,
    /// nothing asked again, so that nothing on the page moves (the user's report of 2026-11-20: the whole lobby jumped
    /// about at each choice). As last had, meanwhile, if they were (the user's report of 2026-11-25: returning to the
    /// lobby took forever), else a spinner.
    /// </summary>
    private async Task Show(string game)
    {
        this._game = game;
        this._page = 0;
        this._standings = this.Memory.Standings.GetValueOrDefault(game);
        Task<ImmutableList<StandingDto>> people = this.Games.Leaderboard(game, CancellationToken.None);
        Task<ImmutableList<BotStandingDto>> bots = this.Games.BotLeaderboard(game, CancellationToken.None);
        Standings counted = new(await people, await bots);
        this.Memory.Standings = this.Memory.Standings.SetItem(game, counted);
        this._standings = this._game == game ? counted : this._standings;
    }

    /// <summary>The board chosen's rows, by the rating chosen; none until the game's standings are in.</summary>
    private ImmutableList<Row>? Rows =>
        this._standings is not var (people, bots)
            ? null
            : this._board switch
        {
            BotsBoard =>
            [
                .. bots.Select(bot =>
                    new Row(
                        bot.Name,
                        [
                            this.RatingOf(bot),
                            bot.Points,
                            bot.Won,
                            bot.Lost,
                            bot.Drawn,
                            bot.WonAgainstPeople,
                            bot.LostAgainstPeople,
                            bot.DrawnAgainstPeople,
                        ]
                    )
                    {
                        BotId = bot.BotId,
                    }
                ),
            ],
            EveryoneBoard =>
            [
                .. people.Select(player =>
                    new Row(player.Name, [this.RatingOf(player), player.Points, player.Won, player.Lost, player.Drawn])
                    {
                        PlayerId = player.PlayerId,
                    }
                ),
                .. bots.Select(bot =>
                    new Row(bot.Name, [this.RatingOf(bot), bot.Points, bot.Won, bot.Lost, bot.Drawn])
                    {
                        BotId = bot.BotId,
                        UsesAi = bot.UsesAi,
                    }
                ),
            ],
            _ =>
            [
                .. people.Select(player =>
                    new Row(
                        player.Name,
                        [
                            this.RatingOf(player),
                            player.Experience,
                            player.Points,
                            player.Won,
                            player.Lost,
                            player.Drawn,
                            player.Abandoned ?? Unknown,
                            player.Streak.Wins,
                            player.RatedStreak.Wins,
                            player.PeopleStreak.Wins,
                        ]
                    )
                    {
                        PlayerId = player.PlayerId,
                        Against =
                        [
                            null,
                            null,
                            null,
                            null,
                            null,
                            null,
                            null,
                            player.Streak.OpponentElo,
                            player.RatedStreak.OpponentElo,
                            player.PeopleStreak.OpponentElo,
                        ],
                    }
                ),
            ],
        };

    /// <summary>A column a board may be sorted by: its class, header and what it means, if the header says too little.</summary>
    private sealed record Column(string Key, string Header, string? Title);

    /// <summary>
    /// A board: its table's class; what its rows are (Player, Bot); what to say when it has none; what it counts; and its
    /// columns, each a number.
    /// </summary>
    private sealed record Board(string Class, string Who, string Empty, string About, ImmutableList<Column> All);

    /// <summary>
    /// A row of a board: whose, with the player's or bot's id, to see their profile by (a bot's, if it has one, else a
    /// player's); and its numbers, one for each column.
    /// </summary>
    /// <summary>
    /// A figure the server does not know yet, shown as "?" rather than a 0 it is not (the user, 2026-11-26): the games
    /// abandoned, just after the server starts, until it first counts them. Sorted below every known figure.
    /// </summary>
    private const double Unknown = double.NaN;

    private const string UnknownTitle = "Not counted yet: the server counts these just after it starts";

    private sealed record Row(string Name, ImmutableList<double> Values)
    {
        public string? PlayerId { get; init; }

        public string? BotId { get; init; }

        /// <summary>For a bot, whether it plays by an AI rather than a plain algorithm.</summary>
        public bool UsesAi { get; init; }

        /// <summary>Beside each number, by column, the mean Elo it was won against, if it is a streak with one.</summary>
        public ImmutableList<int?> Against { get; init; } = [];
    }
}
