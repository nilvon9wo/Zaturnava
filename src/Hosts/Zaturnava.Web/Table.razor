@* A game: over it all, the seats by team, each team with its total; under them the board (turned so
   the player's own corner is bottom left), and beside it whose turn it is, the dice and what each lets
   move, on the player's turn what they may do - prisoners they may offer back among it, and, for a Pawn
   picked up or just come to the far edge, what it may be promoted to - and what has happened. Dice the player lost, unable to use them, are told until they
   dismiss it or their turn comes round again: the turn has passed on by then. While a bot decides, it advances the game every
   TableSettings.BotPace, so that bots take their turns one at a time; while a person elsewhere
   decides, it asks for the game again every TableSettings.PollInterval. While a decision is timed, it
   counts down, and advances the game once time is up, for the server to decide for that seat. Once the
   game is over, the player may play it again, the same seats played the same way, or start a quick game.
   If the server no longer has the game (restarted, say), it says so, stops asking, and offers the lobby.
   Shown again after being hidden (when the browser may have slowed its asking), it asks at once.
   Above it all, the way back to the lobby and the game's name (Proposed 2026-11-12: not in the lower left, as
   the user asked; the board shows any river, so no words for the terrain). Under it all, a quiet bar: how to
   play, the buttons that turn the board, and the page's own settings. Beside the log, by tabs, the players' talk (TableTalk). Any piece clicked
   on, the player's or not, is told of at the side (PieceCard) until put away. *@
@using Microsoft.JSInterop
@implements IDisposable
@inject IGameServing Games
@inject TableSettings Settings
@inject Browser Browser
@inject TimeProvider Clock
@inject ServerAddress Server
@using System.Globalization

<section class="table">
    <nav class="table-nav">
        <button class="leave" title="Back to the lobby" @onclick="this.OnLeave">&#x2190; Lobby</button>
        <span class="brand">@(this._view?.RulesetName ?? "Zaturnava")</span>
    </nav>

    @if (this._problem is { } problem && this._view is null)
    {
        <p class="problem" role="alert">@problem</p>
    }

    @if (this._gone is { } gone)
    {
        <div class="gone">
            <p class="problem" role="alert">@gone</p>
            <button class="action primary back" @onclick="this.OnLeave">Back to the lobby</button>
        </div>
    }
    else if (this._view is { } view)
    {
        <div class="seats">
            @foreach (IGrouping<int, SeatDto> team in this.TeamsOf(view))
            {
                <section class="team @(this.IsMine(team) ? "mine" : null) @(HasWon(view, team) ? "won" : null)">
                    <header class="team-head">
                        <span class="team-name">@string.Join(" & ", this.SeatsOf(team).Select(seat => seat.Name))</span>
                        <span class="team-score" title="Team score">@team.Sum(seat => seat.Score)</span>
                    </header>
                    <ol class="team-seats">
                        @foreach (SeatDto seat in this.SeatsOf(team))
                        {
                            <li class="seat seat-@seat.Id @(seat.Id == view.DecidingSeat ? "deciding" : null)">
                                <span class="swatch"></span>
                                <span class="name">@seat.Name</span>
                                <SeatPlayer Text="@this.Player(seat)"
                                            PlayerId="@seat.PlayerId"
                                            BotId="@seat.BotId"
                                            RulesetId="@view.RulesetId"
                                            Board="view.Board" />
                                @if (seat.IsRetired)
                                {
                                    <span class="retired">retired</span>
                                }
                                else if (seat.HasGivenUp)
                                {
                                    <span class="gave-up">@(IsAhead(view, seat) ? "resting on the lead" : "gave up")</span>
                                }
                                <span class="prisoners" title="Prisoners">
                                    @foreach (PrisonerDto prisoner in seat.Prisoners)
                                    {
                                        <PieceIcon Kind="@prisoner.Kind" Name="@prisoner.Name" Owner="prisoner.Owner" Mark="prisoner.Mark" Pieces="this.PiecesShown" />
                                    }
                                </span>
                                @if (view.DraftLeft is { } drafting && drafting[seat.Id] is null)
                                {
                                    <span class="score secret" title="Drafting in secret">?</span>
                                }
                                else
                                {
                                    <span class="score" title="@(view.DraftLeft is null ? "Score" : "Points left to spend")">@seat.Score</span>
                                }
                                @if (this.MayTakeOver(view, seat))
                                {
                                    <button class="take-over"
                                            title="Play this seat yourself, in the bot's place, for the rest of the game"
                                            @onclick="() => this.TakeOver(view, seat.Id)">
                                        Take over
                                    </button>
                                }
                            </li>
                        }
                    </ol>
                </section>
            }
        </div>

        <div class="play">
            <Board View="this.Drawn(view)"
                   Actions="this.Actions"
                   Selection="this.Selection"
                   Turn="this._boardTurn"
                   LastMove="this._lastMove"
                   Pieces="this.PiecesShown"
                   PreviewAt="cell => this.PreviewOf(view, cell)"
                   OnCellClicked="this.Click" />

            <div class="@(this._turn is null ? "turn" : "turn yours")">
                @if (this._problem is { } trouble)
                {
                    <p class="problem" role="alert">@trouble</p>
                }
                @if (this.Seating.Claim is { } absent && AwayNoticeOf(view, absent.Seat) is { } awayNotice)
                {
                    <div class="away-notice" role="alert">
                        <p>@awayNotice</p>
                        @if (view.Seats[absent.Seat].MayRejoin && view.Seats[absent.Seat].TurnsMissed > 0)
                        {
                            <button class="rejoin flashing"
                                    @onclick="() => this.Submit(absent, EndProposalDto.RejoinActionOf(absent.Seat))">
                                Rejoin game
                            </button>
                        }
                    </div>
                }
                @if (!this.IsSafetyOn)
                {
                    <p class="safety-off" role="alert">Safety OFF: you may take your own team's pieces.</p>
                }
                @if (this.Seating.Claim is { } caller && !view.Seats[caller.Seat].Chances.IsEmpty)
                {
                    <div class="chances">
                        @foreach (ActionDto chance in view.Seats[caller.Seat].Chances)
                        {
                            <button class="action chance flashing @chance.Kind" @onclick="() => this.Seize(caller, chance)">
                                @chance.Label
                            </button>
                        }
                    </div>
                }
                @if ((view.PausedFor, view.PauseLeft) is ({ } paused, { } pauseLeft))
                {
                    @* the face-off's pause (Grand Legions specification §6.4): no one else acts meanwhile, so every
                       player is told why the game waits (the user, 2026-11-26), not only on hovering *@
                    <p class="face-off-paused" role="status">
                        <span class="pause-left">⏸ @Math.Ceiling(pauseLeft).ToString(CultureInfo.InvariantCulture) s</span>
                        <span class="pause-why">@PauseWhy(paused == this.Seating.Claim?.Seat, this.Player(view.Seats[paused]))</span>
                    </p>
                }
                <p class="status">@this.Status(view)</p>
                @if (view.Outcome is null && OpenSeatsOf(view) is not null)
                {
                    <div class="invite">
                        <label class="hint" for="invitation">
                            Invite others to the open seats: send them this. They open the page, enter the code in
                            the lobby, and join.
                        </label>
                        <div class="invite-row">
                            <input id="invitation"
                                   class="invitation"
                                   readonly
                                   value="@GameCode.InvitationTo(this.Seating.GameId, view.RulesetName, this.Server.Value)" />
                            <button class="copy-invitation"
                                    @onclick="() => this.CopyInvitation(view)">Copy</button>
                        </div>
                        @if (this._isInvitationCopied is { } isCopied)
                        {
                            <p class="copied" role="status">
                                @(isCopied ? "Copied: paste it wherever you like." : "The page may not copy here: select the text and copy it yourself.")
                            </p>
                        }
                    </div>
                    <p class="hint ai-join">
                        An AI of your own may take an open seat: give it this game's id,
                        <code class="game-id">@this.Seating.GameId</code>, and an AI token from your profile.
                        <a href="@DocsLinks.Bots" target="_blank" rel="noopener noreferrer">How to connect it</a>
                    </p>
                }
                @if (view.Vacancy is { } vacancy && this.Seating.Claim is { } host)
                {
                    @if (MayFill(vacancy, host.Seat))
                    {
                        <button class="action primary fill" @onclick="() => this.Fill(host)">
                            Fill the open seats with bots
                        </button>
                    }
                    else
                    {
                        <p class="hint fill-wait">@FillWait(vacancy, host.Seat)</p>
                    }
                }
                @if (view.Away is { } away && this.Seating.Claim is { } voter && away.Voters.Contains(voter.Seat)
                     && (away.IsOpen || away.Stopping.Contains(voter.Seat)))
                {
                    bool isStopping = away.Stopping.Contains(voter.Seat);
                    <div class="away-vote">
                        <p>@AwayQuestion(view, away)</p>
                        <div class="actions">
                            <button class="action keep-waiting"
                                    aria-pressed="@(isStopping ? "false" : "true")"
                                    @onclick="() => this.Submit(voter, AwayDto.ActionOf(voter.Seat, away.Seat, false))">
                                Keep waiting
                            </button>
                            <button class="action stop-waiting"
                                    aria-pressed="@(isStopping ? "true" : "false")"
                                    @onclick="() => this.Submit(voter, AwayDto.ActionOf(voter.Seat, away.Seat, true))">
                                Stop waiting
                            </button>
                        </div>
                        <p class="hint">@AwayHint(away)</p>
                        @if (away.MayReplace(voter.Seat))
                        {
                            <button class="action replace" @onclick="() => this.Replace(voter)">
                                Have a bot play for them
                            </button>
                        }
                        else if (away.IsOpen)
                        {
                            <p class="hint replace-wait">@ReplaceWait(away)</p>
                        }
                    </div>
                }
                @if (view.Outcome is { } outcome)
                {
                    <div class="result @this.ResultOf(outcome)" role="status">
                        <h2 class="verdict">@this.VerdictOf(view, outcome)</h2>
                        <ol class="totals">
                            @foreach (IGrouping<int, SeatDto> team in this.TeamsOf(view))
                            {
                                <li class="@(HasWon(view, team) ? "won" : null)">
                                    <span class="names">@string.Join(" & ", team.Select(seat => seat.Name))</span>
                                    <span class="points">@team.Sum(seat => seat.Score)</span>
                                    @if (HasWon(view, team))
                                    {
                                        <span class="badge">won</span>
                                    }
                                </li>
                            }
                        </ol>
                    </div>
                    <div class="actions">
                        @{
                            ImmutableList<string> paid = PaidBotsOf(view);
                        }
                        @if (!paid.IsEmpty)
                        {
                            <button class="action again paid" @onclick="() => this.PlayAgain(view)">
                                Play again, with @string.Join(" and ", paid): costs tokens
                            </button>
                        }
                        else
                        {
                            <button class="action primary again" @onclick="() => this.PlayAgain(view)">Play again</button>
                        }
                        @if (view.IsDealt)
                        {
                            <button class="action again same-armies" @onclick="() => this.PlayAgain(view, true)">
                                Play again, same armies
                            </button>
                        }
                        <button class="action quick" @onclick="() => this.QuickGame(view)">Quick game</button>
                    </div>
                }
                @if (this._notice is { } notice)
                {
                    <p class="notice" role="status">
                        @this.Named(notice)
                        <button class="dismiss" @onclick="this.Dismiss">OK</button>
                    </p>
                }
                @if (this.Countdown() is { } countdown)
                {
                    <p class="countdown">@countdown</p>
                }
                @if (view.Offer is { } offer)
                {
                    <p class="offer">@this.Named(OfferText(view, offer))</p>
                }
                @if (view.Dice.Count > 0)
                {
                    <ul class="dice">
                        @foreach (DieDto die in view.Dice)
                        {
                            <li class="@(die.IsUsable ? null : "unusable")"
                                title="@UnusableNote(view, die)"><span class="face">@DieFaces.FaceOf(die.Value)</span> @die.Value: @this.Named(die.Meaning)</li>
                        }
                    </ul>
                }
                @if (this._turn is { } turn)
                {
                    ImmutableList<ActionDto> promotions = [.. this.AtSelection(turn).Where(IsPromotion)];
                    ImmutableList<ActionDto> flights = [.. this.AtSelection(turn).Where(IsFlight)];
                    ImmutableList<ActionDto> atPiece =
                        [.. this.AtSelection(turn).Where(action => !IsPromotion(action) && !IsFlight(action))];
                    @if (this._eitherOf is { } either)
                    {
                        <div class="either-of" role="group" aria-labelledby="either-of-question">
                            <span id="either-of-question" class="name">Swap or capture?</span>
                            @foreach (ActionDto action in either)
                            {
                                <button class="@(action.Label is null ? "action either capture" : "action either swap")"
                                        @onclick="() => this.ChooseEither(turn.Claim, action)">
                                    @(action.Label is { } label ? this.Named(label) : "Capture it")
                                </button>
                            }
                        </div>
                    }
                    @if (!flights.IsEmpty)
                    {
                        <div class="flight">
                            <p class="hint">@this.Named(FlightHeading(view, this._selection.Selected!.Value))</p>
                            @foreach (ActionDto action in flights)
                            {
                                <button class="action primary flee" @onclick="() => this.Submit(turn.Claim, action)">
                                    @this.Named(ActionLabels.LabelOf(action))
                                </button>
                            }
                            @if (view.Fleeing is null)
                            {
                                <button class="action later" @onclick="this.PutDown">Stay on the board</button>
                            }
                            else
                            {
                                @foreach (ActionDto action in turn.Actions.OffBoard)
                                {
                                    <button class="action later" @onclick="() => this.Submit(turn.Claim, action)">
                                        @this.Named(ActionLabels.LabelOf(action))
                                    </button>
                                }
                            }
                        </div>
                    }
                    @if (!atPiece.IsEmpty)
                    {
                        <div class="at-piece">
                            @foreach (ActionDto action in atPiece)
                            {
                                <button class="action at-cell" @onclick="() => this.Submit(turn.Claim, action)">
                                    @this.Named(ActionLabels.LabelOf(action))
                                </button>
                            }
                        </div>
                    }
                    @if (!promotions.IsEmpty)
                    {
                        ImmutableList<ActionDto> own = [.. promotions.Where(IsOwnPromotion)];
                        ImmutableList<ActionDto> captured =
                            ByKinship(view, turn.Claim.Seat, [.. promotions.Where(action => !IsOwnPromotion(action))]);
                        <div class="promotion">
                            <p class="hint">@this.Named(PromotionHeading(view, this._selection.Selected!.Value))</p>
                            @if (!own.IsEmpty)
                            {
                                int owner = view.Pieces.First(piece => piece.Cell == this._selection.Selected!.Value).Owner;
                                <div class="promotion-choices own">
                                    @foreach (ActionDto action in own)
                                    {
                                        PieceKindDto becomes = BecomingOf(view, action);
                                        <span class="choice-and-about">
                                            <button class="choice"
                                                    title="@this.Named(ActionLabels.LabelOf(action))"
                                                    @onclick="() => this.Submit(turn.Claim, action)">
                                                <PieceIcon Kind="@becomes.Kind" Name="@becomes.Name" Owner="owner" Mark="becomes.Mark" Pieces="this.PiecesShown" />
                                                <span class="name">@this.Named(becomes.Name)</span>
                                                <span class="holder">its own promotion</span>
                                            </button>
                                            @this.AboutButton(new PrisonerDto(-1, becomes.Kind, becomes.Name, owner) { Mark = becomes.Mark })
                                        </span>
                                    }
                                </div>
                            }
                            @foreach (ImmutableList<ActionDto> army in ArmiesOf(view, captured))
                            {
                                <div class="promotion-choices">
                                    @foreach (ActionDto action in army)
                                    {
                                        (SeatDto holder, PrisonerDto into) = IntoOf(view, action);
                                        <span class="choice-and-about">
                                            <button class="choice"
                                                    title="@this.Named(ActionLabels.LabelOf(action))"
                                                    @onclick="() => this.Submit(turn.Claim, action)">
                                                <PieceIcon Kind="@into.Kind" Name="@into.Name" Owner="into.Owner" Mark="into.Mark" Pieces="this.PiecesShown" />
                                                <span class="name">@this.Named(Owned(view, into))</span>
                                                <span class="holder">@HeldBy(holder, turn.Claim.Seat)</span>
                                            </button>
                                            @this.AboutButton(into)
                                        </span>
                                    }
                                </div>
                            }
                            @if (view.PromotionDue is null)
                            {
                                <button class="action later" @onclick="this.PutDown">Promote later</button>
                            }
                            else
                            {
                                @foreach (ActionDto action in turn.Actions.OffBoard)
                                {
                                    <button class="action later" @onclick="() => this.Submit(turn.Claim, action)">
                                        @this.Named(ActionLabels.LabelOf(action))
                                    </button>
                                }
                            }
                        </div>
                    }
                    else if (view.DraftLeft is { } left)
                    {
                        @if (IsBuying(view))
                        {
                            <DraftCatalogue Kinds="view.DraftKinds"
                                            Left="left[turn.Claim.Seat].GetValueOrDefault()"
                                            Picked="@this._draftPick"
                                            Filtered="this._draftFilters"
                                            Owner="turn.Claim.Seat"
                                            Pieces="this.PiecesShown"
                                            OnPick="this.PickToDraft"
                                            OnHidden="this.LetGoOfDraftPick" />
                            <p class="hint draft-place">
                                @(this.Selection.Choice is null
                                    ? "Pick a piece above, then a marked square of your kingdom for it."
                                    : "Now click a marked square of your kingdom for it.")
                            </p>
                            @foreach (string change in ChangesOf(view))
                            {
                                <button class="action choose draft-change"
                                        aria-pressed="@(this._selection.Choice == change ? "true" : "false")"
                                        @onclick="() => this.ChooseChange(change)">
                                    @change
                                </button>
                            }
                        }
                        else if (view.LegalActions.Any(action => action.Kind == PalaceKind)
                                 && this._palace is { } palace)
                        {
                            string centre = view.Cells.First(cell => cell.Id == palace.Cell).Name;
                            <p class="hint draft-palace">
                                Your palace would stand here, three squares by three about @centre. Click another
                                marked square to move it, or:
                            </p>
                            <button class="action primary build-palace"
                                    @onclick="() => this.BuildPalace(turn.Claim, palace.Action)">
                                Build the palace here
                            </button>
                        }
                        else if (view.LegalActions.Any(action => action.Kind == PalaceKind))
                        {
                            <p class="hint draft-palace">
                                Click a marked square of your kingdom: your palace would stand three squares by three
                                about it, that square at its centre. You may move it before you build it.
                            </p>
                        }
                        else
                        {
                            <p class="hint draft-throne">
                                Click a marked square of your kingdom to set your throne there.
                            </p>
                        }
                        <div class="actions">
                            @foreach (ActionDto action in turn.Actions.OffBoard)
                            {
                                <button class="action" @onclick="() => this.Submit(turn.Claim, action)">
                                    @this.Named(ActionLabels.LabelOf(action))
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="hint">@this.Hint(turn.Actions)</p>
                        ImmutableList<string> coming = [.. turn.Actions.Choices.Where(choice => ComingOf(view, choice) is not null)];
                        ImmutableList<ActionDto> hires = [.. turn.Actions.OffBoard.Where(action => action.Coming is not null)];
                        @if (!hires.IsEmpty)
                        {
                            <div class="coming hiring">
                                <span class="name">Hire:</span>
                                @foreach (ActionDto hire in hires)
                                {
                                    PrisonerDto piece = hire.Coming!;
                                    <button class="@(this._hireChosen == piece.Id ? "prisoner chosen" : "prisoner")"
                                            title="@this.Named(ActionLabels.LabelOf(hire))"
                                            aria-pressed="@(this._hireChosen == piece.Id ? "true" : "false")"
                                            @onclick="() => this.ChooseHire(piece)">
                                        <PieceIcon Kind="@piece.Kind" Name="@piece.Name" Owner="piece.Owner" Mark="piece.Mark" Pieces="this.PiecesShown" />
                                    </button>
                                }
                            </div>
                            @if (hires.Find(hire => hire.Coming!.Id == this._hireChosen) is { } chosen)
                            {
                                <button class="action hire" @onclick="() => this.Submit(turn.Claim, chosen)">
                                    @this.Named(ActionLabels.LabelOf(chosen))
                                </button>
                            }
                        }
                        @if (!coming.IsEmpty)
                        {
                            <div class="coming">
                                <span class="name">Return to board:</span>
                                @foreach (string choice in coming)
                                {
                                    PrisonerDto piece = ComingOf(view, choice)!;
                                    <button class="@(this._selection.Choice == choice ? "prisoner chosen" : "prisoner")"
                                            title="@this.Named(choice)"
                                            aria-pressed="@(this._selection.Choice == choice ? "true" : "false")"
                                            @onclick="() => this.Choose(choice)">
                                        <PieceIcon Kind="@piece.Kind" Name="@piece.Name" Owner="piece.Owner" Mark="piece.Mark" Pieces="this.PiecesShown" />
                                    </button>
                                }
                            </div>
                        }
                        <div class="actions">
                            @foreach (string choice in turn.Actions.Choices.Except(coming))
                            {
                                <button class="action primary choose"
                                        aria-pressed="@(this._selection.Choice == choice ? "true" : "false")"
                                        @onclick="() => this.Choose(choice)">
                                    @this.Named(choice)
                                </button>
                            }
                            @foreach (ActionDto action in turn.Actions.OffBoard.Except(hires).Where(action => !IsClosing(action)))
                            {
                                bool mayFake = action.Kind == RollKind && view.Scenario is not null;
                                @if (mayFake)
                                {
                                    @* Dice of the player's choosing, in a scenario only, on a development server only;
                                       the server refuses them anywhere else. *@
                                    <span class="faked-dice">
                                        @for (int die = 0; die < this._faked.Count; die++)
                                        {
                                            int index = die;
                                            <input type="number" min="1" class="faked-die"
                                                   aria-label="@($"Die {index + 1}, as it is to come up")"
                                                   value="@this._faked[index]"
                                                   @oninput="change => this.Fake(index, change)" />
                                        }
                                    </span>
                                }
                                <button class="action primary @(IsUrged(view, action) ? "urged" : null)"
                                        @onclick="() => this.Submit(turn.Claim, mayFake ? this.Faked(action) : action)">
                                    @(mayFake && this.IsFaking ? "Use as dice" : this.Named(ActionLabels.LabelOf(action)))
                                </button>
                            }
                        </div>
                    }
                    @if (view.MayOffer)
                    {
                        <div class="ransom">
                            <p class="hint">Offer prisoners back:</p>
                            @foreach (SeatDto receiver in Receivers(view, turn.Claim.Seat))
                            {
                                <div class="ransom-to">
                                    <span class="name">To @(receiver.Id == turn.Claim.Seat ? "yourself" : Who(receiver)):</span>
                                    @foreach (PrisonerDto prisoner in HeldOf(view, turn.Claim.Seat, receiver.Id))
                                    {
                                        <button class="@ClassOf(prisoner, this._given)"
                                                title="@TitleOf(prisoner)"
                                                disabled="@(!prisoner.MayGoBack)"
                                                @onclick="() => this.GiveOne(receiver.Id, prisoner)">
                                            <PieceIcon Kind="@prisoner.Kind" Name="@prisoner.Name" Owner="prisoner.Owner" Mark="prisoner.Mark" Pieces="this.PiecesShown" />
                                        </button>
                                    }
                                    <button class="all"
                                            @onclick="() => this.GiveAll(view, turn.Claim.Seat, receiver.Id)">
                                        All
                                    </button>
                                </div>
                            }
                            @{ ImmutableList<PrisonerDto> askable = this.Askable(view, turn.Claim.Seat); }
                            @if (!askable.IsEmpty)
                            {
                                <p class="hint">Ask for in return (or nothing, for a gift):</p>
                                <div class="ransom-ask">
                                    @foreach (PrisonerDto prisoner in askable)
                                    {
                                        <button class="@ClassOf(prisoner, this._asked)"
                                                title="@TitleOf(prisoner)"
                                                disabled="@(!prisoner.MayGoBack)"
                                                @onclick="() => this.AskOne(prisoner)">
                                            <PieceIcon Kind="@prisoner.Kind" Name="@prisoner.Name" Owner="prisoner.Owner" Mark="prisoner.Mark" Pieces="this.PiecesShown" />
                                        </button>
                                    }
                                </div>
                            }
                            @if (view.Seats[turn.Claim.Seat].Prisoners.Concat(askable).Any(prisoner => !prisoner.MayGoBack))
                            {
                                <p class="hint under-investigation">
                                    The greyed prisoners' loyalties are under investigation: they may go home once
                                    every player has had a turn.
                                </p>
                            }
                            <button class="action offer"
                                    disabled="@this._given.IsEmpty"
                                    @onclick="() => this.Offer(turn.Claim)">
                                @(this._asked.IsEmpty ? "Give them back" : "Offer the exchange")
                            </button>
                        </div>
                    }
                }
                @if (this.Seating.Claim is { } mine)
                {
                    ImmutableList<ActionDto> closing = this.Closing(view);
                    Passing passing = this._turn is { } current ? PassingOf(current.Actions) : Passing.Plain;
                    SeatDto own = view.Seats[mine.Seat];
                    bool mayRejoin = own is { MayProposeEnd: false, MayRejoin: true, TurnsMissed: 0 };
                    @if (own.MayProposeEnd || mayRejoin || !closing.IsEmpty)
                    {
                        <div class="end-area">
                            @foreach (ActionDto action in closing)
                            {
                                <button class="@ClosingClassOf(action, passing)" @onclick="() => this.Submit(mine, action)">
                                    @this.Named(ActionLabels.LabelOf(action))
                                </button>
                            }
                            @if (own.MayProposeEnd)
                            {
                                EndOutlook outlook = EndOutlook.Of(view, mine.Seat);
                                <button class="@EndGameClassOf(outlook)" style="@EndGameStyleOf(outlook)"
                                        title="End the game now: points decide" @onclick="this.AskToEnd">
                                    @outlook.Proposal
                                </button>
                            }
                            else if (mayRejoin)
                            {
                                <button class="rejoin" @onclick="() => this.Submit(mine, EndProposalDto.RejoinActionOf(mine.Seat))">
                                    Rejoin game
                                </button>
                            }
                        </div>
                    }
                }
                @if (this._playerToken is not null)
                {
                    <button class="report-bug" @onclick="this.AskToReport">Report a bug</button>
                }
            </div>

            <TableTalk Seating="this.Seating" Seats="view.Seats">
                <LogTools>
                    <button class="log-filter" aria-pressed="@(this._isHighlightsOnly ? "true" : "false")" @onclick="this.ToggleHighlights">
                        @(this._isHighlightsOnly ? "Show everything" : "Highlights only")
                    </button>
                </LogTools>
                <ChildContent>
                    <ol class="events">
                        @{
                            int? keptSince = this._isHighlightsOnly || view.Log.IsEmpty ? null : KeptSince(view.Log);
                        }
                        @foreach (EventDto happened in this.Shown(view))
                        {
                            <li class="event @happened.Kind seat-@happened.Seat">@this.Named(happened.Text)</li>
                            @if (happened.Number == keptSince)
                            {
                                <li class="dropped">Older events are no longer kept, except for the highlights below.</li>
                            }
                        }
                    </ol>
                </ChildContent>
            </TableTalk>

            @if ((this.AreCardsShown || this._isAboutAsked) && this._offBoardShown is { } offBoard)
            {
                @* the card last asked for: a piece off the board clicked since any on it (playtest 2026-11-19, T7) *@
                <PieceCard Piece="new PieceDto(offBoard.Id, offBoard.Kind, offBoard.Name, offBoard.Owner, -1) { Mark = offBoard.Mark }"
                           Kind="view.Kinds.Find(kind => kind.Kind == offBoard.Kind)"
                           Owner="@view.Seats[offBoard.Owner].Name"
                           Cell=""
                           Pieces="this.PiecesShown"
                           Forward="view.Seats[offBoard.Owner].Forward"
                           Turn="this._boardTurn"
                           OnClose="this.PutAwayOffBoard" />
            }
            else if (this.AreCardsShown && !this._isPlacingCardClosed && this.Placing(view) is { } placing)
            {
                <PieceCard Piece="placing.Piece"
                           Kind="placing.Kind"
                           Owner="@view.Seats[placing.Piece.Owner].Name"
                           Cell=""
                           Pieces="this.PiecesShown"
                           Forward="view.Seats[placing.Piece.Owner].Forward"
                           Turn="this._boardTurn"
                           OnClose="this.ClosePlacingCard" />
            }
            else if (this.AreCardsShown && view.Pieces.Find(piece => piece.Id == this._inspected) is { } inspected)
            {
                <PieceCard Piece="inspected"
                           Kind="view.Kinds.Find(kind => kind.Kind == inspected.Kind)"
                           Owner="@view.Seats[inspected.Owner].Name"
                           Cell="@view.Cells.First(cell => cell.Id == inspected.Cell).Name"
                           IsOnDark="BoardFrame.IsDark(view.Cells.First(cell => cell.Id == inspected.Cell))"
                           Pieces="this.PiecesShown"
                           Forward="view.Seats[inspected.Owner].Forward"
                           Turn="this._boardTurn"
                           OnClose="this.PutAway" />
            }
        </div>
    }

    @if (this._view is { } asked && this.Seating.Claim is { } proposer && this._isProposing)
    {
        <div class="backdrop">
            <div class="dialog proposing" role="dialog" aria-modal="true" aria-labelledby="proposing-title">
                <CloseButton Class="cancel" OnClose="this.KeepPlaying" />
                <h2 id="proposing-title">@EndOutlook.Of(asked, proposer.Seat).Proposal?</h2>
                <p>The other players will be asked to agree.</p>
                <p>Meanwhile, will you wait for their answers, or pass on all your remaining turns?</p>
                <div class="actions">
                    <button class="action wait primary" @onclick="() => this.ProposeEnd(proposer, false)">Wait for them to agree</button>
                    <button class="action resign" @onclick="() => this.ProposeEnd(proposer, true)">Pass on all my turns</button>
                </div>
            </div>
        </div>
    }

    @if (this._isReporting)
    {
        <div class="backdrop">
            <div class="dialog reporting" role="dialog" aria-modal="true" aria-labelledby="reporting-title">
                <CloseButton Class="close-report" OnClose="this.CloseReport" />
                <h2 id="reporting-title">Report a bug</h2>
                @if (this._bugReported is { } reported)
                {
                    <p class="reported">Thank you. It is kept as report <code>@reported</code>.</p>
                }
                else
                {
                    <p>What went wrong, or seems to? The game as it stands is kept with what you say.</p>
                    <textarea class="bug-description"
                              rows="5"
                              maxlength="@ReportBugRequest.MaximumLength"
                              aria-labelledby="reporting-title"
                              @bind="this._bugText"></textarea>
                    @if (this._bugProblem is { } unsent)
                    {
                        <p class="problem" role="alert">@unsent</p>
                    }
                    <div class="actions">
                        <button class="action primary send-report" @onclick="this.SendReport">Send</button>
                    </div>
                }
            </div>
        </div>
    }

    @if (this._view?.Proposal is { } proposal && this._turn is { } voting)
    {
        <div class="backdrop">
            <div class="dialog voting" role="alertdialog" aria-modal="true" aria-labelledby="voting-title">
                <h2 id="voting-title">@EndOutlook.Of(this._view, voting.Claim.Seat).Question</h2>
                <p class="proposer">@Who(this._view.Seats[proposal.Proposer]) proposes ending the game.</p>
                @if (proposal.Resigns)
                {
                    <p>They have given up their remaining turns.</p>
                }
                @if (this.Countdown() is { } left)
                {
                    <p class="countdown">@left; no answer keeps the game going.</p>
                }
                <div class="actions">
                    @foreach (ActionDto action in voting.Actions.OffBoard)
                    {
                        <button class="action answer" @onclick="() => this.Submit(voting.Claim, action)">
                            @ActionLabels.LabelOf(action)
                        </button>
                    }
                </div>
            </div>
        </div>
    }

    <footer class="bar table-bar">
        <span class="where">
            @this.HowToPlay
        </span>
        @if (this._view is { } shown)
        {
            <span class="turns">
                <button class="turn-left" title="Turn the board anticlockwise" @onclick="this.TurnLeft">&#x27F2;</button>
                <button class="turn-home" title="Your own view of the board" @onclick="() => this.TurnHome(shown)">
                    My view
                </button>
                <button class="turn-right" title="Turn the board clockwise" @onclick="this.TurnRight">&#x27F3;</button>
            </span>
        }
        @this.PageSettings?.Invoke(this._hasPieceSets)
    </footer>
</section>

@code {
    private const string BotController = "bot";
    private const string OpenController = "open";
    private const string RollKind = "roll";
    private const string FleeKind = "flee";
    private const string MoveKind = "move";
    private const string EscapeKind = "escape";
    private const string ThroneKind = "throne";
    private const string PalaceKind = "palace";
    private const string DraftKind = "draft";
    private const string PassKind = "pass";
    private const string HandOverKind = "hand-over";
    private const string RegentArgument = "regent";
    private const string PieceArgument = "piece";
    private const string Alarm = "alarm";
    private const string Rescued = "rescued";
    private const string Triumph = "triumph";
    private const string Lament = "lament";
    private const string Lost = "lost";
    private const string Victory = "victory";
    private const string Defeat = "defeat";
    private const string Restored = "restored";
    private const string Dread = "dread";
    private const string Rally = "rally";
    private const string Menace = "menace";
    private const string Glory = "glory";
    private const string Doom = "doom";

    private static readonly BoardActions NoActions = new([]);

    private readonly Timer _poll;
    private readonly DotNetObjectReference<Table> _self;
    private GameViewDto? _view;
    private Turn? _turn;
    private BoardSelection _selection = BoardSelection.None;

    /// <summary>The kind the player picked to draft next; kept, so that several alike are placed in a row.</summary>
    private string? _draftPick;

    /// <summary>
    /// The palace the player is placing, until they build it: the square at its centre, and the choice building it
    /// there. Drawn on the board meanwhile; another marked square clicked moves it (the user's request of 2026-11-13:
    /// a square clicked alone did not make plain that the palace would stand about it).
    /// </summary>
    private (int Cell, ActionDto Action)? _palace;

    /// <summary>The draft's filters, as the player last left them, kept from one turn to draft to the next.</summary>
    private readonly DraftCatalogue.Filters _draftFilters = new();

    /// <summary>Whether the player put away the card of the piece they are placing, until they pick another.</summary>
    private bool _isPlacingCardClosed;

    /// <summary>The piece last clicked on, told of beside the board until put away; none, if none was.</summary>
    private int? _inspected;

    /// <summary>A piece off the board whose card is shown: a prisoner picked to give back, ask for, or hire (J2).</summary>
    private PrisonerDto? _offBoardShown;

    /// <summary>Whether the card off the board was asked for by its own button, so shown even with cards off.</summary>
    private bool _isAboutAsked;

    /// <summary>The prisoner picked to hire, by id, hired with its own button once the player has seen the piece.</summary>
    private int? _hireChosen;
    private BoardTurn _boardTurn = BoardTurn.None;
    private ImmutableHashSet<int> _lastMove = [];
    private bool _isHighlightsOnly = true;

    /// <summary>
    /// The token of the player signed in on this browser, if one is: who may take a seat over at a game only for
    /// players signed in.
    /// </summary>
    private string? _playerToken;
    private bool _isProposing;

    /// <summary>
    /// Whether the player signed in is reporting a bug (playtest 2026-11-19, T4); what they say; the report's id, once
    /// kept; and why it was not, if it was not.
    /// </summary>
    private bool _isReporting;

    /// <summary>Whether the invitation to the game was copied, once the player asked: none, until they do.</summary>
    private bool? _isInvitationCopied;
    private string _bugText = string.Empty;
    private string? _bugReported;
    private string? _bugProblem;
    private DateTimeOffset? _deadline;
    private int? _receiver;
    private ImmutableHashSet<int> _given = [];
    private ImmutableHashSet<int> _asked = [];
    private ImmutableHashSet<string> _offersMade = [];
    private int _offersTurn;
    private int _heard = -1;
    private string? _problem;
    private string? _notice;
    private bool _isBotDeciding;

    /// <summary>Why the game can no longer be shown or played, once it cannot; it then shows nothing else.</summary>
    private string? _gone;

    public Table()
    {
        this._poll = new Timer(this.Tick);
        this._self = DotNetObjectReference.Create(this);
    }

    /// <summary>The log, newest first: all of it, or only its highlights.</summary>
    private IEnumerable<EventDto> Shown(GameViewDto view) =>
        view.Log.Reverse().Where(happened => !this._isHighlightsOnly || EventDto.Highlights.Contains(happened.Kind));

    /// <summary>
    /// The oldest event of the unbroken run the log ends with, if events before it were let go (only
    /// highlights are kept that long); else null.
    /// </summary>
    private static int? KeptSince(ImmutableList<EventDto> log)
    {
        int offset = log[^1].Number - (log.Count - 1);
        return offset > 0 ? log.Where((happened, index) => happened.Number - index == offset).First().Number : null;
    }

    private async Task ToggleHighlights()
    {
        this._isHighlightsOnly = !this._isHighlightsOnly;
        await this.Browser.SetLogHighlightsOnly(this._isHighlightsOnly);
    }

    [Parameter, EditorRequired]
    public Seating Seating { get; set; } = null!;

    [Parameter]
    public bool IsSoundOn { get; set; } = true;

    /// <summary>Whether the player is kept from taking their own team's pieces, as an enemy army they command may.</summary>
    [Parameter]
    public bool IsSafetyOn { get; set; } = true;

    /// <summary>Whether a piece clicked on is told of on a card: unless the player turned the cards off.</summary>
    [Parameter]
    public bool AreCardsShown { get; set; } = true;

    /// <summary>
    /// How the player chose to have the pieces drawn and named, the server's names being the chaturaji ones; at a
    /// game whose pieces the choice does not change (<see cref="_hasPieceSets"/>), they are as the server has them.
    /// </summary>
    [Parameter]
    public PieceSet Pieces { get; set; }

    /// <summary>The page's own settings, for the table's bar, given whether to offer the choice of pieces.</summary>
    [Parameter]
    public RenderFragment<bool>? PageSettings { get; set; }

    /// <summary>
    /// Whether the choice of pieces changes any of this game's, on the board or held prisoner: none of a game with
    /// pieces of its own, as Grand Legions has; none either until the game is shown.
    /// </summary>
    private bool _hasPieceSets;

    /// <summary>How the pieces are drawn and named here: as the player chose, if the choice changes them.</summary>
    private PieceSet PiecesShown => this._hasPieceSets ? this.Pieces : PieceSet.Chaturaji;

    /// <summary>The button opening the guide to the game, beside the game's name.</summary>
    [Parameter]
    public RenderFragment? HowToPlay { get; set; }

    [Parameter]
    public EventCallback OnLeave { get; set; }

    /// <summary>Which game the table plays, once it is first shown: none, if the catalog no longer offers it.</summary>
    [Parameter]
    public EventCallback<string?> OnGameShown { get; set; }

    /// <summary>The player sat at (or watching) another game, started from this one once it is over.</summary>
    [Parameter]
    public EventCallback<Seating> OnSeated { get; set; }

    private BoardActions Actions => this._turn?.Actions ?? NoActions;

    /// <summary>
    /// The safety switched while the player decides changes what they may do at once, and asks again what it asked.
    /// </summary>
    protected override void OnParametersSet()
    {
        this._turn = this._turn is { } turn ? this.TurnOf(turn.Claim, this._view!) : null; // a turn is had in a view
        this._eitherOf = this.IsSafetyOn == this._wasSafetyOn ? this._eitherOf : null;
        this._wasSafetyOn = this.IsSafetyOn;
    }

    /// <summary>Whether the safety was on when the page last looked, so that switching it is seen.</summary>
    private bool _wasSafetyOn = true;

    /// <summary>
    /// The player's turn: what they may do, but, while the safety is on, take a piece of their own team.
    /// </summary>
    private Turn TurnOf(SeatClaim claim, GameViewDto view) =>
        new(
            claim,
            new BoardActions(
                this.IsSafetyOn
                    ? [.. view.LegalActions.Where(action => !TakesOwnTeam(view, claim.Seat, action))]
                    : view.LegalActions
            )
        );

    /// <summary>
    /// Whether the move takes a piece of the player's own team: goes onto one, but for a swap back to back, which takes
    /// nothing (the user's report of 2026-11-19: with the safety on, no swap was offered), and is the only move onto a
    /// piece the server says anything of.
    /// </summary>
    private static bool TakesOwnTeam(GameViewDto view, int seat, ActionDto action) =>
        action is { Kind: MoveKind, Label: null }
        && view.Pieces.FirstOrDefault(piece =>
            piece.Cell == int.Parse(action.Arguments[ActionArguments.To], CultureInfo.InvariantCulture)
        ) is { } taken
        && view.Seats[taken.Owner].Team == view.Seats[seat].Team;

    protected override async Task OnInitializedAsync()
    {
        this._isHighlightsOnly = await this.Browser.IsLogHighlightsOnly();
        this._playerToken = await this.Browser.PlayerToken();
        await this.Browser.Watch(this._self);
        await this.Refresh();
        this._boardTurn = this._view is null ? BoardTurn.None : BoardTurn.HomeOf(this.Seating.Claim?.Seat, this._view);
    }

    public void Dispose()
    {
        this._poll.Dispose();
        this._self.Dispose();
    }

    /// <summary>
    /// The page shown again: a look at the game at once, unless it is over, since a hidden page's timers may
    /// have waited a minute or more between looks.
    /// </summary>
    [JSInvokable]
    public void Shown() =>
        _ = this._view is { DecidingSeat: not null } && this._poll.Change(TimeSpan.Zero, Timeout.InfiniteTimeSpan);

    /// <summary>
    /// Why a die is greyed out, none for one that is not: nothing it lets move can move; and, while doubles let a
    /// captured piece escape, that the two dice together still may do that.
    /// </summary>
    private static string? UnusableNote(GameViewDto view, DieDto die) =>
        (die.IsUsable, view.LegalActions.Any(action => action.Kind == EscapeKind)) switch
        {
            (true, _) => null,
            (_, true) => "Nothing it lets move can move now, but the doubles let a captured piece escape",
            _ => "Nothing it lets move can move now",
        };

    private string Hint(BoardActions actions) =>
        (this._selection.Choice, actions.Origins.IsEmpty, actions.OffBoard.IsEmpty && actions.Choices.IsEmpty) switch
        {
            ({ }, _, _) =>
                "Now pick its destination: click a blinking circle to bring it back there, "
                + "or any other square to cancel.",
            (_, true, _) => "Choose what to do:",
            (_, _, true) => "Pick a ringed piece, then a marked square.",
            _ => "Move a ringed piece (pick it, then a marked square), or:",
        };

    /// <summary>
    /// Chooses what to bring back (a prisoner to escape), its squares then marked on the board; chosen again, lets
    /// it go.
    /// </summary>
    private void Choose(string choice) =>
        this._selection = this._selection.Choice == choice ? BoardSelection.None : BoardSelection.Choosing(choice);

    /// <summary>
    /// How the game ended; else who is answering an offer, or whose turn is over but who may still offer;
    /// else whose move it is, and for whom if not for themselves.
    /// </summary>
    private string Status(GameViewDto view) =>
        (view.Outcome, view.DecidingSeat, this._turn, view.Offer, view.IsTurnOver) switch
        {
            ({ } outcome, _, _, _, _) => outcome.Text,
            _ when OpenSeatsOf(view) is { } open =>
                $"Waiting for {open} to join: the game begins once every seat is taken.",
            (_, { } seat, null, _, _) when view.DraftLeft is not null =>
                $"{Who(view.Seats[seat])} is drafting their army.",
            (_, { }, _, _, _) when view.DraftLeft is not null => "Your turn to draft your army.",
            (_, { } seat, null, _, _) when view.Proposal is { } proposal =>
                $"{Who(view.Seats[proposal.Proposer])} proposes ending the game: waiting for {Who(view.Seats[seat])}.",
            (_, { }, _, _, _) when view.Proposal is { } proposal =>
                $"{Who(view.Seats[proposal.Proposer])} proposes ending the game: do you agree?",
            (_, { } seat, null, _, _) when view.Returning is { } piece =>
                $"{Who(view.Seats[seat])} is choosing where their {piece.Name} goes home.",
            (_, { }, _, _, _) when view.Returning is { } piece =>
                $"Your {piece.Name} is going home: choose a marked square for it.",
            (_, { } seat, null, { } offer, _) =>
                $"{Who(view.Seats[seat])} is answering {Who(view.Seats[offer.From])}'s offer.",
            (_, { }, _, { } offer, _) => $"Answer {Who(view.Seats[offer.From])}'s offer.",
            (_, { } seat, null, _, true) => $"{Who(view.Seats[seat])}'s turn is over: they may still offer prisoners back.",
            (_, { }, _, _, true) => "Your turn is over: offer prisoners back, or be done.",
            (_, { } seat, null, _, _) => $"{Who(view.Seats[seat])} to move{ForWhom(view)}.",
            (_, { }, _, _, _) when view.ThroneHeldBy is { } holder => this.Held(view, holder),
            (_, { }, _, _, _) => $"Your move{ForWhom(view)}.",
            _ => "The game is over.",
        };

    /// <summary>
    /// "Yellow's Raja holds your throne, so you cannot move before rolling: you must roll, then move first;
    /// Yellow moves second." - or, once rolled, "...: you move first; Yellow moves second." Playing an ally's
    /// turn, the throne is the ally's: "Yellow's Raja holds Green's throne...".
    /// </summary>
    private string Held(GameViewDto view, int holder)
    {
        int owner = view.ActingFor ?? view.DecidingSeat!.Value; // held only while someone decides
        int throne = view.Cells.First(cell => cell.Throne == owner).Id;
        string leader = view.Pieces.First(piece => piece.Cell == throne).Name;
        string holders = view.Seats[holder].Name;
        string whose = view.ActingFor is { } ally ? $"{view.Seats[ally].Name}'s" : "your";
        string roll = view.LegalActions.Any(action => action.Kind == RollKind)
            ? ", so you cannot move before rolling: you must roll, then move first"
            : ": you move first";
        return this.Named($"{holders}'s {leader} holds {whose} throne{roll}; {holders} moves second.");
    }

    /// <summary>Whether the action ends the player's say in the turn: handing it over to an ally, or passing.</summary>
    private static bool IsClosing(ActionDto action) => action.Kind is PassKind or HandOverKind;

    /// <summary>
    /// What ends the player's turn, at its foot beside End game (playtest X1): handing it to an ally first, then
    /// passing; none while they draft or promote, where those are asked about apart, or when it is not their turn.
    /// </summary>
    private ImmutableList<ActionDto> Closing(GameViewDto view) =>
        this._turn is { } turn && view.DraftLeft is null && this.AtSelection(turn).IsEmpty
            ? [.. turn.Actions.OffBoard.Where(IsClosing).OrderBy(action => action.Kind == PassKind)]
            : [];

    /// <summary>
    /// Passing, the one call to action whenever no other button asks for one, pieces left to move or not (the user's
    /// word of 2026-11-20: grey, after a roll, was too understated), and urged when it is the only way on; plain
    /// while a choice waits; handing the turn over, in the colour of the ally taking it.
    /// </summary>
    private static string ClosingClassOf(ActionDto action, Passing passing) =>
        (action.Kind == PassKind, passing) switch
        {
            (true, Passing.Urged) => "action pass primary urged",
            (true, Passing.Called) => "action pass primary",
            (true, _) => "action pass",
            _ => $"action hand-over seat-{action.Arguments.GetValueOrDefault(RegentArgument)}",
        };

    /// <summary>How Pass looks: plain, the call to action, or that call urged.</summary>
    private enum Passing
    {
        Plain,
        Called,
        Urged,
    }

    /// <summary>
    /// How Pass looks with <paramref name="actions"/> open: urged when it is the way on, with nothing to move on the
    /// board (playtest 2026-11-19), and called for whenever nothing but handing over, offering prisoners or hiring
    /// one, as optional as offering, is left beside it.
    /// </summary>
    private static Passing PassingOf(BoardActions actions) =>
        (IsPassCalled(actions), actions.Origins.IsEmpty) switch
        {
            (true, true) => Passing.Urged,
            (true, false) => Passing.Called,
            _ => Passing.Plain,
        };

    /// <summary>Whether passing is the one button left to call for: nothing to choose, nothing else to do.</summary>
    private static bool IsPassCalled(BoardActions actions) =>
        actions.Choices.IsEmpty && actions.OffBoard.All(action => IsClosing(action) || action.Coming is not null);


    /// <summary>
    /// The faces typed for the dice of a roll in a scenario, each blank to be rolled (the user's request of 2026-11-19:
    /// to "roll" a double 6, say, to test a return).
    /// </summary>
    private ImmutableList<string> _faked = [string.Empty, string.Empty];

    /// <summary>Whether any face is typed, so that the roll uses them.</summary>
    private bool IsFaking => this._faked.Any(face => face.Length > 0);

    private void Fake(int die, ChangeEventArgs change) =>
        this._faked = this._faked.SetItem(die, $"{change.Value}");

    /// <summary>
    /// The roll, with the faces typed, if any, each blank or not a number rolled; the faces cleared for the next.
    /// </summary>
    private ActionDto Faked(ActionDto roll)
    {
        ImmutableList<int?> faces =
        [
            .. this._faked.Select(face =>
                int.TryParse(face, NumberStyles.Integer, CultureInfo.InvariantCulture, out int value) ? (int?)value : null
            ),
        ];
        bool isFaking = this.IsFaking;
        this._faked = [string.Empty, string.Empty];
        return isFaking ? roll with { Faked = faces } : roll;
    }

    /// <summary>Rolling, when the player may do nothing else for an enemy leader on their throne.</summary>
    private static bool IsUrged(GameViewDto view, ActionDto action) =>
        view.ThroneHeldBy is not null && action.Kind == RollKind;

    /// <summary>
    /// What a player away should know when they look again: that the others are playing on without them,
    /// that they are waited for again, having said they are back, or who would stop waiting; null if none of
    /// it is so.
    /// </summary>
    private static string? AwayNoticeOf(GameViewDto view, int seat)
    {
        SeatDto mine = view.Seats[seat];
        ImmutableList<int> stopping = view.Away is { } away && away.Seat == seat ? away.Stopping : [];
        string turns = mine.TurnsMissed == 1 ? "turn" : "turns";
        return (mine.TurnsMissed, mine.MayRejoin || mine.HasGivenUp, stopping.IsEmpty) switch
        {
            (> 0, true, _) =>
                $"The others are playing on without you: you missed {mine.TurnsMissed} {turns} in a row.",
            (> 0, _, _) => "You are back: the others will wait for you again, unless you miss another turn.",
            (_, _, false) =>
                $"{string.Join(" and ", stopping.Select(voter => Who(view.Seats[voter])))} would stop waiting for you.",
            _ => null,
        };
    }

    /// <summary>Who plays another seat, then the seat: "Argus (Yellow)", "Ada (Black)".</summary>
    private static string Who(SeatDto seat) => SeatLabels.Of(seat);

    /// <summary>"Yellow and Red": the seats no one has taken yet, for which the game waits; null if none.</summary>
    private static string? OpenSeatsOf(GameViewDto view) =>
        Listed([.. view.Seats.Where(seat => seat.Controller == OpenController).Select(seat => seat.Name)]);

    private static string? Listed(ImmutableList<string> names) => names.IsEmpty ? null : string.Join(" and ", names);

    private static string ForWhom(GameViewDto view) =>
        view.ActingFor is { } seat ? $", for {view.Seats[seat].Name}" : string.Empty;

    /// <summary>"Black offers Yellow Yellow's Pawn back, for Green's Horse.", or "..., as a gift."</summary>
    private static string OfferText(GameViewDto view, OfferDto offer)
    {
        string asking = offer.Asked.IsEmpty ? "as a gift" : $"for {Listed(view, offer.Asked)}";
        string given = Listed(view, offer.Given);
        return $"{Who(view.Seats[offer.From])} offers {Who(view.Seats[offer.To])} {given} back, {asking}.";
    }

    private static string Listed(GameViewDto view, ImmutableList<PrisonerDto> prisoners) =>
        string.Join(", ", prisoners.Select(prisoner => Owned(view, prisoner)));

    /// <summary>"Green's Elephant".</summary>
    private static string Owned(GameViewDto view, PrisonerDto prisoner) =>
        $"{view.Seats[prisoner.Owner].Name}'s {prisoner.Name}";

    /// <summary>What may be done at the piece picked up, as a promotion is; nothing if none is picked up.</summary>
    private ImmutableList<ActionDto> AtSelection(Turn turn) =>
        this._selection.Selected is { } cell ? turn.Actions.At(cell) : [];

    /// <summary>
    /// The promotions, into the player's own pieces first, then their allies', then the rest, army by army
    /// (so that each may be shown apart); within an army, as the ruleset orders them, the most valuable first.
    /// </summary>
    private static ImmutableList<ActionDto> ByKinship(GameViewDto view, int seat, ImmutableList<ActionDto> promotions) =>
        [
            .. promotions
                .OrderBy(promotion => KinshipOf(view, seat, IntoOf(view, promotion).Prisoner.Owner))
                .ThenBy(promotion => IntoOf(view, promotion).Prisoner.Owner),
        ];

    /// <summary>The promotions, army by army, in order: those into one army's pieces, apart.</summary>
    private static ImmutableList<ImmutableList<ActionDto>> ArmiesOf(GameViewDto view, ImmutableList<ActionDto> promotions) =>
        [.. promotions.GroupBy(promotion => IntoOf(view, promotion).Prisoner.Owner).Select(army => army.ToImmutableList())];

    /// <summary>0 for the player's own seat, 1 for an ally's, 2 for anyone else's.</summary>
    private static int KinshipOf(GameViewDto view, int seat, int owner) =>
        (owner == seat, view.Seats[owner].Team == view.Seats[seat].Team) switch
        {
            (true, _) => 0,
            (_, true) => 1,
            _ => 2,
        };

    /// <summary>"Promote Black's Pawn on c8 to:".</summary>
    private static string PromotionHeading(GameViewDto view, int cell)
    {
        PieceDto pawn = view.Pieces.First(piece => piece.Cell == cell);
        string name = view.Cells.First(at => at.Id == cell).Name;
        return $"Promote {view.Seats[pawn.Owner].Name}'s {pawn.Name} on {name} to:";
    }

    /// <summary>
    /// Whether the action taken at a piece promotes it, into a kind or a captured piece; not, as an escape off the
    /// board is (the user's report of 2026-11-19: a Tafl King on its corner had nothing to click to escape).
    /// </summary>
    private static bool IsPromotion(ActionDto action) =>
        action.Arguments.ContainsKey(ActionArguments.Becomes) || action.Arguments.ContainsKey(ActionArguments.Into);

    /// <summary>
    /// Whether the action taken at a piece makes it leave the board (the Tafl King from its far corner): asked about
    /// as a promotion is, apart and plain to see (the user's report of 2026-11-19).
    /// </summary>
    private static bool IsFlight(ActionDto action) => action.Kind == FleeKind;

    /// <summary>"Black's King (Tafl) on h8 may escape the board, or stay:".</summary>
    private static string FlightHeading(GameViewDto view, int cell)
    {
        PieceDto piece = view.Pieces.First(at => at.Cell == cell);
        string name = view.Cells.First(at => at.Id == cell).Name;
        return $"{view.Seats[piece.Owner].Name}'s {piece.Name} on {name} may escape the board, or stay:";
    }

    /// <summary>Whether the promotion is the piece's own, into a kind, rather than into a captured piece.</summary>
    private static bool IsOwnPromotion(ActionDto promotion) => promotion.Arguments.ContainsKey(ActionArguments.Becomes);

    /// <summary>What a piece's own promotion makes it: the kind as the game tells it, or, untold, by its id alone.</summary>
    private static PieceKindDto BecomingOf(GameViewDto view, ActionDto promotion)
    {
        string kind = promotion.Arguments[ActionArguments.Becomes];
        return view.Kinds.Find(told => told.Kind == kind) ?? new PieceKindDto(kind, kind, 0);
    }

    /// <summary>The captured piece a promotion brings back, and the seat holding it.</summary>
    private static (SeatDto Holder, PrisonerDto Prisoner) IntoOf(GameViewDto view, ActionDto promotion) =>
        view.Seats
            .SelectMany(seat => seat.Prisoners.Select(prisoner => (seat, prisoner)))
            .First(held =>
                held.prisoner.Id.ToString(CultureInfo.InvariantCulture) == promotion.Arguments[ActionArguments.Into]
            );

    /// <summary>"held by Red", or "held by you" if the player's own <paramref name="seat"/> holds it.</summary>
    private static string HeldBy(SeatDto holder, int seat) =>
        $"held by {(holder.Id == seat ? "you" : Who(holder))}";

    private void PutDown() => this._selection = BoardSelection.None;

    private void PutAway() => this._inspected = null;

    /// <summary>The bots in the game paid for each use, by name: playing again would cost tokens again.</summary>
    private static ImmutableList<string> PaidBotsOf(GameViewDto view) =>
        [.. view.Seats.Where(seat => seat.IsPaidBot).Select(seat => seat.Bot).OfType<string>()];

    /// <summary>
    /// "Drafting armies, points left: Black 120, Yellow 95, Green 125, Red 110": what each seat still has to spend.
    /// </summary>
    /// <summary>
    /// What is being placed, as the board shows it: while the player drafts, their throne, chosen at once, as it is the
    /// only choice; else the piece they picked to draft, while they can still place it; else what they picked.
    /// </summary>
    private BoardSelection Selection =>
        (this._selection, this._view, this._turn) switch
        {
            ({ Selected: null, Choice: null }, { DraftLeft: not null } view, not null)
                when DraftChoiceOf(view, this._draftPick) is { } choice => BoardSelection.Choosing(choice),
            _ => this._selection,
        };

    /// <summary>
    /// The choice placing the palace or the throne, if it is to be set; else placing <paramref name="pick"/>, if it may
    /// be.
    /// </summary>
    private static string? DraftChoiceOf(GameViewDto view, string? pick) =>
        view.LegalActions
            .FirstOrDefault(action => (action.Kind is PalaceKind or ThroneKind && !IsBuying(view))
                || (action.Kind == DraftKind && action.Arguments.GetValueOrDefault(PieceArgument) == pick))
            ?.Choice;

    /// <summary>
    /// Whether the player, drafting, has their palace and throne, and buys pieces now: they may buy one, or be done. A
    /// palace or throne they are offered then moves it, drafting all at once.
    /// </summary>
    private static bool IsBuying(GameViewDto view) =>
        view.LegalActions.Any(action => action.Kind is DraftKind or PassKind);

    /// <summary>
    /// How the player, buying pieces while drafting all at once, may change their mind: take back a piece, move their
    /// throne or palace; each a choice, then a square.
    /// </summary>
    private static ImmutableList<string> ChangesOf(GameViewDto view) =>
    [
        .. view.LegalActions
            .Where(action => action.Kind != DraftKind)
            .Select(action => action.Choice)
            .OfType<string>()
            .Distinct(StringComparer.Ordinal),
    ];

    /// <summary>Chooses a change of mind, its squares then marked on the board, letting go of any piece picked.</summary>
    private void ChooseChange(string choice)
    {
        this._draftPick = null;
        this.Choose(choice);
    }

    /// <summary>Picks a kind to draft next, its card shown; picked again, lets it go.</summary>
    private void PickToDraft(string kind)
    {
        this._draftPick = this._draftPick == kind ? null : kind;
        this._isPlacingCardClosed = false;
        this._selection = BoardSelection.None;
    }

    /// <summary>Lets go of the kind picked to draft, as the filters no longer show it.</summary>
    private void LetGoOfDraftPick()
    {
        this._draftPick = null;
        this._selection = BoardSelection.None;
    }

    private void ClosePlacingCard() => this._isPlacingCardClosed = true;

    /// <summary>
    /// The piece the player is placing, and what the ruleset tells of its kind, for its card: the kind they picked to
    /// draft, while they draft; else their piece going home, ransomed, or the prisoner they chose to escape. None, if
    /// they are placing nothing.
    /// </summary>
    private (PieceDto Piece, PieceKindDto? Kind)? Placing(GameViewDto view) =>
        (this._turn, view.DraftLeft) switch
        {
            (null, _) => null,
            ({ } turn, not null) => view.DraftKinds.Find(kind => kind.Kind == this._draftPick) is { } drafted
                ? (new PieceDto(-1, drafted.Kind, drafted.Name, turn.Claim.Seat, -1) { Mark = drafted.Mark }, drafted)
                : null,
            _ => (view.Returning ?? ComingOf(view, this._selection.Choice)) is { } going
                ? (
                    new PieceDto(going.Id, going.Kind, going.Name, going.Owner, -1) { Mark = going.Mark },
                    view.Kinds.Find(kind => kind.Kind == going.Kind)
                )
                : null,
        };

    /// <summary>
    /// The piece <paramref name="choice"/> brings onto the board: a prisoner escaping, a piece fled coming back, or one
    /// hired (J1); none, if it brings none.
    /// </summary>
    private static PrisonerDto? ComingOf(GameViewDto view, string? choice) =>
        view.LegalActions.FirstOrDefault(action => action.Choice is { } chooses
            && chooses == choice
            && action.Coming is not null)?.Coming;

    /// <summary>
    /// The same game again: its ruleset, its bots in the same seats, the player at the same seat, its seats for people
    /// only for players signed in if they were; for a game dealt its armies, armies alike if they were, and the very
    /// same armies if <paramref name="isSameArmies"/>; for armies drafted, drafted anew as they were, with the same
    /// budget and drafter (Stated, 2026-11-12), unless the very same armies are asked for. A game started from a
    /// scenario starts from it again (the user's report of 2026-11-19).
    /// </summary>
    private Task PlayAgain(GameViewDto view, bool isSameArmies = false) =>
        this.SitAgain(async () => await GameStarter.Start(
            this.Games,
            view.RulesetId,
            [.. view.Seats.Select(seat => seat.BotId)],
            this.Seating.Claim is { } claim ? claim.Seat : -1,
            view.Scenario,
            await this.Browser.Claimant(),
            view.Id,
            new ArmyDeal(view.AreArmiesAlike, isSameArmies ? view.Id : null)
            {
                IsDrafted = view.IsDrafted,
                Budget = view.DraftBudget,
                Drafter = view.Drafter,
                IsSecret = view.IsDraftSecret,
                IsHiddenFromAllies = view.IsDraftHiddenFromAllies,
                Board = view.Board,
                PromotesAtSide = view.PromotesAtSide,
                AreDiceOff = view.AreDiceOff,
                IdleRounds = view.IdleRounds,
                IsLostWithoutLeaders = view.IsLostWithoutLeaders,
                IdleSeconds = view.IdleSeconds,
                StartRows = view.StartRows,
                FaceOffPause = view.FaceOffPause,
            },
            view.IsForPlayers
        ));

    /// <summary>A quick game, medium, of the same game as this: the server's first, should it offer this no more.</summary>
    private Task QuickGame(GameViewDto view) =>
        this.SitAgain(async () =>
        {
            CatalogDto catalog = await this.Games.Catalog(CancellationToken.None);
            RulesetDto ruleset =
                catalog.Rulesets.FirstOrDefault(offered => offered.Id == view.RulesetId) ?? catalog.Rulesets[0];
            return await GameStarter.Quick(
                this.Games,
                catalog,
                ruleset,
                Difficulty.Medium,
                await this.Browser.Claimant()
            );
        });

    /// <summary>
    /// Whether the person may take the seat over from its bot: watching, not playing, a game not over; and signed in,
    /// if the game is only for players signed in.
    /// </summary>
    private bool MayTakeOver(GameViewDto view, SeatDto seat) =>
        (this._playerToken is not null || !view.IsForPlayers)
        && this.Seating.Claim is null
        && view.Outcome is null
        && seat.BotId is not null;

    /// <summary>
    /// The seat taken over from its bot, the person sitting at it from now on: as the player signed in, if one is,
    /// else as a guest, by their nickname, if they gave one.
    /// </summary>
    private Task TakeOver(GameViewDto view, int seat) =>
        this.SitAgain(async () =>
        {
            Claimant claimant = await this.Browser.Claimant();
            SeatClaimedDto taken = await this.Games.TakeOver(
                view.Id,
                seat,
                claimant.PlayerToken,
                claimant.Claim,
                CancellationToken.None
            );
            return new Seating(view.Id, new SeatClaim(seat, taken.Token));
        });

    private async Task SitAgain(Func<Task<Seating>> seating) =>
        this._problem = await Requests.Attempt(async () => await this.OnSeated.InvokeAsync(await seating()));

    private string Named(string text) => PieceStyle.Named(text, this.PiecesShown);

    private void Dismiss() => this._notice = null;

    /// <summary>
    /// What to tell the player: that they have just lost dice they could not use, or, as the decision comes
    /// back to them, that their offer was declined; nothing on first sight of the game, or once their turn
    /// comes round again; else what they were told already.
    /// </summary>
    private string? NoticeOf(GameViewDto view, bool isFirst, bool wasTheirTurn)
    {
        EventDto? lost = view.Log.LastOrDefault(happened =>
            happened.Number > this._heard
            && happened.Kind == EventDto.Forfeited
            && happened.Seat == this.Seating.Claim?.Seat
        );
        EventDto? declined = view.Log.LastOrDefault(happened =>
            happened.Number > this._heard && happened.Kind == EventDto.Declined
        );
        bool isBack = this._turn is not null && !wasTheirTurn;
        return (isFirst, lost, declined, isBack) switch
        {
            (true, _, _, _) => null,
            (_, { } forfeited, _, _) => forfeited.Text,
            (_, _, { } refusal, true) => refusal.Text,
            (_, _, _, true) => null,
            _ => this._notice,
        };
    }

    /// <summary>Whether the seat's team leads on points.</summary>
    private static bool IsAhead(GameViewDto view, SeatDto seat) =>
        view.Seats.Sum(other => other.Team == seat.Team ? other.Score : -other.Score) > 0;

    /// <summary>The seats the player holds prisoners of, to give them back to: themselves too.</summary>
    private static IEnumerable<SeatDto> Receivers(GameViewDto view, int seat) =>
        view.Seats[seat].Prisoners.Select(prisoner => prisoner.Owner).Distinct().Order().Select(owner => view.Seats[owner]);

    private static IEnumerable<PrisonerDto> HeldOf(GameViewDto view, int seat, int owner) =>
        view.Seats[seat].Prisoners.Where(prisoner => prisoner.Owner == owner);

    /// <summary>
    /// The prisoners the chosen receiver holds of the player's team: what the player may ask for; none until a
    /// receiver is chosen, nor of the player themselves.
    /// </summary>
    private ImmutableList<PrisonerDto> Askable(GameViewDto view, int seat) =>
        this._receiver is { } receiver && receiver != seat
            ? [.. view.Seats[receiver].Prisoners.Where(prisoner => view.Seats[prisoner.Owner].Team == view.Seats[seat].Team)]
            : [];

    /// <summary>A prisoner to choose, chosen, or greyed out while it may not go back yet.</summary>
    private static string ClassOf(PrisonerDto prisoner, ImmutableHashSet<int> chosen) =>
        (prisoner.MayGoBack, chosen.Contains(prisoner.Id)) switch
        {
            (false, _) => "prisoner waiting",
            (_, true) => "prisoner chosen",
            _ => "prisoner",
        };

    private static string TitleOf(PrisonerDto prisoner) =>
        prisoner.MayGoBack ? prisoner.Name : $"{prisoner.Name}: loyalty under investigation";

    /// <summary>Chooses prisoners to give back, or no longer; choosing another seat's starts afresh.</summary>
    private void Give(int receiver, ImmutableHashSet<int> prisoners)
    {
        bool isSameReceiver = this._receiver == receiver;
        this._asked = isSameReceiver ? this._asked : [];
        this._given = isSameReceiver ? this._given.SymmetricExcept(prisoners) : prisoners;
        this._receiver = receiver;
    }

    private void GiveAll(GameViewDto view, int seat, int receiver)
    {
        ImmutableHashSet<int> all =
            [.. HeldOf(view, seat, receiver).Where(prisoner => prisoner.MayGoBack).Select(prisoner => prisoner.Id)];
        this.Give(receiver, this._receiver == receiver ? all.Except(this._given) : all);
    }

    private void Ask(int prisoner) => this._asked = this._asked.SymmetricExcept([prisoner]);

    /// <summary>Chooses a prisoner to give back, or no longer, showing its card (J2).</summary>
    private void GiveOne(int receiver, PrisonerDto prisoner)
    {
        this.ShowOffBoard(prisoner);
        this.Give(receiver, [prisoner.Id]);
    }

    /// <summary>Chooses a prisoner to ask for, or no longer, showing its card (J2).</summary>
    private void AskOne(PrisonerDto prisoner)
    {
        this.ShowOffBoard(prisoner);
        this.Ask(prisoner.Id);
    }

    /// <summary>
    /// Shows the card of a piece off the board, in place of any piece on it looked at: the one just moved, most often,
    /// whose card would otherwise hide it (playtest 2026-11-19, T3).
    /// </summary>
    private void ShowOffBoard(PrisonerDto? piece)
    {
        this._inspected = piece is null ? this._inspected : null;
        this._offBoardShown = piece;
    }

    /// <summary>
    /// Chooses a prisoner to hire, showing its card (with cards on) and the price, for the player to hire it then (J2),
    /// its card in place of any other open; chosen again while its card is up, lets it go. Chosen with its card closed,
    /// shows the card again (the user's report of 2026-11-19, of a Dragon Horse whose card would not open).
    /// </summary>
    private void ChooseHire(PrisonerDto prisoner)
    {
        bool isLetGo = this._hireChosen == prisoner.Id && this._offBoardShown?.Id == prisoner.Id;
        this._hireChosen = isLetGo ? null : prisoner.Id;
        this.ShowOffBoard(isLetGo ? null : prisoner);
    }

    private void PutAwayOffBoard()
    {
        this._offBoardShown = null;
        this._isAboutAsked = false;
    }

    /// <summary>
    /// A small button beside a promotion's choice, showing the card of the piece it would make, cards on or off, for
    /// the player to look before choosing (J3).
    /// </summary>
    private RenderFragment AboutButton(PrisonerDto piece) =>
        @<button class="about" title="About the @this.Named(piece.Name)" @onclick="() => this.About(piece)">?</button>;

    private void About(PrisonerDto piece)
    {
        this.ShowOffBoard(piece);
        this._isAboutAsked = true;
    }

    private void AskToEnd() => this._isProposing = true;

    private void AskToReport()
    {
        this._isReporting = true;
        this._bugText = string.Empty;
        this._bugReported = null;
        this._bugProblem = null;
    }

    private void CloseReport() => this._isReporting = false;

    /// <summary>
    /// Sends the report, with what the page shows: the game's version it last had, the cell selected and the piece
    /// whose card is open; the server keeps the game as it stands beside them. If the sign-in has lapsed, says so.
    /// </summary>
    /// <summary>Puts the invitation to the game on the clipboard, saying whether the page could.</summary>
    private async Task CopyInvitation(GameViewDto view) =>
        this._isInvitationCopied =
            await this.Browser.Copy(GameCode.InvitationTo(this.Seating.GameId, view.RulesetName, this.Server.Value));

    private async Task SendReport()
    {
        string token = this._playerToken!; // the button shows only to a player signed in, beside the game shown
        ReportBugRequest request = new(this._bugText)
        {
            ViewVersion = this._view!.Version,
            SelectedCell = this._selection.Selected,
            InspectedPiece = this._inspected,
        };
        BugReportedDto? reported = null;
        this._bugProblem = await Requests.Attempt(async () =>
            reported = await this.Games.ReportBug(this.Seating.GameId, token, request, CancellationToken.None)
        );
        this._bugProblem ??= reported is null ? "Your sign-in has lapsed: sign in again to report this." : null;
        this._bugReported = reported?.Id;
    }

    private void KeepPlaying() => this._isProposing = false;

    private Task ProposeEnd(SeatClaim claim, bool resigns)
    {
        this._isProposing = false;
        return this.Submit(claim, EndProposalDto.ActionOf(claim.Seat, resigns));
    }

    /// <summary>Each team's points, the player's own first: "Black &amp; Green 39, Yellow &amp; Red 20".</summary>
    /// <summary>
    /// The end button's classes: whether ending now wins, draws or loses for the player's team, and, a sure thing,
    /// flashing.
    /// </summary>
    private static string EndGameClassOf(EndOutlook outlook) =>
        $"end-game {outlook.Standing.ToString().ToLowerInvariant()}{(outlook.IsSure ? " sure" : string.Empty)}";

    /// <summary>
    /// How far the end button goes from pale amber towards green, for a victory, or red, for a defeat: as far as the
    /// others are likely to agree.
    /// </summary>
    private static string EndGameStyleOf(EndOutlook outlook) =>
        string.Create(CultureInfo.InvariantCulture, $"--certainty: {Math.Round(outlook.Certainty * 100)}%");

    /// <summary>
    /// Makes the offer chosen, unless it was made already this turn: the rules allow an offer only once a turn,
    /// so the player is told instead.
    /// </summary>
    private Task Offer(SeatClaim claim)
    {
        int receiver = this._receiver!.Value;
        ActionDto offer = OfferDto.ActionOf(claim.Seat, receiver, this._given.Order(), this._asked.Order());
        string made = string.Join('|', offer.Arguments.Values);
        return this._offersMade.Contains(made)
            ? this.Refused($"{Who(this._view!.Seats[receiver])} declined that offer already!")
            : this.Made(claim, offer, made);
    }

    private Task Refused(string problem)
    {
        this._problem = problem;
        return Task.CompletedTask;
    }

    private async Task Made(SeatClaim claim, ActionDto offer, string made)
    {
        await this.Submit(claim, offer);
        this._offersMade = this._problem is null ? this._offersMade.Add(made) : this._offersMade;
    }

    /// <summary>"12 s left", while the deciding seat's decision is timed.</summary>
    private string? Countdown() =>
        this._deadline is { } deadline
            ? $"{Math.Max(0, (int)Math.Ceiling((deadline - this.Clock.GetUtcNow()).TotalSeconds))} s left"
            : null;

    /// <summary>The seats by team, the player's own team first, each team's seats in the order they sit.</summary>
    private IEnumerable<IGrouping<int, SeatDto>> TeamsOf(GameViewDto view) =>
        view.Seats.GroupBy(seat => seat.Team).OrderByDescending(this.IsMine).ThenBy(team => team.Key);

    private bool IsMine(IGrouping<int, SeatDto> team) => team.Any(seat => seat.Id == this.Seating.Claim?.Seat);

    /// <summary>
    /// The team's seats, the player's own first, so that they always find themselves at the top left (Stated,
    /// 2026-11-13); the rest in order.
    /// </summary>
    private IEnumerable<SeatDto> SeatsOf(IGrouping<int, SeatDto> team) =>
        team.OrderByDescending(seat => seat.Id == this.Seating.Claim?.Seat);

    /// <summary>Who plays the seat: you, by name; the bot; the player by name (or a guest); or no one yet ("open").</summary>
    private string Player(SeatDto seat) =>
        seat.Id == this.Seating.Claim?.Seat ? SeatLabels.Mine(seat) : SeatLabels.Person(seat);

    /// <summary>
    /// Why the game waits, for the player it waits for (<paramref name="isMine"/>) and for everyone else: a General
    /// facing an enemy leader may call a face-off even out of turn, and the pause gives its player time to.
    /// </summary>
    private static string PauseWhy(bool isMine, string player) =>
        isMine
            ? "Your General faces an enemy leader: you may call the face-off now, out of turn. The game waits for you."
            : $"{player}'s General faces an enemy leader: the game waits while they decide on a face-off.";

    private void TurnLeft() => this._boardTurn = this._boardTurn.Anticlockwise();

    private void TurnRight() => this._boardTurn = this._boardTurn.Clockwise();

    private void TurnHome(GameViewDto view) => this._boardTurn = BoardTurn.HomeOf(this.Seating.Claim?.Seat, view);

    private void Tick(object? state) => _ = this.InvokeAsync(this.Next);

    /// <summary>
    /// Lets a deciding bot take its next step, or the server decide once time is up; else, on the player's own
    /// timed turn, counts down; else looks for what others have done (on the player's own turn, whether
    /// they would stop waiting for them).
    /// </summary>
    private async Task Next()
    {
        GameViewDto view = this._view!;
        bool isDue = this._isBotDeciding || this._deadline <= this.Clock.GetUtcNow();
        await ((isDue, this._turn, this._deadline) switch
        {
            (true, _, _) => this.Request(
                () => this.Games.Advance(
                    this.Seating.GameId,
                    view.Version,
                    this.Seating.Claim?.Token,
                    CancellationToken.None
                )
            ),
            (_, { }, { }) => this.CountDown(view),
            _ => this.Refresh(),
        });
        this.StateHasChanged();
    }

    private Task CountDown(GameViewDto view)
    {
        _ = this._poll.Change(this.Wait(view), Timeout.InfiniteTimeSpan);
        return Task.CompletedTask;
    }

    private Task Refresh() =>
        this.Request(() => this.Games.Get(this.Seating.GameId, this.Seating.Claim?.Token, CancellationToken.None));

    /// <summary>
    /// A cell clicked on: the piece on it, if any, is told of, whether or not it may be moved; and the move being
    /// made goes on.
    /// </summary>
    private Task Click(int cell)
    {
        this._inspected = this._view!.Pieces.Find(piece => piece.Cell == cell)?.Id ?? this._inspected;
        this.PutAwayOffBoard(); // a click on the board shows its card, or the one of the piece being placed
        int? from = this.Selection.Selected;
        (BoardSelection next, ActionDto? chosen) = this.Selection.Click(cell, this.Actions);
        this._selection = next;
        this._palace = chosen is { Kind: PalaceKind } palace ? (cell, palace) : this._palace;
        ImmutableList<ActionDto> either = from is { } start && chosen is not null
            ? this.Actions.AllBetween(start, cell)
            : [];
        this._eitherOf = either.Count > 1 ? either : null;
        return this._turn is { } turn && chosen is { Kind: not PalaceKind } action && this._eitherOf is null
            ? this.Submit(turn.Claim, action)
            : Task.CompletedTask;
    }

    /// <summary>
    /// The moves the player must choose between, onto one piece, as swapping places with an ally or taking it (the
    /// user's request of 2026-11-19: with Safety off, ask "Swap or capture?"); none, while there is nothing to ask.
    /// </summary>
    private ImmutableList<ActionDto>? _eitherOf;

    /// <summary>One of the moves the player had to choose between, chosen.</summary>
    private Task ChooseEither(SeatClaim claim, ActionDto action)
    {
        this._eitherOf = null;
        return this.Submit(claim, action);
    }

    /// <summary>Builds the palace where the player placed it.</summary>
    private Task BuildPalace(SeatClaim claim, ActionDto palace)
    {
        this._palace = null;
        return this.Submit(claim, palace);
    }

    /// <summary>
    /// What placing on <paramref name="cell"/> would put there (I): the palace's wall, the player's throne, or the piece
    /// coming onto the board; nothing, if nothing would be placed there.
    /// </summary>
    private BoardPreview? PreviewOf(GameViewDto view, int cell) =>
        (this.Selection.Choice is { } choice ? this.Actions.PlacementAt(choice, cell) : null) switch
        {
            { Kind: PalaceKind } => new BoardPreview { Lines = [.. PalaceWalls(view, cell)] },
            { Kind: ThroneKind } throne => new BoardPreview
            {
                ThroneOf = int.Parse(throne.Arguments[ActionArguments.Actor], CultureInfo.InvariantCulture),
            },
            _ => this.Placing(view) is { } placing ? new BoardPreview(placing.Piece with { Cell = cell }) : null,
        };

    /// <summary>The board as the game has it; and, while the player places their palace, its wall.</summary>
    private GameViewDto Drawn(GameViewDto view) =>
        this._palace is { } palace ? view with { Lines = view.Lines.AddRange(PalaceWalls(view, palace.Cell)) } : view;

    /// <summary>
    /// The wall of a palace about <paramref name="centre"/>, as the server draws one: every edge of its squares (those
    /// of the board within a step of the centre) that no other of them shares, each going counter-clockwise about it.
    /// </summary>
    private static IEnumerable<LineDto> PalaceWalls(GameViewDto view, int centre)
    {
        CellDto at = view.Cells.First(cell => cell.Id == centre);
        ImmutableHashSet<(double X, double Y)> squares =
        [
            .. view.Cells
                .Where(cell => Math.Abs(cell.X - at.X) <= 1 && Math.Abs(cell.Y - at.Y) <= 1)
                .Select(cell => (cell.X, cell.Y)),
        ];
        return squares
            .OrderBy(square => square.Y)
            .ThenBy(square => square.X)
            .SelectMany(square => WallsOf(square, squares));
    }

    private static IEnumerable<LineDto> WallsOf((double X, double Y) square, ImmutableHashSet<(double X, double Y)> all)
    {
        const double half = 0.5;
        (double x, double y) = square;
        return new (double Dx, double Dy, LineDto Wall)[]
            {
                (0, -1, new LineDto(PalaceKind, x - half, y - half, x + half, y - half)),
                (1, 0, new LineDto(PalaceKind, x + half, y - half, x + half, y + half)),
                (0, 1, new LineDto(PalaceKind, x + half, y + half, x - half, y + half)),
                (-1, 0, new LineDto(PalaceKind, x - half, y + half, x - half, y - half)),
            }
            .Where(side => !all.Contains((x + side.Dx, y + side.Dy)))
            .Select(side => side.Wall);
    }

    /// <summary>Whether the player may fill the open seats with bots now: first to arrive, or after twice the wait.</summary>
    private static bool MayFill(VacancyDto vacancy, int seat) => SecondsUntilFill(vacancy, seat) <= 0;

    private static double SecondsUntilFill(VacancyDto vacancy, int seat) =>
        seat == vacancy.FirstArrival ? vacancy.SecondsUntilFirst : vacancy.SecondsUntilAnyone;

    /// <summary>"If no one comes, you may fill the open seats with bots in 45 s."</summary>
    private static string FillWait(VacancyDto vacancy, int seat)
    {
        int seconds = (int)Math.Ceiling(SecondsUntilFill(vacancy, seat));
        return $"If no one comes, you may fill the open seats with bots in {seconds} s.";
    }

    private Task Fill(SeatClaim claim) =>
        this.Request(() => this.Games.FillOpenSeats(this.Seating.GameId, claim.Token, CancellationToken.None));

    /// <summary>
    /// "Yellow is taking a long time. Keep waiting for them?", while they decide; "Yellow is away. Keep waiting for them
    /// on their turns?", while another does.
    /// </summary>
    private static string AwayQuestion(GameViewDto view, AwayDto away) =>
        view.DecidingSeat == away.Seat
            ? $"{Who(view.Seats[away.Seat])} is taking a long time. Keep waiting for them?"
            : $"{Who(view.Seats[away.Seat])} is away. Keep waiting for them on their turns?";

    /// <summary>
    /// What stopping waiting does, and how far the others agree; and what a bot playing for them does instead.
    /// </summary>
    private static string AwayHint(AwayDto away) =>
        "Stop waiting, and their turns pass, unplayed, until they come back; it takes all of you "
            + $"({away.Stopping.Count} of {away.Voters.Count} so far). A bot playing for them instead takes their seat "
            + "for the rest of the game.";

    /// <summary>"If they do not come back, you may have a bot play for them in 4 min 30 s."</summary>
    private static string ReplaceWait(AwayDto away)
    {
        TimeSpan left = TimeSpan.FromSeconds(Math.Ceiling(away.SecondsUntilAnyoneReplaces));
        string minutes = left.Minutes > 0 ? $"{left.Minutes} min " : string.Empty;
        return $"If they do not come back, you may have a bot play for them in {minutes}{left.Seconds} s.";
    }

    private Task Replace(SeatClaim claim) =>
        this.Request(() => this.Games.ReplaceAway(this.Seating.GameId, claim.Token, CancellationToken.None));

    private Task Submit(SeatClaim claim, ActionDto action) =>
        this.Request(() => this.Games.Submit(this.Seating.GameId, claim.Token, action, CancellationToken.None));

    /// <summary>
    /// Takes a chance, a leader face-off or an <i>en passant</i>; should it have gone meanwhile, the other leader or
    /// the passing piece having moved first, says so kindly.
    /// </summary>
    private async Task Seize(SeatClaim claim, ActionDto chance)
    {
        await this.Submit(claim, chance);
        this._problem = (this._problem, chance.Kind) switch
        {
            (null, _) => null,
            (_, "face-off") => "Too late, sorry: the two leaders no longer face each other.",
            _ => "Too late, sorry: that piece can no longer be taken in passing.",
        };
    }

    /// <summary>
    /// Makes the request, and shows the game it answers with; if it fails, says why, and looks again
    /// when it would have anyway, so that a game waiting on others does not stop when one request does.
    /// </summary>
    private async Task Request(Func<Task<GameViewDto>> request)
    {
        this._problem = await Requests.Attempt(async () => await this.ShowUnlessGone(request));
        _ = this._problem is not null && this._view is { } view
            && this._poll.Change(this.Wait(view), Timeout.InfiniteTimeSpan);
    }

    private async Task ShowUnlessGone(Func<Task<GameViewDto>> request)
    {
        try
        {
            await this.Show(await request());
        }
        catch (GameRequestRefusedException refused)
            when (refused.Refusal is Refusal.NotFound or Refusal.Gone)
        {
            this._gone = refused.Refusal == Refusal.Gone
                ? refused.Message
                : "This game is gone: the server no longer has it, perhaps because it was restarted.";
            _ = this._poll.Change(Timeout.InfiniteTimeSpan, Timeout.InfiniteTimeSpan);
        }
    }

    private async Task Show(GameViewDto view)
    {
        bool wasTheirTurn = this._turn is not null;
        bool isFirst = this._view is null;
        bool isNew = view.Version != this._view?.Version;
        this._view = view;
        this._hasPieceSets = PieceStyle.HasChessForms(
            view.Pieces.Select(piece => piece.Kind)
                .Concat(view.Seats.SelectMany(holder => holder.Prisoners).Select(prisoner => prisoner.Kind))
        );
        this._deadline = view.SecondsLeft is { } seconds ? this.Clock.GetUtcNow().AddSeconds(seconds) : null;
        this._palace = isNew ? null : this._palace;
        this._receiver = isNew ? null : this._receiver;
        this._given = isNew ? [] : this._given;
        this._asked = isNew ? [] : this._asked;
        this._offBoardShown = isNew ? null : this._offBoardShown;
        this._isAboutAsked = !isNew && this._isAboutAsked;
        this._hireChosen = isNew ? null : this._hireChosen;
        this._offersMade = view.TurnNumber == this._offersTurn ? this._offersMade : [];
        this._offersTurn = view.TurnNumber;
        this._turn = view.DecidingSeat is { } deciding && this.Seating.Claim is { } claim && claim.Seat == deciding
            ? this.TurnOf(claim, view)
            : null;
        // a bot plays only once every seat is taken
        this._isBotDeciding = view.DecidingSeat is { } seat
            && view.Seats[seat].Controller == BotController
            && OpenSeatsOf(view) is null;
        this._eitherOf = isNew ? null : this._eitherOf;
        this._selection = (isNew, this._turn, view.PromotionDue ?? view.Fleeing) switch
        {
            (false, { }, _) => this._selection,
            (_, { }, { } due) => new BoardSelection(due),
            _ => BoardSelection.None,
        };
        this._lastMove = view.Log.LastOrDefault(happened => happened.Kind == EventDto.Moved) is { } moved
            ? [moved.From!.Value, moved.To!.Value]
            : [];
        ImmutableList<string> sounds = this.SoundsOf(view, isFirst, wasTheirTurn);
        this._notice = this.NoticeOf(view, isFirst, wasTheirTurn);
        this._heard = view.Log.Count > 0 ? view.Log[^1].Number : this._heard;
        await (!sounds.IsEmpty && this.IsSoundOn ? this.Browser.Play(sounds) : ValueTask.CompletedTask);
        _ = this._poll.Change(this.Wait(view), Timeout.InfiniteTimeSpan);
        await (isFirst && this.OnGameShown.HasDelegate ? this.ShowGame(view) : Task.CompletedTask);
    }

    /// <summary>Tells the page which game this is, as the catalog names it, so that its guide is to this game.</summary>
    private async Task ShowGame(GameViewDto view)
    {
        CatalogDto catalog = await this.Games.Catalog(CancellationToken.None);
        await this.OnGameShown.InvokeAsync(
            catalog.Rulesets
                .Where(offered => offered.Id == view.RulesetId)
                .Select(offered => offered.Game)
                .FirstOrDefault()
        );
    }

    /// <summary>
    /// The sounds for what happened since the last view, one after another: what befell a piece (a Raja of the
    /// player's team taken, an enemy Raja back on the board, an enemy's piece escaping, an enemy Raja taken, a
    /// Raja of the player's team back, or a piece of it escaping), then how power shifted (an empire, or
    /// command of an army, begun or ended, for the player's team or against it); else a turn come round, a
    /// capture, a move, a roll.
    /// </summary>
    private ImmutableList<string> SoundsOf(GameViewDto view, bool isFirst, bool wasTheirTurn)
    {
        ImmutableList<EventDto> fresh = [.. view.Log.Where(happened => happened.Number > this._heard)];
        ImmutableHashSet<int> ours = [.. this.TeamsOf(view).Where(this.IsMine).SelectMany(team => team).Select(seat => seat.Id)];
        ImmutableHashSet<string> kinds =
        [
            .. fresh.Select(happened => happened.Kind),
            .. fresh.Where(happened => happened is { Kind: EventDto.Escaped, IsLeader: false })
                .Select(escaped => TeamSoundOf(ours, escaped.Owner, (EventDto.Moved, Rescued, Alarm))),
            .. fresh.Where(happened => happened is { Kind: EventDto.Escaped or EventDto.Ransom, IsLeader: true })
                .Select(back => TeamSoundOf(ours, back.Owner, (EventDto.Moved, Restored, Dread))),
            .. fresh.Where(happened => happened is { Kind: EventDto.Captured, IsLeader: true })
                .Select(taken => TeamSoundOf(ours, taken.Owner, (EventDto.Captured, Lament, Triumph))),
            .. fresh.Where(happened => happened is { Kind: EventDto.Captured, IsLeader: false })
                .Select(taken => TeamSoundOf(ours, taken.Owner, (EventDto.Captured, Lost, EventDto.Captured))),
            .. fresh.Where(happened => happened.Kind == EventDto.Ended)
                .Select(_ => this.ResultOf(view.Outcome!)),
            .. fresh.Where(happened => happened.Kind == EventDto.Command)
                .Select(command => PowerSoundOf(ours, command, (Rally, Menace))),
            .. fresh.Where(happened => happened.Kind == EventDto.Empire)
                .Select(empire => PowerSoundOf(ours, empire, (Glory, Doom))),
        ];
        ImmutableList<string> telling =
        [
            .. new[] { Lament, Dread, Alarm, Triumph, Restored, Rescued, Lost }.Where(kinds.Contains).Take(1),
            .. new[] { Doom, Menace, Glory, Rally }.Where(kinds.Contains).Take(1),
            .. new[] { Victory, Defeat }.Where(kinds.Contains).Take(1),
        ];
        return (isFirst, telling.IsEmpty, this._turn is not null && !wasTheirTurn) switch
        {
            (true, _, _) => [],
            (_, false, _) => telling,
            (_, _, true) => ["turn"],
            _ => [.. new[] { EventDto.Captured, EventDto.Moved, EventDto.Rolled }.Where(kinds.Contains).Take(1)],
        };
    }

    /// <summary>
    /// How the game ended for whoever looks: <c>victory</c> or <c>defeat</c> for a player, <c>draw</c> for
    /// anyone, <c>watched</c> for someone only watching a game someone won.
    /// </summary>
    private string ResultOf(OutcomeDto outcome) =>
        (this.Seating.Claim, outcome.Winners.IsEmpty) switch
        {
            (_, true) => "draw",
            (null, _) => "watched",
            ({ } claim, _) when outcome.Winners.Contains(claim.Seat) => Victory,
            _ => Defeat,
        };

    /// <summary>"Victory!", "Defeat" or "A draw"; for someone only watching, "Black & Green won".</summary>
    private string VerdictOf(GameViewDto view, OutcomeDto outcome) =>
        this.ResultOf(outcome) switch
        {
            Victory => "Victory!",
            Defeat => "Defeat",
            "draw" => "A draw",
            _ => $"{string.Join(" & ", outcome.Winners.Select(seat => view.Seats[seat].Name))} won",
        };

    /// <summary>Whether the team won the game, now over.</summary>
    private static bool HasWon(GameViewDto view, IGrouping<int, SeatDto> team) =>
        view.Outcome is { } outcome && team.Any(seat => outcome.Winners.Contains(seat.Id));

    /// <summary>
    /// The sound for a shift of power: good for the player's team, if the commander or rulers are of it and it
    /// begins, or are not and it ends; else bad; for someone only watching, none.
    /// </summary>
    private static string PowerSoundOf(ImmutableHashSet<int> ours, EventDto happened, (string Good, string Bad) sounds) =>
        (ours.IsEmpty, ours.Contains(happened.Seat) != happened.IsOver) switch
        {
            (true, _) => happened.Kind,
            (_, true) => sounds.Good,
            _ => sounds.Bad,
        };

    /// <summary>
    /// The sound for something that happened to a piece, by whose it is (its <paramref name="owner"/>): of the
    /// player's own team (a cheer for an escape, a lament for a Raja taken), or an enemy's (an alarm, a
    /// fanfare); for someone only watching, the plain sound.
    /// </summary>
    private static string TeamSoundOf(
        ImmutableHashSet<int> ours,
        int? owner,
        (string Watched, string Ours, string Theirs) sounds
    ) =>
        (ours.IsEmpty, ours.Contains(owner.GetValueOrDefault())) switch
        {
            (true, _) => sounds.Watched,
            (_, true) => sounds.Ours,
            _ => sounds.Theirs,
        };

    /// <summary>
    /// How long until the next look at the game: a countdown step while the decision is timed; never once
    /// the game is over; the usual interval on the player's own turn, to see who would stop waiting.
    /// </summary>
    private TimeSpan Wait(GameViewDto view) =>
        (view.DecidingSeat, this._deadline, this._turn) switch
        {
            (null, _, _) => Timeout.InfiniteTimeSpan,
            (_, { }, _) => this.Settings.CountdownStep,
            (_, _, { }) => this.Settings.PollInterval,
            _ => this.PaceOfOthers(),
        };

    private TimeSpan PaceOfOthers() => this._isBotDeciding ? this.Settings.BotPace : this.Settings.PollInterval;
}
