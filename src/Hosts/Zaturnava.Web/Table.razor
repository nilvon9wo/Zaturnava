@* A game: over it all, the seats by team, each team with its total; under them the board (turned so
   the player's own corner is bottom left), and beside it whose turn it is, the dice and what each lets
   move, on the player's turn what they may do - prisoners they may offer back among it, and, for a Pawn
   picked up or just come to the far edge, what it may be promoted to - and what has happened. Dice the player lost, unable to use them, are told until they
   dismiss it or their turn comes round again: the turn has passed on by then. While a bot decides, it advances the game every
   TableSettings.BotPace, so that bots take their turns one at a time; while a person elsewhere
   decides, it asks for the game again every TableSettings.PollInterval. While a decision is timed, it
   counts down, and advances the game once time is up, for the server to decide for that seat. Once the
   game is over, the player may play it again, the same seats played the same way, or start a quick game.
   If the server no longer has the game (restarted, say), it says so, stops asking, and offers the lobby.
   Shown again after being hidden (when the browser may have slowed its asking), it asks at once.
   Under it all, a quiet bar: the game's name and the way back to the lobby, the buttons that turn the
   board, and the page's own settings. Beside the log, by tabs, the players' talk (TableTalk). *@
@using Microsoft.JSInterop
@implements IDisposable
@inject IGameServing Games
@inject TableSettings Settings
@inject Browser Browser
@inject TimeProvider Clock
@using System.Globalization

<section class="table">
    @if (this._problem is { } problem && this._view is null)
    {
        <p class="problem" role="alert">@problem</p>
    }

    @if (this._isGone)
    {
        <div class="gone">
            <p class="problem" role="alert">
                This game is gone: the server no longer has it, perhaps because it was restarted.
            </p>
            <button class="action primary back" @onclick="this.OnLeave">Back to the lobby</button>
        </div>
    }
    else if (this._view is { } view)
    {
        <div class="seats">
            @foreach (IGrouping<int, SeatDto> team in this.TeamsOf(view))
            {
                <section class="team @(this.IsMine(team) ? "mine" : null) @(HasWon(view, team) ? "won" : null)">
                    <header class="team-head">
                        <span class="team-name">@string.Join(" & ", team.Select(seat => seat.Name))</span>
                        <span class="team-score" title="Team score">@team.Sum(seat => seat.Score)</span>
                    </header>
                    <ol class="team-seats">
                        @foreach (SeatDto seat in team)
                        {
                            <li class="seat seat-@seat.Id @(seat.Id == view.DecidingSeat ? "deciding" : null)">
                                <span class="swatch"></span>
                                <span class="name">@seat.Name</span>
                                <span class="player">@this.Player(seat)</span>
                                @if (seat.IsRetired)
                                {
                                    <span class="retired">retired</span>
                                }
                                else if (seat.HasGivenUp)
                                {
                                    <span class="gave-up">@(IsAhead(view, seat) ? "resting on the lead" : "gave up")</span>
                                }
                                <span class="prisoners" title="Prisoners">
                                    @foreach (PrisonerDto prisoner in seat.Prisoners)
                                    {
                                        <PieceIcon Kind="@prisoner.Kind" Name="@prisoner.Name" Owner="prisoner.Owner" Pieces="this.Pieces" />
                                    }
                                </span>
                                <span class="score">@seat.Score</span>
                            </li>
                        }
                    </ol>
                </section>
            }
        </div>

        <div class="play">
            <Board View="view"
                   Actions="this.Actions"
                   Selection="this._selection"
                   Turn="this._boardTurn"
                   LastMove="this._lastMove"
                   Pieces="this.Pieces"
                   OnCellClicked="this.Click" />

            <div class="@(this._turn is null ? "turn" : "turn yours")">
                @if (this._problem is { } trouble)
                {
                    <p class="problem" role="alert">@trouble</p>
                }
                @if (this.Seating.Claim is { } absent && AwayNoticeOf(view, absent.Seat) is { } awayNotice)
                {
                    <div class="away-notice" role="alert">
                        <p>@awayNotice</p>
                        @if (view.Seats[absent.Seat].MayRejoin && view.Seats[absent.Seat].TurnsMissed > 0)
                        {
                            <button class="rejoin flashing"
                                    @onclick="() => this.Submit(absent, EndProposalDto.RejoinActionOf(absent.Seat))">
                                Rejoin game
                            </button>
                        }
                    </div>
                }
                @if (!this.IsSafetyOn)
                {
                    <p class="safety-off" role="alert">Safety OFF: you may take your own team's pieces.</p>
                }
                <p class="status">@this.Status(view)</p>
                @if (view.Away is { } away && this.Seating.Claim is { } voter && away.Voters.Contains(voter.Seat)
                     && (away.IsOpen || away.Stopping.Contains(voter.Seat)))
                {
                    bool isStopping = away.Stopping.Contains(voter.Seat);
                    <div class="away-vote">
                        <p>@Who(view.Seats[away.Seat]) is taking a long time. Keep waiting for them?</p>
                        <div class="actions">
                            <button class="action keep-waiting"
                                    aria-pressed="@(isStopping ? "false" : "true")"
                                    @onclick="() => this.Submit(voter, AwayDto.ActionOf(voter.Seat, away.Seat, false))">
                                Keep waiting
                            </button>
                            <button class="action stop-waiting"
                                    aria-pressed="@(isStopping ? "true" : "false")"
                                    @onclick="() => this.Submit(voter, AwayDto.ActionOf(voter.Seat, away.Seat, true))">
                                Stop waiting
                            </button>
                        </div>
                        <p class="hint">@away.Stopping.Count of @away.Voters.Count would stop waiting; all must, for their turn to pass.</p>
                    </div>
                }
                @if (view.Outcome is { } outcome)
                {
                    <div class="result @this.ResultOf(outcome)" role="status">
                        <h2 class="verdict">@this.VerdictOf(view, outcome)</h2>
                        <ol class="totals">
                            @foreach (IGrouping<int, SeatDto> team in this.TeamsOf(view))
                            {
                                <li class="@(HasWon(view, team) ? "won" : null)">
                                    <span class="names">@string.Join(" & ", team.Select(seat => seat.Name))</span>
                                    <span class="points">@team.Sum(seat => seat.Score)</span>
                                    @if (HasWon(view, team))
                                    {
                                        <span class="badge">won</span>
                                    }
                                </li>
                            }
                        </ol>
                    </div>
                    <div class="actions">
                        @{
                            ImmutableList<string> paid = PaidBotsOf(view);
                        }
                        @if (!paid.IsEmpty)
                        {
                            <button class="action again paid" @onclick="() => this.PlayAgain(view)">
                                Play again, with @string.Join(" and ", paid): costs tokens
                            </button>
                        }
                        else
                        {
                            <button class="action primary again" @onclick="() => this.PlayAgain(view)">Play again</button>
                        }
                        <button class="action quick" @onclick="this.QuickGame">Quick game</button>
                    </div>
                }
                @if (this._notice is { } notice)
                {
                    <p class="notice" role="status">
                        @this.Named(notice)
                        <button class="dismiss" @onclick="this.Dismiss">OK</button>
                    </p>
                }
                @if (this.Countdown() is { } countdown)
                {
                    <p class="countdown">@countdown</p>
                }
                @if (view.Offer is { } offer)
                {
                    <p class="offer">@this.Named(OfferText(view, offer))</p>
                }
                @if (view.Dice.Count > 0)
                {
                    <ul class="dice">
                        @foreach (DieDto die in view.Dice)
                        {
                            <li class="@(die.IsUsable ? null : "unusable")"
                                title="@UnusableNote(view, die)"><span class="face">@DieFaces.FaceOf(die.Value)</span> @die.Value: @this.Named(die.Meaning)</li>
                        }
                    </ul>
                }
                @if (this._turn is { } turn)
                {
                    ImmutableList<ActionDto> promotions = ByKinship(view, turn.Claim.Seat, this.AtSelection(turn));
                    @if (!promotions.IsEmpty)
                    {
                        <div class="promotion">
                            <p class="hint">@this.Named(PromotionHeading(view, this._selection.Selected!.Value))</p>
                            @foreach (ImmutableList<ActionDto> army in ArmiesOf(view, promotions))
                            {
                                <div class="promotion-choices">
                                    @foreach (ActionDto action in army)
                                    {
                                        (SeatDto holder, PrisonerDto into) = IntoOf(view, action);
                                        <button class="choice"
                                                title="@this.Named(ActionLabels.LabelOf(action))"
                                                @onclick="() => this.Submit(turn.Claim, action)">
                                            <PieceIcon Kind="@into.Kind" Name="@into.Name" Owner="into.Owner" Pieces="this.Pieces" />
                                            <span class="name">@this.Named(Owned(view, into))</span>
                                            <span class="holder">@HeldBy(holder, turn.Claim.Seat)</span>
                                        </button>
                                    }
                                </div>
                            }
                            @if (view.PromotionDue is null)
                            {
                                <button class="action later" @onclick="this.PutDown">Promote later</button>
                            }
                            else
                            {
                                @foreach (ActionDto action in turn.Actions.OffBoard)
                                {
                                    <button class="action later" @onclick="() => this.Submit(turn.Claim, action)">
                                        @this.Named(ActionLabels.LabelOf(action))
                                    </button>
                                }
                            }
                        </div>
                    }
                    else
                    {
                        <p class="hint">@Hint(turn.Actions)</p>
                        <div class="actions">
                            @foreach (ActionDto action in turn.Actions.OffBoard)
                            {
                                <button class="action primary @(IsUrged(view, action) ? "urged" : null)"
                                        @onclick="() => this.Submit(turn.Claim, action)">
                                    @this.Named(ActionLabels.LabelOf(action))
                                </button>
                            }
                        </div>
                    }
                    @if (view.MayOffer)
                    {
                        <div class="ransom">
                            <p class="hint">Offer prisoners back:</p>
                            @foreach (SeatDto receiver in Receivers(view, turn.Claim.Seat))
                            {
                                <div class="ransom-to">
                                    <span class="name">To @(receiver.Id == turn.Claim.Seat ? "yourself" : receiver.Name):</span>
                                    @foreach (PrisonerDto prisoner in HeldOf(view, turn.Claim.Seat, receiver.Id))
                                    {
                                        <button class="@ClassOf(prisoner, this._given)"
                                                title="@TitleOf(prisoner)"
                                                disabled="@(!prisoner.MayGoBack)"
                                                @onclick="() => this.Give(receiver.Id, [prisoner.Id])">
                                            <PieceIcon Kind="@prisoner.Kind" Name="@prisoner.Name" Owner="prisoner.Owner" Pieces="this.Pieces" />
                                        </button>
                                    }
                                    <button class="all"
                                            @onclick="() => this.GiveAll(view, turn.Claim.Seat, receiver.Id)">
                                        All
                                    </button>
                                </div>
                            }
                            @{ ImmutableList<PrisonerDto> askable = this.Askable(view, turn.Claim.Seat); }
                            @if (!askable.IsEmpty)
                            {
                                <p class="hint">Ask for in return (or nothing, for a gift):</p>
                                <div class="ransom-ask">
                                    @foreach (PrisonerDto prisoner in askable)
                                    {
                                        <button class="@ClassOf(prisoner, this._asked)"
                                                title="@TitleOf(prisoner)"
                                                disabled="@(!prisoner.MayGoBack)"
                                                @onclick="() => this.Ask(prisoner.Id)">
                                            <PieceIcon Kind="@prisoner.Kind" Name="@prisoner.Name" Owner="prisoner.Owner" Pieces="this.Pieces" />
                                        </button>
                                    }
                                </div>
                            }
                            @if (view.Seats[turn.Claim.Seat].Prisoners.Concat(askable).Any(prisoner => !prisoner.MayGoBack))
                            {
                                <p class="hint under-investigation">
                                    The greyed prisoners' loyalties are under investigation: they may go home once
                                    every player has had a turn.
                                </p>
                            }
                            <button class="action offer"
                                    disabled="@this._given.IsEmpty"
                                    @onclick="() => this.Offer(turn.Claim)">
                                @(this._asked.IsEmpty ? "Give them back" : "Offer the exchange")
                            </button>
                        </div>
                    }
                }
                @if (this.Seating.Claim is { } mine && view.Seats[mine.Seat].MayProposeEnd)
                {
                    <div class="end-area">
                        <button class="end-game" @onclick="this.AskToEnd">End game</button>
                    </div>
                }
                else if (this.Seating.Claim is { } back && view.Seats[back.Seat].MayRejoin
                         && view.Seats[back.Seat].TurnsMissed == 0)
                {
                    <div class="end-area">
                        <button class="rejoin" @onclick="() => this.Submit(back, EndProposalDto.RejoinActionOf(back.Seat))">
                            Rejoin game
                        </button>
                    </div>
                }
            </div>

            <TableTalk Seating="this.Seating" Seats="view.Seats">
                <LogTools>
                    <button class="log-filter" aria-pressed="@(this._isHighlightsOnly ? "true" : "false")" @onclick="this.ToggleHighlights">
                        @(this._isHighlightsOnly ? "Show everything" : "Highlights only")
                    </button>
                </LogTools>
                <ChildContent>
                    <ol class="events">
                        @{
                            int? keptSince = this._isHighlightsOnly || view.Log.IsEmpty ? null : KeptSince(view.Log);
                        }
                        @foreach (EventDto happened in this.Shown(view))
                        {
                            <li class="event @happened.Kind seat-@happened.Seat">@this.Named(happened.Text)</li>
                            @if (happened.Number == keptSince)
                            {
                                <li class="dropped">Older events are no longer kept, except for the highlights below.</li>
                            }
                        }
                    </ol>
                </ChildContent>
            </TableTalk>
        </div>
    }

    @if (this._view is { } asked && this.Seating.Claim is { } proposer && this._isProposing)
    {
        <div class="backdrop">
            <div class="dialog proposing" role="dialog" aria-modal="true" aria-labelledby="proposing-title">
                <h2 id="proposing-title">End the game?</h2>
                <p>The other players will be asked to agree. If all of them do, the game ends now, and points decide: @Totals(asked).</p>
                <p>Meanwhile, will you wait for their answers, or pass on all your remaining turns?</p>
                <div class="actions">
                    <button class="action wait" @onclick="() => this.ProposeEnd(proposer, false)">Wait for them to agree</button>
                    <button class="action resign" @onclick="() => this.ProposeEnd(proposer, true)">Pass on all my turns</button>
                    <button class="action cancel" @onclick="this.KeepPlaying">Cancel</button>
                </div>
            </div>
        </div>
    }

    @if (this._view?.Proposal is { } proposal && this._turn is { } voting)
    {
        <div class="backdrop">
            <div class="dialog voting" role="alertdialog" aria-modal="true" aria-labelledby="voting-title">
                <h2 id="voting-title">@this._view.Seats[proposal.Proposer].Name proposes ending the game</h2>
                @if (proposal.Resigns)
                {
                    <p>They have given up their remaining turns.</p>
                }
                <p>If everyone agrees, the game ends now, and points decide: @Totals(this._view).</p>
                @if (this.Countdown() is { } left)
                {
                    <p class="countdown">@left; no answer keeps the game going.</p>
                }
                <div class="actions">
                    @foreach (ActionDto action in voting.Actions.OffBoard)
                    {
                        <button class="action answer" @onclick="() => this.Submit(voting.Claim, action)">
                            @ActionLabels.LabelOf(action)
                        </button>
                    }
                </div>
            </div>
        </div>
    }

    <footer class="bar table-bar">
        <span class="where">
            <span class="brand">@(this._view?.RulesetName ?? "Zaturnava")</span>
            @this.HowToPlay
            <button class="leave" @onclick="this.OnLeave">Lobby</button>
        </span>
        @if (this._view is { } shown)
        {
            <span class="turns">
                <button class="turn-left" title="Turn the board anticlockwise" @onclick="this.TurnLeft">&#x27F2;</button>
                <button class="turn-home" title="Your own view of the board" @onclick="() => this.TurnHome(shown)">
                    My view
                </button>
                <button class="turn-right" title="Turn the board clockwise" @onclick="this.TurnRight">&#x27F3;</button>
            </span>
        }
        @this.PageSettings
    </footer>
</section>

@code {
    private const string BotController = "bot";
    private const string OpenController = "open";
    private const string RollKind = "roll";
    private const string MoveKind = "move";
    private const string EscapeKind = "escape";
    private const string Alarm = "alarm";
    private const string Rescued = "rescued";
    private const string Triumph = "triumph";
    private const string Lament = "lament";
    private const string Lost = "lost";
    private const string Victory = "victory";
    private const string Defeat = "defeat";
    private const string Restored = "restored";
    private const string Dread = "dread";
    private const string Rally = "rally";
    private const string Menace = "menace";
    private const string Glory = "glory";
    private const string Doom = "doom";

    private static readonly BoardActions NoActions = new([]);

    private readonly Timer _poll;
    private readonly DotNetObjectReference<Table> _self;
    private GameViewDto? _view;
    private Turn? _turn;
    private BoardSelection _selection = BoardSelection.None;
    private BoardTurn _boardTurn = BoardTurn.None;
    private ImmutableHashSet<int> _lastMove = [];
    private bool _isHighlightsOnly = true;
    private bool _isProposing;
    private DateTimeOffset? _deadline;
    private int? _receiver;
    private ImmutableHashSet<int> _given = [];
    private ImmutableHashSet<int> _asked = [];
    private ImmutableHashSet<string> _offersMade = [];
    private int _offersTurn;
    private int _heard = -1;
    private string? _problem;
    private string? _notice;
    private bool _isBotDeciding;
    private bool _isGone;

    public Table()
    {
        this._poll = new Timer(this.Tick);
        this._self = DotNetObjectReference.Create(this);
    }

    /// <summary>The log, newest first: all of it, or only its highlights.</summary>
    private IEnumerable<EventDto> Shown(GameViewDto view) =>
        view.Log.Reverse().Where(happened => !this._isHighlightsOnly || EventDto.Highlights.Contains(happened.Kind));

    /// <summary>
    /// The oldest event of the unbroken run the log ends with, if events before it were let go (only
    /// highlights are kept that long); else null.
    /// </summary>
    private static int? KeptSince(ImmutableList<EventDto> log)
    {
        int offset = log[^1].Number - (log.Count - 1);
        return offset > 0 ? log.Where((happened, index) => happened.Number - index == offset).First().Number : null;
    }

    private async Task ToggleHighlights()
    {
        this._isHighlightsOnly = !this._isHighlightsOnly;
        await this.Browser.SetLogHighlightsOnly(this._isHighlightsOnly);
    }

    [Parameter, EditorRequired]
    public Seating Seating { get; set; } = null!;

    [Parameter]
    public bool IsSoundOn { get; set; } = true;

    /// <summary>Whether the player is kept from taking their own team's pieces, as an enemy army they command may.</summary>
    [Parameter]
    public bool IsSafetyOn { get; set; } = true;

    /// <summary>How the pieces are drawn and named, the server's names being the chaturaji ones.</summary>
    [Parameter]
    public PieceSet Pieces { get; set; }

    /// <summary>The page's own settings, for the table's bar.</summary>
    [Parameter]
    public RenderFragment? PageSettings { get; set; }

    /// <summary>The button opening the guide to the game, beside the game's name.</summary>
    [Parameter]
    public RenderFragment? HowToPlay { get; set; }

    [Parameter]
    public EventCallback OnLeave { get; set; }

    /// <summary>The player sat at (or watching) another game, started from this one once it is over.</summary>
    [Parameter]
    public EventCallback<Seating> OnSeated { get; set; }

    private BoardActions Actions => this._turn?.Actions ?? NoActions;

    /// <summary>The safety switched while the player decides changes what they may do at once.</summary>
    protected override void OnParametersSet() =>
        this._turn = this._turn is { } turn ? this.TurnOf(turn.Claim, this._view!) : null; // a turn is had in a view

    /// <summary>
    /// The player's turn: what they may do, but, while the safety is on, take a piece of their own team.
    /// </summary>
    private Turn TurnOf(SeatClaim claim, GameViewDto view) =>
        new(
            claim,
            new BoardActions(
                this.IsSafetyOn
                    ? [.. view.LegalActions.Where(action => !TakesOwnTeam(view, claim.Seat, action))]
                    : view.LegalActions
            )
        );

    private static bool TakesOwnTeam(GameViewDto view, int seat, ActionDto action) =>
        action.Kind == MoveKind
        && view.Pieces.FirstOrDefault(piece =>
            piece.Cell == int.Parse(action.Arguments[ActionArguments.To], CultureInfo.InvariantCulture)
        ) is { } taken
        && view.Seats[taken.Owner].Team == view.Seats[seat].Team;

    protected override async Task OnInitializedAsync()
    {
        this._isHighlightsOnly = await this.Browser.IsLogHighlightsOnly();
        await this.Browser.Watch(this._self);
        await this.Refresh();
        this._boardTurn = this._view is null ? BoardTurn.None : BoardTurn.HomeOf(this.Seating.Claim?.Seat, this._view);
    }

    public void Dispose()
    {
        this._poll.Dispose();
        this._self.Dispose();
    }

    /// <summary>
    /// The page shown again: a look at the game at once, unless it is over, since a hidden page's timers may
    /// have waited a minute or more between looks.
    /// </summary>
    [JSInvokable]
    public void Shown() =>
        _ = this._view is { DecidingSeat: not null } && this._poll.Change(TimeSpan.Zero, Timeout.InfiniteTimeSpan);

    /// <summary>
    /// Why a die is greyed out, none for one that is not: nothing it lets move can move; and, while doubles let a
    /// captured piece escape, that the two dice together still may do that.
    /// </summary>
    private static string? UnusableNote(GameViewDto view, DieDto die) =>
        (die.IsUsable, view.LegalActions.Any(action => action.Kind == EscapeKind)) switch
        {
            (true, _) => null,
            (_, true) => "Nothing it lets move can move now, but the doubles let a captured piece escape",
            _ => "Nothing it lets move can move now",
        };

    private static string Hint(BoardActions actions) =>
        actions.Origins.IsEmpty
            ? "Choose what to do:"
            : actions.OffBoard.IsEmpty
                ? "Pick a ringed piece, then a marked square."
                : "Move a ringed piece (pick it, then a marked square), or:";

    /// <summary>
    /// How the game ended; else who is answering an offer, or whose turn is over but who may still offer;
    /// else whose move it is, and for whom if not for themselves.
    /// </summary>
    private string Status(GameViewDto view) =>
        (view.Outcome, view.DecidingSeat, this._turn, view.Offer, view.IsTurnOver) switch
        {
            ({ } outcome, _, _, _, _) => outcome.Text,
            _ when OpenSeatsOf(view) is { } open =>
                $"Waiting for {open} to join: the game begins once every seat is taken.",
            (_, { } seat, null, _, _) when view.Proposal is { } proposal =>
                $"{view.Seats[proposal.Proposer].Name} proposes ending the game: waiting for {Who(view.Seats[seat])}.",
            (_, { }, _, _, _) when view.Proposal is { } proposal =>
                $"{view.Seats[proposal.Proposer].Name} proposes ending the game: do you agree?",
            (_, { } seat, null, _, _) when view.Returning is { } piece =>
                $"{Who(view.Seats[seat])} is choosing where their {piece.Name} goes home.",
            (_, { }, _, _, _) when view.Returning is { } piece =>
                $"Your {piece.Name} is going home: choose a marked square for it.",
            (_, { } seat, null, { } offer, _) =>
                $"{Who(view.Seats[seat])} is answering {view.Seats[offer.From].Name}'s offer.",
            (_, { }, _, { } offer, _) => $"Answer {view.Seats[offer.From].Name}'s offer.",
            (_, { } seat, null, _, true) => $"{view.Seats[seat].Name}'s turn is over: they may still offer prisoners back.",
            (_, { }, _, _, true) => "Your turn is over: offer prisoners back, or be done.",
            (_, { } seat, null, _, _) => $"{Who(view.Seats[seat])} to move{ForWhom(view)}.",
            (_, { }, _, _, _) when view.ThroneHeldBy is { } holder => this.Held(view, holder),
            (_, { }, _, _, _) => $"Your move{ForWhom(view)}.",
            _ => "The game is over.",
        };

    /// <summary>
    /// "Yellow's Raja holds your throne, so you cannot move before rolling: you must roll, then move first;
    /// Yellow moves second." - or, once rolled, "...: you move first; Yellow moves second." Playing an ally's
    /// turn, the throne is the ally's: "Yellow's Raja holds Green's throne...".
    /// </summary>
    private string Held(GameViewDto view, int holder)
    {
        int owner = view.ActingFor ?? view.DecidingSeat!.Value; // held only while someone decides
        int throne = view.Cells.First(cell => cell.Throne == owner).Id;
        string leader = view.Pieces.First(piece => piece.Cell == throne).Name;
        string holders = view.Seats[holder].Name;
        string whose = view.ActingFor is { } ally ? $"{view.Seats[ally].Name}'s" : "your";
        string roll = view.LegalActions.Any(action => action.Kind == RollKind)
            ? ", so you cannot move before rolling: you must roll, then move first"
            : ": you move first";
        return this.Named($"{holders}'s {leader} holds {whose} throne{roll}; {holders} moves second.");
    }

    /// <summary>Rolling, when the player may do nothing else for an enemy leader on their throne.</summary>
    private static bool IsUrged(GameViewDto view, ActionDto action) =>
        view.ThroneHeldBy is not null && action.Kind == RollKind;

    /// <summary>Who plays another seat, then the seat: "Argus (Yellow)", or "Black (human)".</summary>
    /// <summary>
    /// What a player away should know when they look again: that the others are playing on without them,
    /// that they are waited for again, having said they are back, or who would stop waiting; null if none of
    /// it is so.
    /// </summary>
    private static string? AwayNoticeOf(GameViewDto view, int seat)
    {
        SeatDto mine = view.Seats[seat];
        ImmutableList<int> stopping = view.Away is { } away && away.Seat == seat ? away.Stopping : [];
        string turns = mine.TurnsMissed == 1 ? "turn" : "turns";
        return (mine.TurnsMissed, mine.MayRejoin || mine.HasGivenUp, stopping.IsEmpty) switch
        {
            (> 0, true, _) =>
                $"The others are playing on without you: you missed {mine.TurnsMissed} {turns} in a row.",
            (> 0, _, _) => "You are back: the others will wait for you again, unless you miss another turn.",
            (_, _, false) =>
                $"{string.Join(" and ", stopping.Select(voter => view.Seats[voter].Name))} would stop waiting for you.",
            _ => null,
        };
    }

    private static string Who(SeatDto seat) =>
        seat.Bot is { } bot ? $"{bot} ({seat.Name})" : $"{seat.Name} ({seat.Player ?? seat.Controller})";

    /// <summary>"Yellow and Red": the seats no one has taken yet, for which the game waits; null if none.</summary>
    private static string? OpenSeatsOf(GameViewDto view) =>
        Listed([.. view.Seats.Where(seat => seat.Controller == OpenController).Select(seat => seat.Name)]);

    private static string? Listed(ImmutableList<string> names) => names.IsEmpty ? null : string.Join(" and ", names);

    private static string ForWhom(GameViewDto view) =>
        view.ActingFor is { } seat ? $", for {view.Seats[seat].Name}" : string.Empty;

    /// <summary>"Black offers Yellow Yellow's Pawn back, for Green's Horse.", or "..., as a gift."</summary>
    private static string OfferText(GameViewDto view, OfferDto offer)
    {
        string asking = offer.Asked.IsEmpty ? "as a gift" : $"for {Listed(view, offer.Asked)}";
        string given = Listed(view, offer.Given);
        return $"{view.Seats[offer.From].Name} offers {view.Seats[offer.To].Name} {given} back, {asking}.";
    }

    private static string Listed(GameViewDto view, ImmutableList<PrisonerDto> prisoners) =>
        string.Join(", ", prisoners.Select(prisoner => Owned(view, prisoner)));

    /// <summary>"Green's Elephant".</summary>
    private static string Owned(GameViewDto view, PrisonerDto prisoner) =>
        $"{view.Seats[prisoner.Owner].Name}'s {prisoner.Name}";

    /// <summary>What may be done at the piece picked up, as a promotion is; nothing if none is picked up.</summary>
    private ImmutableList<ActionDto> AtSelection(Turn turn) =>
        this._selection.Selected is { } cell ? turn.Actions.At(cell) : [];

    /// <summary>
    /// The promotions, into the player's own pieces first, then their allies', then the rest, army by army
    /// (so that each may be shown apart); within an army, as the ruleset orders them, the most valuable first.
    /// </summary>
    private static ImmutableList<ActionDto> ByKinship(GameViewDto view, int seat, ImmutableList<ActionDto> promotions) =>
        [
            .. promotions
                .OrderBy(promotion => KinshipOf(view, seat, IntoOf(view, promotion).Prisoner.Owner))
                .ThenBy(promotion => IntoOf(view, promotion).Prisoner.Owner),
        ];

    /// <summary>The promotions, army by army, in order: those into one army's pieces, apart.</summary>
    private static ImmutableList<ImmutableList<ActionDto>> ArmiesOf(GameViewDto view, ImmutableList<ActionDto> promotions) =>
        [.. promotions.GroupBy(promotion => IntoOf(view, promotion).Prisoner.Owner).Select(army => army.ToImmutableList())];

    /// <summary>0 for the player's own seat, 1 for an ally's, 2 for anyone else's.</summary>
    private static int KinshipOf(GameViewDto view, int seat, int owner) =>
        (owner == seat, view.Seats[owner].Team == view.Seats[seat].Team) switch
        {
            (true, _) => 0,
            (_, true) => 1,
            _ => 2,
        };

    /// <summary>"Promote Black's Pawn on c8 to:".</summary>
    private static string PromotionHeading(GameViewDto view, int cell)
    {
        PieceDto pawn = view.Pieces.First(piece => piece.Cell == cell);
        string name = view.Cells.First(at => at.Id == cell).Name;
        return $"Promote {view.Seats[pawn.Owner].Name}'s {pawn.Name} on {name} to:";
    }

    /// <summary>The captured piece a promotion brings back, and the seat holding it.</summary>
    private static (SeatDto Holder, PrisonerDto Prisoner) IntoOf(GameViewDto view, ActionDto promotion) =>
        view.Seats
            .SelectMany(seat => seat.Prisoners.Select(prisoner => (seat, prisoner)))
            .First(held =>
                held.prisoner.Id.ToString(CultureInfo.InvariantCulture) == promotion.Arguments[ActionArguments.Into]
            );

    /// <summary>"held by Red", or "held by you" if the player's own <paramref name="seat"/> holds it.</summary>
    private static string HeldBy(SeatDto holder, int seat) =>
        $"held by {(holder.Id == seat ? "you" : holder.Name)}";

    private void PutDown() => this._selection = BoardSelection.None;

    /// <summary>The bots in the game paid for each use, by name: playing again would cost tokens again.</summary>
    private static ImmutableList<string> PaidBotsOf(GameViewDto view) =>
        [.. view.Seats.Where(seat => seat.IsPaidBot).Select(seat => seat.Bot).OfType<string>()];

    /// <summary>The same game again: its ruleset, its bots in the same seats, the player at the same seat.</summary>
    private Task PlayAgain(GameViewDto view) =>
        this.SitAgain(async () => await GameStarter.Start(
            this.Games,
            view.RulesetId,
            [.. view.Seats.Select(seat => seat.BotId)],
            this.Seating.Claim is { } claim ? claim.Seat : -1,
            null,
            await this.Browser.Claimant(),
            view.Id
        ));

    private Task QuickGame() =>
        this.SitAgain(async () =>
            await GameStarter.Quick(
                this.Games,
                await this.Games.Catalog(CancellationToken.None),
                Difficulty.Medium,
                await this.Browser.Claimant()
            )
        );

    private async Task SitAgain(Func<Task<Seating>> seating) =>
        this._problem = await Requests.Attempt(async () => await this.OnSeated.InvokeAsync(await seating()));

    private string Named(string text) => PieceStyle.Named(text, this.Pieces);

    private void Dismiss() => this._notice = null;

    /// <summary>
    /// What to tell the player: that they have just lost dice they could not use, or, as the decision comes
    /// back to them, that their offer was declined; nothing on first sight of the game, or once their turn
    /// comes round again; else what they were told already.
    /// </summary>
    private string? NoticeOf(GameViewDto view, bool isFirst, bool wasTheirTurn)
    {
        EventDto? lost = view.Log.LastOrDefault(happened =>
            happened.Number > this._heard
            && happened.Kind == EventDto.Forfeited
            && happened.Seat == this.Seating.Claim?.Seat
        );
        EventDto? declined = view.Log.LastOrDefault(happened =>
            happened.Number > this._heard && happened.Kind == EventDto.Declined
        );
        bool isBack = this._turn is not null && !wasTheirTurn;
        return (isFirst, lost, declined, isBack) switch
        {
            (true, _, _, _) => null,
            (_, { } forfeited, _, _) => forfeited.Text,
            (_, _, { } refusal, true) => refusal.Text,
            (_, _, _, true) => null,
            _ => this._notice,
        };
    }

    /// <summary>Whether the seat's team leads on points.</summary>
    private static bool IsAhead(GameViewDto view, SeatDto seat) =>
        view.Seats.Sum(other => other.Team == seat.Team ? other.Score : -other.Score) > 0;

    /// <summary>The seats the player holds prisoners of, to give them back to: themselves too.</summary>
    private static IEnumerable<SeatDto> Receivers(GameViewDto view, int seat) =>
        view.Seats[seat].Prisoners.Select(prisoner => prisoner.Owner).Distinct().Order().Select(owner => view.Seats[owner]);

    private static IEnumerable<PrisonerDto> HeldOf(GameViewDto view, int seat, int owner) =>
        view.Seats[seat].Prisoners.Where(prisoner => prisoner.Owner == owner);

    /// <summary>
    /// The prisoners the chosen receiver holds of the player's team: what the player may ask for; none until a
    /// receiver is chosen, nor of the player themselves.
    /// </summary>
    private ImmutableList<PrisonerDto> Askable(GameViewDto view, int seat) =>
        this._receiver is { } receiver && receiver != seat
            ? [.. view.Seats[receiver].Prisoners.Where(prisoner => view.Seats[prisoner.Owner].Team == view.Seats[seat].Team)]
            : [];

    /// <summary>A prisoner to choose, chosen, or greyed out while it may not go back yet.</summary>
    private static string ClassOf(PrisonerDto prisoner, ImmutableHashSet<int> chosen) =>
        (prisoner.MayGoBack, chosen.Contains(prisoner.Id)) switch
        {
            (false, _) => "prisoner waiting",
            (_, true) => "prisoner chosen",
            _ => "prisoner",
        };

    private static string TitleOf(PrisonerDto prisoner) =>
        prisoner.MayGoBack ? prisoner.Name : $"{prisoner.Name}: loyalty under investigation";

    /// <summary>Chooses prisoners to give back, or no longer; choosing another seat's starts afresh.</summary>
    private void Give(int receiver, ImmutableHashSet<int> prisoners)
    {
        bool isSameReceiver = this._receiver == receiver;
        this._asked = isSameReceiver ? this._asked : [];
        this._given = isSameReceiver ? this._given.SymmetricExcept(prisoners) : prisoners;
        this._receiver = receiver;
    }

    private void GiveAll(GameViewDto view, int seat, int receiver)
    {
        ImmutableHashSet<int> all =
            [.. HeldOf(view, seat, receiver).Where(prisoner => prisoner.MayGoBack).Select(prisoner => prisoner.Id)];
        this.Give(receiver, this._receiver == receiver ? all.Except(this._given) : all);
    }

    private void Ask(int prisoner) => this._asked = this._asked.SymmetricExcept([prisoner]);

    private void AskToEnd() => this._isProposing = true;

    private void KeepPlaying() => this._isProposing = false;

    private Task ProposeEnd(SeatClaim claim, bool resigns)
    {
        this._isProposing = false;
        return this.Submit(claim, EndProposalDto.ActionOf(claim.Seat, resigns));
    }

    /// <summary>Each team's points, the player's own first: "Black &amp; Green 39, Yellow &amp; Red 20".</summary>
    private string Totals(GameViewDto view) =>
        string.Join(
            ", ",
            this.TeamsOf(view).Select(team => $"{string.Join(" & ", team.Select(seat => seat.Name))} {team.Sum(seat => seat.Score)}")
        );

    /// <summary>
    /// Makes the offer chosen, unless it was made already this turn: the rules allow an offer only once a turn,
    /// so the player is told instead.
    /// </summary>
    private Task Offer(SeatClaim claim)
    {
        int receiver = this._receiver!.Value;
        ActionDto offer = OfferDto.ActionOf(claim.Seat, receiver, this._given.Order(), this._asked.Order());
        string made = string.Join('|', offer.Arguments.Values);
        return this._offersMade.Contains(made)
            ? this.Refused($"{this._view!.Seats[receiver].Name} declined that offer already!")
            : this.Made(claim, offer, made);
    }

    private Task Refused(string problem)
    {
        this._problem = problem;
        return Task.CompletedTask;
    }

    private async Task Made(SeatClaim claim, ActionDto offer, string made)
    {
        await this.Submit(claim, offer);
        this._offersMade = this._problem is null ? this._offersMade.Add(made) : this._offersMade;
    }

    /// <summary>"12 s left", while the deciding seat's decision is timed.</summary>
    private string? Countdown() =>
        this._deadline is { } deadline
            ? $"{Math.Max(0, (int)Math.Ceiling((deadline - this.Clock.GetUtcNow()).TotalSeconds))} s left"
            : null;

    /// <summary>The seats by team, the player's own team first, each team's seats in the order they sit.</summary>
    private IEnumerable<IGrouping<int, SeatDto>> TeamsOf(GameViewDto view) =>
        view.Seats.GroupBy(seat => seat.Team).OrderByDescending(this.IsMine).ThenBy(team => team.Key);

    private bool IsMine(IGrouping<int, SeatDto> team) => team.Any(seat => seat.Id == this.Seating.Claim?.Seat);

    /// <summary>Who plays the seat: you, the bot, the player by name (or a guest), or no one yet ("open").</summary>
    private string Player(SeatDto seat) =>
        seat.Id == this.Seating.Claim?.Seat ? "you" : seat.Bot ?? seat.Player ?? seat.Controller;

    private void TurnLeft() => this._boardTurn = this._boardTurn.Anticlockwise();

    private void TurnRight() => this._boardTurn = this._boardTurn.Clockwise();

    private void TurnHome(GameViewDto view) => this._boardTurn = BoardTurn.HomeOf(this.Seating.Claim?.Seat, view);

    private void Tick(object? state) => _ = this.InvokeAsync(this.Next);

    /// <summary>
    /// Lets a deciding bot take its next step, or the server decide once time is up; else, on the player's own
    /// timed turn, counts down; else looks for what others have done (on the player's own turn, whether
    /// they would stop waiting for them).
    /// </summary>
    private async Task Next()
    {
        GameViewDto view = this._view!;
        bool isDue = this._isBotDeciding || this._deadline <= this.Clock.GetUtcNow();
        await ((isDue, this._turn, this._deadline) switch
        {
            (true, _, _) => this.Request(
                () => this.Games.Advance(this.Seating.GameId, view.Version, CancellationToken.None)
            ),
            (_, { }, { }) => this.CountDown(view),
            _ => this.Refresh(),
        });
        this.StateHasChanged();
    }

    private Task CountDown(GameViewDto view)
    {
        _ = this._poll.Change(this.Wait(view), Timeout.InfiniteTimeSpan);
        return Task.CompletedTask;
    }

    private Task Refresh() => this.Request(() => this.Games.Get(this.Seating.GameId, CancellationToken.None));

    private Task Click(int cell)
    {
        (BoardSelection next, ActionDto? chosen) = this._selection.Click(cell, this.Actions);
        this._selection = next;
        return this._turn is { } turn && chosen is { } action ? this.Submit(turn.Claim, action) : Task.CompletedTask;
    }

    private Task Submit(SeatClaim claim, ActionDto action) =>
        this.Request(() => this.Games.Submit(this.Seating.GameId, claim.Token, action, CancellationToken.None));

    /// <summary>
    /// Makes the request, and shows the game it answers with; if it fails, says why, and looks again
    /// when it would have anyway, so that a game waiting on others does not stop when one request does.
    /// </summary>
    private async Task Request(Func<Task<GameViewDto>> request)
    {
        this._problem = await Requests.Attempt(async () => await this.ShowUnlessGone(request));
        _ = this._problem is not null && this._view is { } view
            && this._poll.Change(this.Wait(view), Timeout.InfiniteTimeSpan);
    }

    private async Task ShowUnlessGone(Func<Task<GameViewDto>> request)
    {
        try
        {
            await this.Show(await request());
        }
        catch (GameRequestRefusedException refused) when (refused.Refusal == Refusal.NotFound)
        {
            this._isGone = true;
            _ = this._poll.Change(Timeout.InfiniteTimeSpan, Timeout.InfiniteTimeSpan);
        }
    }

    private async Task Show(GameViewDto view)
    {
        bool wasTheirTurn = this._turn is not null;
        bool isFirst = this._view is null;
        bool isNew = view.Version != this._view?.Version;
        this._view = view;
        this._deadline = view.SecondsLeft is { } seconds ? this.Clock.GetUtcNow().AddSeconds(seconds) : null;
        this._receiver = isNew ? null : this._receiver;
        this._given = isNew ? [] : this._given;
        this._asked = isNew ? [] : this._asked;
        this._offersMade = view.TurnNumber == this._offersTurn ? this._offersMade : [];
        this._offersTurn = view.TurnNumber;
        this._turn = view.DecidingSeat is { } deciding && this.Seating.Claim is { } claim && claim.Seat == deciding
            ? this.TurnOf(claim, view)
            : null;
        // a bot plays only once every seat is taken
        this._isBotDeciding = view.DecidingSeat is { } seat
            && view.Seats[seat].Controller == BotController
            && OpenSeatsOf(view) is null;
        this._selection = (isNew, this._turn, view.PromotionDue) switch
        {
            (false, { }, _) => this._selection,
            (_, { }, { } due) => new BoardSelection(due),
            _ => BoardSelection.None,
        };
        this._lastMove = view.Log.LastOrDefault(happened => happened.Kind == EventDto.Moved) is { } moved
            ? [moved.From!.Value, moved.To!.Value]
            : [];
        ImmutableList<string> sounds = this.SoundsOf(view, isFirst, wasTheirTurn);
        this._notice = this.NoticeOf(view, isFirst, wasTheirTurn);
        this._heard = view.Log.Count > 0 ? view.Log[^1].Number : this._heard;
        await (!sounds.IsEmpty && this.IsSoundOn ? this.Browser.Play(sounds) : ValueTask.CompletedTask);
        _ = this._poll.Change(this.Wait(view), Timeout.InfiniteTimeSpan);
    }

    /// <summary>
    /// The sounds for what happened since the last view, one after another: what befell a piece (a Raja of the
    /// player's team taken, an enemy Raja back on the board, an enemy's piece escaping, an enemy Raja taken, a
    /// Raja of the player's team back, or a piece of it escaping), then how power shifted (an empire, or
    /// command of an army, begun or ended, for the player's team or against it); else a turn come round, a
    /// capture, a move, a roll.
    /// </summary>
    private ImmutableList<string> SoundsOf(GameViewDto view, bool isFirst, bool wasTheirTurn)
    {
        ImmutableList<EventDto> fresh = [.. view.Log.Where(happened => happened.Number > this._heard)];
        ImmutableHashSet<int> ours = [.. this.TeamsOf(view).Where(this.IsMine).SelectMany(team => team).Select(seat => seat.Id)];
        ImmutableHashSet<string> kinds =
        [
            .. fresh.Select(happened => happened.Kind),
            .. fresh.Where(happened => happened is { Kind: EventDto.Escaped, IsLeader: false })
                .Select(escaped => TeamSoundOf(ours, escaped.Owner, (EventDto.Moved, Rescued, Alarm))),
            .. fresh.Where(happened => happened is { Kind: EventDto.Escaped or EventDto.Ransom, IsLeader: true })
                .Select(back => TeamSoundOf(ours, back.Owner, (EventDto.Moved, Restored, Dread))),
            .. fresh.Where(happened => happened is { Kind: EventDto.Captured, IsLeader: true })
                .Select(taken => TeamSoundOf(ours, taken.Owner, (EventDto.Captured, Lament, Triumph))),
            .. fresh.Where(happened => happened is { Kind: EventDto.Captured, IsLeader: false })
                .Select(taken => TeamSoundOf(ours, taken.Owner, (EventDto.Captured, Lost, EventDto.Captured))),
            .. fresh.Where(happened => happened.Kind == EventDto.Ended)
                .Select(_ => this.ResultOf(view.Outcome!)),
            .. fresh.Where(happened => happened.Kind == EventDto.Command)
                .Select(command => PowerSoundOf(ours, command, (Rally, Menace))),
            .. fresh.Where(happened => happened.Kind == EventDto.Empire)
                .Select(empire => PowerSoundOf(ours, empire, (Glory, Doom))),
        ];
        ImmutableList<string> telling =
        [
            .. new[] { Lament, Dread, Alarm, Triumph, Restored, Rescued, Lost }.Where(kinds.Contains).Take(1),
            .. new[] { Doom, Menace, Glory, Rally }.Where(kinds.Contains).Take(1),
            .. new[] { Victory, Defeat }.Where(kinds.Contains).Take(1),
        ];
        return (isFirst, telling.IsEmpty, this._turn is not null && !wasTheirTurn) switch
        {
            (true, _, _) => [],
            (_, false, _) => telling,
            (_, _, true) => ["turn"],
            _ => [.. new[] { EventDto.Captured, EventDto.Moved, EventDto.Rolled }.Where(kinds.Contains).Take(1)],
        };
    }

    /// <summary>
    /// How the game ended for whoever looks: <c>victory</c> or <c>defeat</c> for a player, <c>draw</c> for
    /// anyone, <c>watched</c> for someone only watching a game someone won.
    /// </summary>
    private string ResultOf(OutcomeDto outcome) =>
        (this.Seating.Claim, outcome.Winners.IsEmpty) switch
        {
            (_, true) => "draw",
            (null, _) => "watched",
            ({ } claim, _) when outcome.Winners.Contains(claim.Seat) => Victory,
            _ => Defeat,
        };

    /// <summary>"Victory!", "Defeat" or "A draw"; for someone only watching, "Black & Green won".</summary>
    private string VerdictOf(GameViewDto view, OutcomeDto outcome) =>
        this.ResultOf(outcome) switch
        {
            Victory => "Victory!",
            Defeat => "Defeat",
            "draw" => "A draw",
            _ => $"{string.Join(" & ", outcome.Winners.Select(seat => view.Seats[seat].Name))} won",
        };

    /// <summary>Whether the team won the game, now over.</summary>
    private static bool HasWon(GameViewDto view, IGrouping<int, SeatDto> team) =>
        view.Outcome is { } outcome && team.Any(seat => outcome.Winners.Contains(seat.Id));

    /// <summary>
    /// The sound for a shift of power: good for the player's team, if the commander or rulers are of it and it
    /// begins, or are not and it ends; else bad; for someone only watching, none.
    /// </summary>
    private static string PowerSoundOf(ImmutableHashSet<int> ours, EventDto happened, (string Good, string Bad) sounds) =>
        (ours.IsEmpty, ours.Contains(happened.Seat) != happened.IsOver) switch
        {
            (true, _) => happened.Kind,
            (_, true) => sounds.Good,
            _ => sounds.Bad,
        };

    /// <summary>
    /// The sound for something that happened to a piece, by whose it is (its <paramref name="owner"/>): of the
    /// player's own team (a cheer for an escape, a lament for a Raja taken), or an enemy's (an alarm, a
    /// fanfare); for someone only watching, the plain sound.
    /// </summary>
    private static string TeamSoundOf(
        ImmutableHashSet<int> ours,
        int? owner,
        (string Watched, string Ours, string Theirs) sounds
    ) =>
        (ours.IsEmpty, ours.Contains(owner.GetValueOrDefault())) switch
        {
            (true, _) => sounds.Watched,
            (_, true) => sounds.Ours,
            _ => sounds.Theirs,
        };

    /// <summary>
    /// How long until the next look at the game: a countdown step while the decision is timed; never once
    /// the game is over; the usual interval on the player's own turn, to see who would stop waiting.
    /// </summary>
    private TimeSpan Wait(GameViewDto view) =>
        (view.DecidingSeat, this._deadline, this._turn) switch
        {
            (null, _, _) => Timeout.InfiniteTimeSpan,
            (_, { }, _) => this.Settings.CountdownStep,
            (_, _, { }) => this.Settings.PollInterval,
            _ => this.PaceOfOthers(),
        };

    private TimeSpan PaceOfOthers() => this._isBotDeciding ? this.Settings.BotPace : this.Settings.PollInterval;
}
