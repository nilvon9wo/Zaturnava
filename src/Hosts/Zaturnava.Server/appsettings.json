{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "Provider": "InMemory"
  },
  "ConnectionStrings": {
    "Games": ""
  },
  "Games": {
    "MaximumBotSteps": 0,
    "AwayGraceSeconds": 120,
    "FillWaitSeconds": 60,
    "SafetyNets": {
      "IdleRounds": 3,
      "QuietRounds": 50,
      "RepeatRounds": 3
    },
    "Timers": {
      "end-answer": 60
    }
  },
  "PageHosting": {
    "Provider": "Itch"
  },
  "BotRating": {
    "IsOn": true,
    "PauseSeconds": 10
  }
}
