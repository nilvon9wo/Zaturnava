<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The HTTP host and composition root: the only project that knows every adapter. It chooses the
    storage and the page host from configuration, plugs the rulesets and bots into the
    application, and speaks the Zaturnava.Contracts protocol. Each service around the game is an
    adapter project referenced only here. Replacing the host (another framework, a serverless
    function) means replacing this project alone.
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <!-- SqlClient's own dependency (9.0.11) has known vulnerabilities (NU1902, NU1903) -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Net.NowhereAtAll.Zaturnava.Server.Test" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Application\Zaturnava.Application\Zaturnava.Application.csproj" />
    <ProjectReference Include="..\..\Bots\Zaturnava.Bots\Zaturnava.Bots.csproj" />
    <ProjectReference Include="..\..\Apis\Zaturnava.Contracts\Zaturnava.Contracts.csproj" />
    <ProjectReference Include="..\Zaturnava.Hosting\Zaturnava.Hosting.csproj" />
    <ProjectReference Include="..\Zaturnava.Hosting.Itch\Zaturnava.Hosting.Itch.csproj" />
    <ProjectReference Include="..\..\Persistence\Zaturnava.Persistence.EfCore\Zaturnava.Persistence.EfCore.csproj" />
    <ProjectReference Include="..\..\Persistence\Zaturnava.Persistence.InMemory\Zaturnava.Persistence.InMemory.csproj" />
    <ProjectReference Include="..\..\Games\Chaturaji2027\Zaturnava.Games.Chaturaji2027\Zaturnava.Games.Chaturaji2027.csproj" />
  </ItemGroup>

</Project>
