<Project Sdk="Microsoft.NET.Sdk">

  <!--
    An MCP server, over stdio, through which an AI (Claude Desktop, Claude Code, any MCP client)
    plays: it lists, creates, joins and watches games and takes actions, through the same
    IGameServing as every other client. The game server it calls is ZATURNAVA_SERVER_URL.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Net.NowhereAtAll.Zaturnava.Mcp.Test" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zaturnava.Client\Zaturnava.Client.csproj" />
  </ItemGroup>

</Project>
