<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Players that need no person: each one is just an IDeciding, so the engine, the server and any
    client treat it exactly as they treat a human.
  -->

  <ItemGroup>
    <!-- What Sage has learned for each ruleset (SageWeights.Learned), tuned by BotRunner's training. -->
    <EmbeddedResource Include="Weights\*.json" LogicalName="Weights/%(Filename)%(Extension)" />
    <!-- How strongly each bot plays each ruleset (BotRatings.Rated), as scripts/rate-bots.py fits it. -->
    <EmbeddedResource Include="Ratings\*.json" LogicalName="Ratings/%(Filename)%(Extension)" />
    <!-- The networks Athena judges positions by (ValueNetworks.Learned), as BotRunner's learning trains them. -->
    <EmbeddedResource Include="Networks\*.json" LogicalName="Networks/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Engine\Zaturnava.Engine\Zaturnava.Engine.csproj" />
  </ItemGroup>

</Project>
